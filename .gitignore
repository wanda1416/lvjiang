# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environment
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Tool caches (mypy baseline worktree etc.)
.git-mypy-base/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.testmondata*
.pytest-*/
pytest-of-*/
# 手工指定的 pytest basetemp（--basetemp=.tmp-run），测试报告与锁文件都落这里
.tmp-run/
# .coverage* 而非 .coverage：pytest-xdist 并行跑覆盖率会产生
# .coverage.<host>.<pid>.<rand> 分片，中断的运行会把它们留在工作区。
.coverage*
coverage.xml

# Logs
logs/
# 输入法（搜狗）在进程 cwd 落的内核日志；从仓库根启动时会被写到这里
/debug.log
# 排障时临时重定向的构建/pip 输出，别进仓库
/build-*.log
/pip-*.log

# 外置插件默认目录（独立检出，可容纳多个私有插件）
/plugins/*
!/plugins/shuijiao_tuning/

# Private administration checkout and its nested public site repository.
/admin/
/server/

# local config (user overlay / session runtime)
/config/local*
/config/session*
# 跨进程读写锁（运行时产物，见 core/fs_util.interprocess_lock）
/config/**/.locks/

# local data
/data/local
/data/capture/picture
/data/capture/video
/data/temp*
/data/apk

# 任务运行快照（每次资源代次复制一份配置副本，进程退出后回收）
/.task/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Qoder
.qoder/
# Claude
.claude/
# WorkBuddy
.workbuddy/

# Android 构建（工具链自包含在 .tooling/，不入库）
.tooling/
android/.gradle/
android/local.properties
android/keystore.properties
*.jks
*.keystore
android/**/build/
android/**/.cxx/

# Kotlin build cache
android/.kotlin/

# VS Code extension build artifacts
editors/vscode/lvjiang-wf/out/
editors/vscode/lvjiang-wf/node_modules/
editors/vscode/lvjiang-wf/*.vsix

# Cloudflare Workers CLI 本地缓存（含账号信息，不进仓库）
ops/stats-worker/.wrangler/

# stats-client 本机配置与缓存：settings.toml（secrets_dir）、client.json、缓存库
ops/stats-client/.local/
# 旧目录（已迁到 .local/，留着忽略以防残留文件被误提交）
ops/stats-client/data/
ops/stats-client/.env
