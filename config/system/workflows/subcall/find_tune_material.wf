#% name: 查找调律材料
#% required_scenes: [equip_tune_detail]

# 在调律页材料格中寻找指定材料（一次截图，短路识别）
# input: "material_name" — 目标材料名称
# output: "slot_name" — 找到的材料格 key 名（空则未找到）

recognize [equip_tune_detail].[
        material_1, material_2, material_3, material_4, 
        material_5, material_6, material_7
    ] as $found by equals $material_name
collect $found as "slot_name"
