#% name: 指定备战方案装备扫描

import "subcall/navigation.wf"
import "subcall/loadout/equipment_scan.wf"
import "subcall/loadout/equipped_slots_scan.wf"

# 前置：游戏已经使用目标方案且当前在主页。
# 返回实际成功写入的槽位数；-2 表示本方案失败但已安全回主页，-1 表示页面不确定。
# 绑定只作用于本次 WF，不改变 UI 活动方案。
def scan_equipped_plan($name, $main_art, $sub_art)
    try
        eval bind_scanned_loadout($name, $main_art, $sub_art)
    catch $err
        log warn "跳过备战方案装备扫描，写入目标不安全: " + $name + "；" + $err
        return -2
    end
    call $nav_result = nav_main_to_equip()
    if $nav_result < 0
        return -1
    end
    eval $scan_error = ""
    eval $written = -2
    try
        call $written = scan_equipped_slots()
    catch $err
        eval $scan_error = $err
    end
    call $nav_result = nav_back_to_main()
    if $nav_result < 0
        return -1
    end
    if $scan_error
        log warn "跳过备战方案装备扫描: " + $name + "；" + $scan_error
        return -2
    end
    if $written < 0
        return -2
    end
    return $written
end
