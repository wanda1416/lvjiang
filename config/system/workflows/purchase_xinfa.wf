# ─── 导航：从首页到心法置换视图 ─────────────────────────
click [game_main_page].[menu] after wait page_refresh_wait
click [game_menu_page].[peiyang] after wait page_refresh_wait
click [training_main].[gongfa] after wait step_interval
click [training_main].[xinfa] after wait page_refresh_wait
click [training_xinfa].[exchange] after wait page_refresh_wait

# ─── 返回导航 ────────────────────────────────────────────
def go_back()
    click [training_xinfa].[back] after wait page_refresh_wait
    click [training_main].[back] after wait page_refresh_wait
    click [game_menu_page].[back] after wait page_refresh_wait
end

loop while 1 == 1
    # ─── 主逻辑 ──────────────────────────────────────────────
    wait step_interval
    scan [training_xinfa].[sanben_1,sanben_2,sanben_3,sanben_4,sanben_5] as $btn by contains "自选"
    if not $btn
       log "找不到自选散本，结束"
       call go_back()
       return -1
    end

    click [training_xinfa].$btn after wait step_interval
    click [training_xinfa].[add_all] after wait step_interval
    click [training_xinfa].[purchase] after wait page_refresh_wait

    # 检查购买后是否出现确认按钮（未出现则数量不足）
    scan [training_xinfa].[confirm] as $confirm by contains "确认"
    if not $confirm
       log "书票数量不足，结束"
       call go_back()
       return -1
    end

    click [training_xinfa].[add_max] after wait step_interval
    click [training_xinfa].[confirm] after wait page_refresh_wait

    click [training_xinfa].[blank] after wait step_interval

    click [training_xinfa].[count] after wait step_interval
    click [training_xinfa].[recycle_entry] after wait step_interval
    click [training_xinfa].[recycle] after wait page_refresh_wait
    click [training_xinfa].[confirm] after wait page_refresh_wait
end