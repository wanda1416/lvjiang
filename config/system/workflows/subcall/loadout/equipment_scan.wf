# 装备详情统一扫描。
#
# 重置调律或词条转律处于冷却中/冷却完成时，游戏会在原「宫」词条位置
# 插入状态提示，导致五个词条和定音整体下移。冷却提示使用独立的
# cooldown_tips 区域读取，避免 affix_gong 宽度不足导致文案被截断；命中后
# 再用冷却视图的六个专用区域重新截图 OCR，并映射回标准字段。

def scan_equipment_detail($detail_scene)
    if $detail_scene equals "equip_weapon_detail"
        scan [equip_weapon_detail].[equip_type, equip_level, base_attr, \
            affix_gong, affix_shang, affix_jue, affix_zhi, affix_yu, \
            dingyin, zaoyi, status, cooldown_tips] as $raw with "equip"
        if $raw.cooldown_tips contains "冷却"
            eval $raw.cooldown_text = $raw.cooldown_tips
            scan [equip_weapon_detail].[cooldown_affix_gong, \
                cooldown_affix_shang, cooldown_affix_jue, \
                cooldown_affix_zhi, cooldown_affix_yu, \
                cooldown_dingyin] as $cooldown with "equip"
            call apply_cooldown_affixes($raw, $cooldown)
        end
        eval $raw.lock_status = equipment_lock_status([equip_detail].[lock])
        return $raw
    end

    if $detail_scene equals "equip_armor_detail"
        scan [equip_armor_detail].[equip_type, equip_level, base_attr, \
            base_attr_2, affix_gong, affix_shang, affix_jue, \
            affix_zhi, affix_yu, dingyin, zaoyi, status, cooldown_tips] \
            as $raw with "equip"
        if $raw.cooldown_tips contains "冷却"
            eval $raw.cooldown_text = $raw.cooldown_tips
            scan [equip_armor_detail].[cooldown_affix_gong, \
                cooldown_affix_shang, cooldown_affix_jue, \
                cooldown_affix_zhi, cooldown_affix_yu, \
                cooldown_dingyin] as $cooldown with "equip"
            call apply_cooldown_affixes($raw, $cooldown)
        end
        eval $raw.lock_status = equipment_lock_status([equip_detail].[lock])
        return $raw
    end

    log error "不支持的装备详情场景: " + $detail_scene
    return null
end

def apply_cooldown_affixes($raw, $cooldown)
    eval $raw.affix_gong = $cooldown.cooldown_affix_gong
    eval $raw.affix_shang = $cooldown.cooldown_affix_shang
    eval $raw.affix_jue = $cooldown.cooldown_affix_jue
    eval $raw.affix_zhi = $cooldown.cooldown_affix_zhi
    eval $raw.affix_yu = $cooldown.cooldown_affix_yu
    eval $raw.dingyin = $cooldown.cooldown_dingyin
end
