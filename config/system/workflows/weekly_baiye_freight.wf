#% name: 周常百业货运
#% env: [android, desktop]
#% hidden: true   # 尚未开发完毕，默认不在日常页展示

# 周常百业货运流程
#
# 流程结构：
#   1. 导航：从首页 → 菜单 → 百业 → 返回驻地
#   2. 处理确认弹窗后验证是否抵达百业驻地
#   3. TODO: 后续补充货运具体操作

import "subcall/page_detection.wf"
import "subcall/navigation.wf"
import "subcall/page_action.wf"
import "subcall/record/baiye_freight.wf"

# ─── 导航：从首页到百业驻地 ─────────────────────────────
call $nav_result = nav_main_to_menu()
if $nav_result < 0
    return -1
end

find [game_menu_page].[menu] as $found by contains "百业"

if not $found
    log "菜单中未找到「百业」入口"
    eval notify("找不到百业入口，任务结束")
    return -1
end

click $found after wait stable @page_refresh
click [baiye_main].[goto_baiye] after wait @page_refresh

call $confirmed = scan_and_confirm("前往百业", 1)
if $confirmed
    # 通过 check_in_baiye 检查是否抵达百业，最多等待 20s
    eval $arrived = 0
    loop 10
        call $result = check_in_baiye()
        if $result == 0
            eval $arrived = 1
        break
    end
    wait @step_interval
    end
    if not $arrived
        eval pause("等待进入百业驻地超时，请手动检查后点击继续")
    end
else
    log "找不到百业驻地入口确认弹窗，请手动进入百业驻地"
    eval pause("请手动进入百业驻地后点击继续")
    call $result = check_in_baiye()
    if $result != 0
        eval pause("仍未检测到百业驻地，请确认页面状态后点击继续")
    end
end

log "已抵达百业驻地"

# ─── TODO: 后续补充货运具体操作 ──────────────────────────
if env("desktop")
    call nav_home_to_freight()
else

end

# 和温无双开始对话
find [general_chat].[chat_area] as $found by contains "温无双"

if not $found
    log error "找不到温无双对话"
    return -1
end

env:"android" -> click $found
env:"desktop" -> press "F"

wait (5,6)

env:"android" -> log "暂未实现"
env:"desktop" -> press "F"





log "百业货运流程结束"

# ─── 检查是否抵达百业驻地 ──────────────────────────────
# 百业驻地在游戏主页，通过 is_in_main_page 判定
def check_in_baiye()
    call $in_main = is_in_main_page()
    if $in_main
        log "抵达百业驻地"
        return 0
    else
        return -1
    end
end
