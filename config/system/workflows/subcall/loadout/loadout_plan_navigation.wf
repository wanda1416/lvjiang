#% name: 游戏备战方案导航

import "subcall/navigation.wf"

def nav_main_to_game_plans()
    call $result = nav_main_to_menu()
    if $result < 0
        return -1
    end
    scan [game_menu_page].[peiyang] as $entry by contains "培养"
    if not $entry
        return -1
    end
    click [game_menu_page].[peiyang] after wait @page_refresh
    click [training_main].[gongfa] after wait @step_interval
    click [training_main].[fangan] after wait @page_refresh
    scan [training_main].[plan_list] as $list
    if not $list
        return -1
    end
    return 0
end

def nav_game_plans_to_main()
    click [training_main].[back] after wait @page_refresh
    scan [training_main].[gongfa] as $gongfa by contains "功法"
    if not $gongfa
        return -1
    end
    click [training_main].[back] after wait @page_refresh
    call $in_menu = is_in_menu_page()
    if not $in_menu
        return -1
    end
    click [game_menu_page].[back] after wait @page_refresh
    call $in_main = is_in_main_page()
    if not $in_main
        return -1
    end
    return 0
end

def collect_game_plan_names()
    # 整面板按布局实际行数识别；空槽没有文字。列表可能超过一屏。
    loop 6
        if env("desktop")
            scroll [training_main].[plan_list] up 8
        else
            drag [training_main].[plan_list] down 0.5
        end
        wait @step_interval
    end
    eval $names = []
    eval $seen = {}
    eval $unchanged = 0
    loop 16
        scan [training_main].[plan_list] as $grid
        eval $before = len($names)
        for row in keys($grid)
            eval $name = trim($grid.$row.[1])
            if len($name) > 0 and not $seen.$name
                eval append($names, $name)
                eval $seen.$name = true
            end
        end
        if len($names) == $before
            eval $unchanged = $unchanged + 1
            if $unchanged >= 2
                break
            end
        else
            eval $unchanged = 0
        end
        if env("desktop")
            scroll [training_main].[plan_list] down 3
        else
            drag [training_main].[plan_list] up 0.5
        end
        wait @step_interval
    end
    return $names
end

def select_game_plan($name)
    # 按游戏列表发现的名称重新定位；扫描装备后会回主页，列表页需重新进入。
    loop 6
        if env("desktop")
            scroll [training_main].[plan_list] up 8
        else
            drag [training_main].[plan_list] down 0.5
        end
        wait @step_interval
    end
    eval $found = ""
    loop 16
        find [training_main].[plan_list] as $found by equals $name
        if $found
            break
        end
        if env("desktop")
            scroll [training_main].[plan_list] down 3
        else
            drag [training_main].[plan_list] up 0.5
        end
        wait @step_interval
    end
    if not $found
        log error "游戏方案列表未找到: " + $name
        return -1
    end
    click $found after wait @page_refresh
    scan [training_main].[plan_title, main_art, sub_art] as $detail
    eval $title = trim($detail.plan_title)
    eval $main_art = trim($detail.main_art)
    eval $sub_art = trim($detail.sub_art)
    if $title != $name or not $main_art or not $sub_art
        log error "游戏方案名称或武学识别不完整: " + $name
        return -1
    end

    scan [training_main].[use_area] as $use by contains "使用方案"
    if $use
        click [training_main].[use_area] after wait @page_refresh
        loop 3
            scan [training_main].[modal_message] as $message
            if $message.modal_message contains "装备缺失"
                scan [training_main].[smart_fill] as $action by contains "智能填充"
                if not $action
                    log error "缺装备弹窗未识别到智能填充按钮"
                    return -1
                end
                click [training_main].[smart_fill] after wait @page_refresh
            else if $message.modal_message contains "未保存"
                scan [general_control].[confirm] as $action by contains "切换"
                if not $action
                    return -1
                end
                click [general_control].[confirm] after wait @page_refresh
            else
                break
            end
        end
        scan [training_main].[modal_message] as $message
        if $message.modal_message contains "装备缺失" or $message.modal_message contains "未保存"
            return -1
        end
    else
        scan [training_main].[plan_title] as $title by contains $name
        find [training_main].[use_area] as $save_as by contains "另存为"
        if not $title and not $save_as
            log error "未找到使用方案按钮，也无法确认已在目标方案: " + $name
            return -1
        end
    end
    scan [training_main].[plan_list] as $ready
    if not $ready
        log error "方案切换后未恢复方案列表: " + $name
        return -1
    end
    find [training_main].[use_area] as $still_use by contains "使用方案"
    if $still_use
        log error "切换后仍显示使用方案按钮: " + $name
        return -1
    end
    return {"name": $title, "main_art": $main_art, "sub_art": $sub_art}
end
