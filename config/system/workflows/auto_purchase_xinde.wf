@todo 

scan [training_xinde].[count] as $result
if $result.count is_empty or $result.count < 5
   log "书票数量不足，结束"
   return
end

scan [training_xinde].[sanben_1,sanben_2,sanben_3,sanben_4,sanben_5] as $btn by contains "自选"
if not $btn
   log "找不到自选散本，结束"
   return
end

click [training_xinde].$btn after wait step_interval
click [training_xinde].[add_all] after wait step_interval
click [training_xinde].[purchase] after wait page_refresh_wait
  
click [training_xinde].[add_max] after wait step_interval
click [training_xinde].[confirm] after wait page_refresh_wait
  
click [training_xinde].[blank] after wait step_interval

click [training_xinde].[count] after wait step_interval
click [training_xinde].[recycle_entry] after wait step_interval
click [training_xinde].[recycle] after wait page_refresh_wait
click [training_xinde].[confirm] after wait page_refresh_wait

goto todo