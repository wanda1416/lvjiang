#% name: 每日江湖号令
#% env: [android, desktop]
#% parameters:
#%   - name: max_refresh
#%     label: 单任务最大刷新次数
#%     type: number
#%     default: 50
#%     min: 1
#%   - name: claim_reward
#%     label: 领取奖励
#%     type: bool
#%     default: false
#
# 江湖号令任务刷新流程
#
# 流程结构：
#   0. 起始定位：通过公共页面判断确认在活动页，否则先导航
#   for 遍历 6 组 label_N / btn_N
#      0. 再次校验仍在号令页；不在则阻塞弹窗提示用户手动
#         处理（前一个任务卡住退出时可能漏回号令页，需及时拦截，
#         避免后续任务在错误页面上继续乱点）
#      1. 识别 label_N 文本是否命中目标任务列表（contains_any 短路匹配）
#      2. 命中 → 读取任务文本，分发执行对应动作
#      3. 未命中 → 点击 btn_N 刷新，等待后重新识别，直到命中或达到刷新上限
#   4. 收尾：若仍在活动页，退回游戏首页
#
# 参数：
#   max_refresh — 单个任务最大刷新次数，默认 50
#   claim_reward — 是否领取奖励，默认 false；勾选后每个任务完成
#                  切到下一个 label 前再点一次领取。第六个任务若落在
#                  桌面（合影/看报），会先返回号令页领取再由收尾退回桌面

default $max_refresh = 50
default $claim_reward = false

import "subcall/navigation.wf"
import "subcall/page_detection.wf"

# 目标任务关键词列表
eval $targets = ["合影", "换装", "情境", "东方", "醉意", "觉障林"]

# 起始定位：用户可能在江湖号令活动页点 F9，也可能停在游戏首页
# 读不到「号令」标题即视为在首页，先自动导航进活动页（auto_nav=1）
call $haoling_ok = ensure_at_haoling("起始", 1)
if $haoling_ok < 0
   return -1
end

for idx in ["1", "2", "3", "4", "5", "6"]

   # 任务开头再校验一次是否仍在号令页：前一个任务若卡住退出，
   # 可能未回到号令页，导致后续任务全部错乱。此时停在未知页面，
   # 不能自动导航（auto_nav=0），阻塞弹窗提示用户手动处理
   call $haoling_ok = ensure_at_haoling($idx, 0)
   if $haoling_ok < 0
      return -1
   end

   # 动态构造本组的 label / btn region 名
   eval $label = "label_" + $idx
   eval $btn = "btn_" + $idx

   # 先识别当前任务是否已是目标任务
   scan [activity_jianghu].$label as $hit by contains_any $targets
   if $hit
      log "任务 " + $idx + " 已是目标任务"
   else
      # 不断刷新直到命中目标任务
      loop $max_refresh
         click [activity_jianghu].$btn after wait stable @page_refresh least 0.3
         scan [activity_jianghu].$label as $hit by contains_any $targets
         if $hit
            log "任务 " + $idx + " 刷新命中目标任务"
            break
         end
      end
      if not $hit
         log "任务 " + $idx + " 达到刷新上限仍未命中，跳过"
      end
   end

   # 命中目标任务 → 读取任务文本，分发执行对应动作
   if $hit
      scan [activity_jianghu].$label as $text_result
      eval $task_text = $text_result.$label
      log "任务 " + $idx + " 命中：" + $task_text

      if $task_text contains "换装"
         call action_huanzhuang($label)
      end
      if $task_text contains "合影"
         call action_heying($label, $idx)
      end
      if $task_text contains "情境"
         call action_qingjing($label)
      end
      if $task_text contains "东方"
         call action_dongfang($label, $idx)
      end
      if $task_text contains "醉意"
         call $action_result = action_zuiyi($label, $idx)
      end
      if $task_text contains "觉障林"
         call action_juezhanglin($label)
      end

      # 领取奖励（勾选时）：动作完成后、切到下一个 label 前再点一次任务标签
      # 觉障林未实现，点击会卡页面，无论是否勾选均跳过领奖
      if $claim_reward and not $task_text contains "觉障林"
         call claim_reward($label, $idx)
      end
   end

end

log "六个任务刷新处理完成"

# 收尾：末个任务非合影时仍停在江湖号令页，连点三次返回退回游戏首页
call $at_haoling = is_in_haoling_page()
if $at_haoling
   log "仍在江湖号令页，退回游戏首页"
   click [activity_jianghu].[back] after wait @step_interval
   click [school_main].[back] after wait @step_interval
   click [game_menu_page].[back] after wait @step_interval
end

# 校验当前是否位于江湖号令页，不在则先设法回到号令页再校验一次。
#   $idx     — 调用点标识，仅用于日志（"起始" 或任务序号）
#   $auto_nav — 1：视为停在游戏首页，调 back_to_haoling() 自动导航；
#               0：停在未知页面（上个任务卡住未收尾），自动导航不可靠，
#                  改为阻塞弹窗提示用户手动返回号令页
# 返回：0=已在号令页；-1=补救后仍不在，调用方应终止流程
def ensure_at_haoling($idx, $auto_nav)
   call $at_haoling = is_in_haoling_page()
   if $at_haoling
      return 0
   end

   if $auto_nav
      log $idx + "：未识别到号令标题，视为当前在游戏首页，先导航至江湖号令页"
      call back_to_haoling()
   else
      log "任务 " + $idx + " 开始前检测到不在江湖号令页，可能是上个任务未正常收尾"
      eval pause("检测到当前不在江湖号令页，请手动返回号令页后点击继续")
   end

   call $at_haoling = is_in_haoling_page()
   if $at_haoling
      return 0
   end

   log "仍未进入江湖号令页，终止流程"
   return -1
end

# 领取奖励：动作完成后再次点击任务标签领取
# 调用时必定已在号令页（状态由各动作保证：非末个任务动作结束后
# 主动返回；末个任务需领奖时动作内也已返回），无需再扫描定位。
# 领奖后会弹出一个奖励窗口：末个任务领完即进入收尾，
# 需多点一次返回先关闭弹窗，收尾才能顺利退回游戏首页
def claim_reward($label, $idx)
   click [activity_jianghu].$label after wait @step_interval
   log "任务 " + $idx + " 奖励已领取"
   if $idx equals "6"
      click [activity_jianghu].[back] after wait @step_interval
      log "末个任务领奖弹出奖励窗口，多点一次返回关闭"
   end
end

# ─── 各活动动作过程 ────────────────────────────────────────
# 每个 def 接收命中任务的 label region 名（如 "label_1"），
# 从江湖号令页面出发执行对应活动，完成后需回到本页面。

# 换装：点击任务 → 前往 → 外观衣柜（穿搭方案 → 方案1 → 套用方案） → 返回三次回到活动页
def action_huanzhuang($label)
   click [activity_jianghu].$label after wait @step_interval
   click [activity_jianghu].[goto] after wait stable @page_refresh least 0.5
   click [waiguan_yigui].[chuanda] after wait @step_interval
   click [waiguan_yigui].[fangan_1] after wait @step_interval
   click [waiguan_yigui].[taoyong] after wait @step_interval
   click [waiguan_yigui].[back] after wait @step_interval
   click [waiguan_yigui].[back] after wait stable @page_refresh least 0.5
   click [activity_jianghu].[back] after wait @step_interval
end

# 合影拍照：点击任务 → 前往 → 拍照页面（动作控制·拍照）→ 等待刷新 → 游戏菜单·返回×2 → 动作控制·返回确认
# 退出拍照会落到游戏首页（桌面），拍照结束后主动返回号令页；
# 末个任务仅在需要领奖时才返回，否则留在桌面
def action_heying($label, $idx)
   click [activity_jianghu].$label after wait @step_interval
   click [activity_jianghu].[goto] after wait stable @page_refresh least 0.5

   if env("android")
      click [general_action].[camera_shot] after wait @page_refresh
      click [general_action].[back] after wait @step_interval
      click [general_action].[back] after wait @step_interval
      click [general_action].[back_confirm] after wait @step_interval
   else
      PRESS "SPACE" after wait @page_refresh
      PRESS "ESC" after wait @step_interval
      PRESS "ESC" after wait @step_interval
      PRESS "SPACE" after wait @step_interval
   end

   # 拍照结束落在桌面：非末个任务必须返回；末个任务仅领奖时返回
   if $idx equals "6" and not $claim_reward
      log "末个任务合影完成且无需领奖，留在桌面"
   else
      call back_to_haoling()
   end
end

# 情境：点击任务 → 弹出情境视图（确认×2 → 展开 → 前往编辑情境）
# → 情境编辑视图（保存 → 取消按钮出现则点一次 → 等 6s）
# → 情境基底返回退回号令页 → 号令页连点两次返回回到号令主页面
def action_qingjing($label)
   click [activity_jianghu].$label after wait @step_interval
   click [activity_jianghu].[goto] after wait @step_interval
   if env("android")
      click [activity_jianghu].[confirm] after wait @step_interval
      click [activity_jianghu].[expand_up] after wait @step_interval
   end
   click [activity_jianghu].[goto_qingjing] after wait @secondary_confirm

   # 检查是否在衣柜页面（识别到"穿搭"），如果是则导航回情境页面
   scan [waiguan_yigui].[chuanda] as $in_yigui by contains "穿搭"
   if $in_yigui
      log "检测到在衣柜页面，导航回情境编辑页面"
      click [waiguan_qingjing].[qingjing] after wait @step_interval
      click [waiguan_qingjing].[goto_editing] after wait @secondary_confirm
   end

   # 保存后弹窗需要渲染时间，先等一下再扫描
   click [waiguan_qingjing].[save] after wait @secondary_confirm
   
   # 保存后可能弹出二次确认，识别到取消按钮才点一次
   scan [waiguan_qingjing].[cancel] as $has_cancel by contains "取消"
   if $has_cancel
      log "情境保存弹出取消按钮，点击一次"
      click [waiguan_qingjing].[cancel] after wait @step_interval
   end
   # 轮询检查 save 区域是否出现「保存」，最多等待 10 次
   eval $save_i = 0
   eval $save_found = ""
   loop while $save_i < 10
      eval $save_i = $save_i + 1
      wait @step_interval
      scan [waiguan_qingjing].[save] as $save_found by contains "保存"
      if $save_found
         break
      end
   end
   if not $save_found
      eval pause("保存情境失败，请手动处理")
   end

   click [waiguan_qingjing].[back] after wait stable @page_refresh least 0.5
   click [activity_jianghu].[back] after wait @step_interval
   click [activity_jianghu].[back] after wait @step_interval
end

# 东方第一枝（看报）：点击任务 → 前往 → 立刻进入表情动作视图
# → 整面板扫描 actions 定位「看报」格子并点击 → 等 5s 弹出报纸阅读视图
# → 点第一个选择 → 连点两次返回回到游戏首页（桌面），看报结束后主动返回号令页；
# 末个任务仅在需要领奖时才返回，否则留在桌面
def action_dongfang($label, $idx)
   click [activity_jianghu].$label after wait @step_interval
   click [activity_jianghu].[goto] after wait @step_interval

   # 整面板扫描动作列表，定位「看报」所在行列（行列数读自布局定义）
   scan [general_action].[actions] as $acts
   eval $nrows = panel_rows("general_action", "actions")
   eval $ncols = panel_cols("general_action", "actions")
   eval $fr = ""
   for r in [1...$nrows]
      for c in [1...$ncols]
         if $acts.$r.$c contains "看报"
            eval $fr = $r
            eval $fc = $c
            goto found_kanbao
         end
      end
   end

   @found_kanbao
   if $fr is_empty
      # 扫描读不到时回退默认位置：看报固定在 1 行 3 列
      log "动作列表未识别到「看报」，按默认位置 [1][3] 处理"
      eval notify("东方第一枝：未识别到「看报」，按默认位置 [1][3] 处理")
      eval $fr = 1
      eval $fc = 3
   end

   if env("android")
      click [general_action].[actions][$fr][$fc] after wait @step_interval
   else
      press $fc after wait @step_interval
   end
   # 看报动作生效需时间，固定等 5 秒弹出报纸阅读视图
   wait 5
   
   # 检查是否仍在主页（看报动作未解锁，未进入表情动作视图）
   call $in_main = is_in_main_page()
   if $in_main
       log "仍在主页，看报动作可能未解锁，跳过看报操作"
   else
       call do_kanbao()
   end
   
   # 看报结束落在桌面：非末个任务必须返回；末个任务仅领奖时返回
   if $idx equals "6" and not $claim_reward
      log "末个任务看报完成且无需领奖，留在桌面"
   else
      call back_to_haoling()
   end
end

# ─── 看报操作 ─────────────────────────────────────────────
# 前提：已进入表情动作视图（不在主页）
# 点第一个选择 → 返回 → 处理确认弹窗 → 检查是否已回到主页
def do_kanbao()
   click [general_action].[choose_1] after wait stable @page_refresh least 0.5
   click [general_action].[space_area] after wait stable @page_refresh least 0.5

   # 投票后可能弹出确认弹窗，识别到"确认"则点击"取消"关闭
   scan [general_control].[confirm] as $has_confirm by contains "确认"
   if $has_confirm
      log "检测到确认弹窗，点击取消关闭"
      click [general_control].[cancel] after wait @step_interval
   end

   # 如果已经完成过任务，可能导致此时已经在主页，所以需要额外判断
   call $in_main_page = is_in_main_page()
   if $in_main_page == 0
       click [general_action].[back] after wait @step_interval
   end

   # 端游处于动作列表必须 ESC 关闭才能结束，暂时不做判断，除非后续此处大量报错
   if env("desktop")
      press "ESC" after wait @step_interval
   end
end

# 饮酒（醉意）：号令 → 退回首页 → 菜单 → 包裹 → 道具 - 普通道具 → 找黄泉酿食用 → 退回首页 → 返回号令
def action_zuiyi($label, $idx)
   # ── 从江湖号令退回首页 ──
   click [activity_jianghu].[back] after wait stable @page_refresh least 0.5
   click [school_main].[back] after wait stable @page_refresh least 0.5
   click [game_menu_page].[back] after wait stable @page_refresh least 0.5

   # ── 首页 → 菜单 → 包裹 → 道具 - 普通道具 ──
   call $nav_result = nav_main_to_item()
   if $nav_result < 0
      return -1
   end

   # ── 在背包网格中寻找黄泉酿 ──
   recognize [bag_item_detail].[bag_grid][1...2][1...6] as $result \
      by equals "黄泉酿" \
      on group ["增益道具"] \
      where confidence >= 0.65

   if $result
      eval $zuiyi_r = $result.row
      eval $zuiyi_c = $result.col
      log "找到黄泉酿：row=" + $zuiyi_r + ", col=" + $zuiyi_c

      # 点击黄泉酿所在格子，打开道具详情
      click [bag_item_detail].[bag_grid][$zuiyi_r][$zuiyi_c] after wait stable @page_refresh least 0.5
      
      if env("android")
         # 在详情面板中寻找「食用」按钮
         find [bag_item_detail].[main_area] as $btn by contains "食用"
         if $btn
            click $btn after wait @step_interval
            wait 1
            # 食用后可能弹出确认弹窗，识别到"确认"则点击"取消"关闭
            scan [general_control].[confirm] as $has_confirm by contains "确认"
            if $has_confirm
               click [general_control].[cancel] after wait @step_interval
            end
         else
            log "找不到食用按钮"
         end
      else
         press "F" after wait @step_interval
      end
   else
      log "找不到黄泉酿"
   end

   # ── 关闭背包，退回首页 ──
   call nav_back_to_main()

   if $idx equals "6" and not $claim_reward
      log "末个任务醉意完成且无需领奖，留在桌面"
   else
      call back_to_haoling()
   end
end

# 觉障林：动作暂未实现
def action_juezhanglin($label)
   log "觉障林动作暂未实现"
end

# 首页 → 江湖号令页：菜单 → find 门派 → 门派首页 → find 江湖号令
# 每步找不到时 pause 通知用户手动定位，用户点确定后重试一次
def back_to_haoling()
   call $nav_result = nav_main_to_menu()
   if $nav_result < 0
      eval pause("打不开菜单页，请手动定位到菜单页后点击确定")
      call $in_menu = is_in_menu_page()
      if $in_menu < 1
         return -1
      end
   end

   # 在菜单区域搜索「门派」，可能需要下滑翻页
   find [game_menu_page].[menu] as $found by contains "门派"
   if not $found
      drag [general_control].[menu_up] after wait @step_interval
      find [game_menu_page].[menu] as $found by contains "门派"
   end
   if not $found
      log "找不到门派，请手动定位后继续"
      eval pause("找不到「门派」，请手动定位到门派入口后点击确定")
      find [game_menu_page].[menu] as $found by contains "门派"
   end
   if not $found
      log "仍未找到门派，无法前往江湖号令页"
      return -1
   end
   click $found after wait (2, 3)

   # 门派页三种形态：
   # # 有门派（基底，入口文字「江湖号令」）
   # # 无门无派（no_school 视图，入口换成 haoling_2）
   # # 问津（wenjin 视图，入口换成 haoling_3）
   scan [school_main].[haoling_1, haoling_2, haoling_3] as $haoling_key by contains "号令"
   if $haoling_key
      log "识别到号令，正常进入，区域：" + $haoling_key
      click [school_main].$haoling_key after wait stable @page_refresh least 0.5
      return 0
   end

   # 三种都识别不到，干脆全图扫
   # 门派页三种形态均含「号令」文字，find 统一搜索
   find as $haoling_key by contains "号令"
   if $haoling_key
      screenshot
      log "全图扫识别到江湖号令，已截图，建议检查问题"
      click $haoling_key after wait @step_interval
   else
      log "找不到江湖号令，请手动定位后继续"
      eval pause("找不到「江湖号令」，请手动定位到号令页后点击确定")
   end
   return 0
end
