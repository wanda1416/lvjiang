# 批处理公共子过程定义
# 被 _switch_account.wf 和 _select_role.wf import 使用

# ─── 选角色 + 进入游戏 ───────────────────────────────────
def select_role_and_enter($role_idx)
    click [game_login_page].[switch_role]
    wait (1, 2)

    # 选角色（role_list: 1列4行，role_idx 1-4 → panel 行 1-4）
    click [game_login_page].[role_list][$role_idx][1]
    wait (1, 2)

    # 进入游戏
    click [game_login_page].[enter]
    wait 5

    # 等待加载完成：检测 loading 区域的「加载」文字
    # 有「加载」→ 继续等；消失后再等 5 秒视为登录完成
    loop 10
        scan [game_login_page].[loading] as $load_text by contains "加载"
        if $load_text
            wait 5
        else
            goto loading_done
        end
    end
    eval pause("等待加载超时，请手动确认后点击确定")

    @loading_done
    wait 5
end
