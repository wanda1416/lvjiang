# 从装备详情页进入调律页面
# 前置：在装备详情页（equip_weapon_detail）
# 后置（成功）：在调律详情页（equip_tune_detail）
# 后置（失败）：仍在装备详情页
# 输出：成功时 collect $result（含 status 字段），失败时无输出

click [equip_weapon_detail].[more_func]
wait step_interval

scan [equip_weapon_detail].[sub_func_1, sub_func_2, sub_func_3, sub_func_4] as $tune_scan
find $tune_scan "调律" as $tune_pos
if not $tune_pos
    log "未找到调律按钮"
    return
end
click $tune_pos
wait step_interval

eval $result = "ok"
collect $result as "status"
