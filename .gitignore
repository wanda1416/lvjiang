# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environment
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Tool caches (mypy baseline worktree etc.)
.git-mypy-base/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.testmondata*
.pytest-*/
# .coverage* 而非 .coverage：pytest-xdist 并行跑覆盖率会产生
# .coverage.<host>.<pid>.<rand> 分片，中断的运行会把它们留在工作区。
.coverage*
coverage.xml

# Logs
logs/
# 输入法（搜狗）在进程 cwd 落的内核日志；从仓库根启动时会被写到这里
/debug.log

# 外置插件默认目录（独立检出，可容纳多个私有插件）
/plugins/

# Private administration checkout and its nested public site repository.
/admin/

# local config (user overlay / session runtime / 在线下发层)
/config/local*
/config/session*
/config/remote*
/config/system/workflows/_*

# local data
/data/local
/data/capture/picture
/data/capture/video
/data/temp*
/data/apk

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Qoder
.qoder/
# Claude
.claude/

# Android 构建（工具链自包含在 .tooling/，不入库）
.tooling/
android/.gradle/
android/local.properties
android/keystore.properties
*.jks
*.keystore
android/**/build/
android/**/.cxx/

# Kotlin build cache
android/.kotlin/

# VS Code extension build artifacts
editors/vscode/lvjiang-wf/out/
editors/vscode/lvjiang-wf/node_modules/
editors/vscode/lvjiang-wf/*.vsix

# Cloudflare Workers CLI 本地缓存（含账号信息，不进仓库）
ops/stats-worker/.wrangler/

# stats-client 本地缓存/凭据（含 install_id 与本地文件回退的 token，不进仓库）
ops/stats-client/data/
ops/stats-client/.env

# Generated public Agent bundle; source stays in docs/10-game, docs/30-architecture, docs/60-userguide and docs/70-agent.
/agent/

# Local activation proof is private and never published.
/config/local/license-activation.json

/config/local/.license-*
