// 工作流 DSL v2 - Lark 语法文件
//
// 关键约定：
// - [name] / [name].[name] → 静态配置引用（场景名/区域名），来自 yaml
// - $name → 运行时变量引用，来自 variables dict
// - 两者在语法层面完全不交叉，无歧义

start: (_NL | statement)*

// ─── 语句分派 ─────────────────────────────────────────────

?statement: click_stmt
          | drag_stmt
          | wait_stable_stmt
          | wait_stmt
          | scan_stmt
          | recognize_stmt
          | collect_stmt
          | log_stmt
          | screenshot_stmt
          | eval_stmt
          | implicit_eval_stmt
          | default_stmt
          | align_stmt
          | find_stmt
          | import_stmt
          | def_stmt
          | call_proc_stmt
          | if_stmt
          | for_stmt
          | loop_count_stmt
          | loop_while_stmt
          | loop_until_stmt
          | break_stmt
          | continue_stmt
          | return_stmt
          | label_stmt
          | goto_stmt
          | try_stmt

// ─── 基础指令 ─────────────────────────────────────────────

// align：触发 panel 区域截图 + 图像自对齐，缓存格子坐标
// 语法：align [scene].[panel]
align_stmt: "align"i bracket_expr "." bracket_expr _NL

// find：在指定区域或全画布 OCR 搜索目标文字，产出可点击的 FoundRegion 变量
// 与 scan/recognize 共享 scene_target + by_clause 语法
// 两种形式：
//   find [scene].[area] as $var by contains "文字"  — 指定区域搜索
//   find as $var by contains "文字"                 — 全画布搜索
find_stmt: "find"i scene_target "as"i var_ref by_clause where_clause? _NL -> find_stmt_area
         | "find"i "as"i var_ref by_clause where_clause? _NL              -> find_stmt_full

// click 支持四种目标：
//   1. [scene].[panel][row][col] — panel 三级索引（点击格子中心）
//   2. [scene].[region] / $var.[region] / ... — scene.area 引用
//   3. $var — 裸变量引用（find 指令产出的 FoundRegion，直接点击文字位置）
//   4. (rx, ry) — 画布归一化坐标点
//
// 注意：panel 与 scene.area 都以 [x].[y] 开头，必须用同一规则避免歧义。
// transformer 根据 row/col 是否存在分派为 SceneRef 或 PanelRef。
click_stmt: "click"i click_target wait_clause? _NL
click_target: const_or_var "." const_or_var panel_index panel_index -> click_panel_target
            | const_or_var "." const_or_var                          -> click_scene_target
            | var_ref                                                  -> click_var_target
            | coord_point                                              -> click_coord_target

// drag 支持五种目标：
//   1. [scene].[panel][row][col] [up|down [n]] — panel cell 级拖拽
//   2. [scene].[panel] up|down|left|right [n]  — panel grid 级拖拽（中心起拖）
//   3. [scene].[point_1] [scene].[point_2]      — 两个命名点之间拖拽
//   4. scene.arrow — scene.arrow 引用
//   5. (rx1, ry1) (rx2, ry2) — 两坐标点
drag_stmt: "drag"i drag_target drag_duration? drag_hold? wait_clause? _NL
drag_target: const_or_var "." const_or_var panel_index panel_index drag_direction? -> drag_panel_target
           | const_or_var "." const_or_var drag_direction                       -> drag_grid_target
           | const_or_var "." const_or_var const_or_var "." const_or_var        -> drag_point_pair_target
           | const_or_var "." const_or_var                                      -> drag_scene_target
           | coord_point coord_point                                            -> drag_coord_target

// panel 拖拽方向：up/down/left/right + 可选距离（默认 1，支持数值或变量）
// up/down 按行计算，left/right 按列计算
// 距离支持整数、浮点数（如 0.5 表示半行）、变量引用
// 使用 DRAG_DIST 终端避免与 drag_duration 的 number 冲突
// 优先级 .2 确保在 drag_direction 上下文中优先匹配
drag_direction: DRAG_DIR DRAG_DIST?
DRAG_DIR: /up/i | /down/i | /left/i | /right/i
DRAG_DIST.2: /[0-9]+(\.[0-9]+)?/ | /\$[a-zA-Z_][a-zA-Z0-9_]*/

// panel 索引：[数字] 或 [$var]，显式包含括号以避免与 bracket_list 歧义
panel_index: "[" INT "]" -> panel_index_int
           | "[" var_ref "]" -> panel_index_var

// 画布归一化坐标点：(rx, ry)，rx/ry ∈ [0,1]
coord_point: "(" number "," number ")"

// 常量或变量：scene/region/arrow 都支持三种形式
?const_or_var: bracket_expr    // [name] — 括号常量
            | STRING            // "name" — 字符串常量
            | var_ref           // $var — 变量引用

drag_duration: number | bracket_list

drag_hold: "hold"i number

wait_stmt: "wait"i (delay_ref | number | bracket_expr | var_ref | wait_range) _NL

// wait stable：等待画面稳定（连续截图对比，差异低于阈值持续 stable_duration 秒）
// 语法：wait stable <timeout> [on [scene].[region]] [threshold <value>] [interval <value>] [duration <value>] [least <value>]
// 参数支持数值、命名延迟(@)、变量($)
// on 子句：限定稳定检测区域（半屏 UI + 半屏动画场景下，只对指定区域做 diff）
wait_stable_stmt: "wait"i wait_stable_ref _NL
wait_stable_ref: "stable"i (delay_ref | var_ref | number) wait_stable_on? wait_stable_opts?
wait_stable_on: "on"i const_or_var "." const_or_var
wait_stable_opts: wait_stable_opt+
wait_stable_opt: wait_stable_threshold
               | wait_stable_interval
               | wait_stable_duration
               | wait_stable_least
wait_stable_threshold: "threshold"i (delay_ref | var_ref | number)
wait_stable_interval: "interval"i (delay_ref | var_ref | number)
wait_stable_duration: "duration"i (delay_ref | var_ref | number)
wait_stable_least: "least"i (delay_ref | var_ref | number)

// 命名延迟引用：@delay_name（从延迟参数配置中查找）
delay_ref: "@" NAME

// 后缀等待子句：用于 click/drag 的内联等待
//   before wait xxx — 操作前等待
//   after wait xxx  — 操作后等待
//   around wait xxx  — 操作前后各等待一次（同一参数）
// 参数形式与 wait_stmt 完全一致（命名延迟/数值/范围/变量），另支持 wait stable
wait_clause: WAIT_TIMING "wait"i (wait_stable_ref | delay_ref | number | bracket_expr | var_ref | wait_range)
WAIT_TIMING: /before/i | /after/i | /around/i

wait_range: "(" number "," number ")"

// scan 支持两种目标：
//   1. [scene].[region] — 场景区域 OCR
//   2. [scene].[panel][row][col] — panel cell 级 OCR
scan_stmt: "scan"i scene_target "as"i var_ref by_clause? where_clause? _NL
         | "scan"i const_or_var "." const_or_var panel_index panel_index "as"i var_ref by_clause? where_clause? _NL -> scan_panel_stmt

// recognize 支持两种目标：
//   1. [scene].[region] — 场景区域材料识别
//   2. [scene].[panel][row][col] — panel cell 级材料识别
// rich 关键字：as rich $var 返回包含输入/输出元数据的富 dict
// with 子句：as rich $var with func_name — 指定 dict->dict 转换函数
RICH_KEYWORD: "rich"i
recognize_stmt: "recognize"i scene_target "as"i RICH_KEYWORD? var_ref by_clause? group_clause? where_clause? with_clause? _NL
              | "recognize"i const_or_var "." const_or_var panel_index panel_index "as"i RICH_KEYWORD? var_ref by_clause? group_clause? where_clause? with_clause? _NL -> recognize_panel_stmt

// by 子句：短路识别模式
// 有 by 时返回首个命中的字段名（str），无 by 时返回完整 dict
// match_mode 顺序：长关键字在前，确保词法 max-munch 正确分词
by_clause: "by"i match_mode by_target
match_mode: "equals_any"i -> match_equals_any
          | "contains_any"i -> match_contains_any
          | "equals"i -> match_equals
          | "contains"i -> match_contains
?by_target: STRING | var_ref

// group 子句：限定材料识别的分组范围
group_clause: "on"i "group"i (STRING | var_ref)

// where 子句：识别结果过滤条件（纯过滤，不改变返回语义）
// 当前仅支持 confidence >= threshold
where_clause: "where"i "confidence"i ">=" (number | var_ref)

// with 子句：指定 rich 模式的 dict->dict 转换函数（任意满足 dict->dict 的内置函数）
with_clause: "with"i NAME

// 场景目标：支持静态/动态场景名 + 静态/动态字段
// 场景名：[scene] / "scene" / $var
// 字段：.[field] / .$var / .[f1,f2] / 无字段
scene_target: scene_name "." var_ref         -> scene_target_dyn
            | scene_name field_list?         -> scene_target_static

?scene_name: bracket_expr | STRING | var_ref

collect_stmt: "collect"i collect_source collect_as_clause? _NL

// collect 源：变量引用、字段访问、或字面量（数字/字符串）
?collect_source: var_ref | field_access | literal

// collect as 支持字符串常量或变量
collect_as_clause: "as"i (STRING | var_ref)

// log 支持可选级别：log [debug|info|warn|error] "message"
// 默认 info
log_stmt: "log"i LOG_LEVEL? log_arg _NL

LOG_LEVEL: /debug/i | /info/i | /warn/i | /error/i

// log 参数：任何能求值为字符串的表达式（支持 + 拼接）
?log_arg: arith_expr | func_call | var_ref | field_access

// screenshot：截取当前画面并保存到 logs/image/
// 语法：screenshot
screenshot_stmt: "screenshot"i _NL

eval_stmt: "eval"i "$" NAME "=" NAME "(" arg_list? ")" _NL    -> eval_assign_func
         | "eval"i "$" NAME "=" literal _NL                    -> eval_assign_lit
         | "eval"i "$" NAME "=" arith_expr _NL                 -> eval_assign_arith
         | "eval"i "$" NAME "=" field_access _NL               -> eval_assign_expr
         | "eval"i "$" NAME "=" var_ref _NL                    -> eval_assign_expr
         | "eval"i field_access "=" eval_rhs _NL               -> eval_field_assign
         | "eval"i NAME "(" arg_list? ")" _NL                  -> eval_discard

// 隐式 eval：省略 eval 关键字，直接 $var = ...
implicit_eval_stmt: "$" NAME "=" NAME "(" arg_list? ")" _NL    -> implicit_eval_assign_func
                  | "$" NAME "=" literal _NL                    -> implicit_eval_assign_lit
                  | "$" NAME "=" arith_expr _NL                 -> implicit_eval_assign_arith
                  | "$" NAME "=" field_access _NL               -> implicit_eval_assign_expr
                  | "$" NAME "=" var_ref _NL                    -> implicit_eval_assign_expr
                  | field_access "=" eval_rhs _NL               -> implicit_eval_field_assign

eval_rhs: NAME "(" arg_list? ")"  -> eval_rhs_func
        | arith_expr              -> eval_rhs_arith
        | literal                 -> eval_rhs_lit
        | field_access            -> eval_rhs_field

// 默认值赋值：仅当变量未从外部传入时才赋值
default_stmt: "default"i "$" NAME "=" literal _NL

func_call: NAME "(" arg_list? ")"

arg_list: arg ("," arg)*

?arg: STRING -> arg_lit
    | number -> arg_num
    | field_access -> arg_field
    | var_ref -> arg_var

// ─── 模块化：import / def / call proc ─────────────────────

// import：引入外部文件的 def 定义，注册到当前命名空间
import_stmt: "import"i STRING _NL

// def：定义子过程（同文件内复用）
def_stmt: "def"i NAME "(" [def_param_list] ")" _NL (_NL | statement)* "end"i _NL
def_param_list: def_param ("," def_param)*
def_param: "$" NAME

// call proc：调用过程（本地定义或 import 引入）
// 可选 as $output 获取子过程的 output dict
call_proc_stmt: "call"i NAME "(" [call_arg_list] ")" [call_output_clause] _NL
              | "call"i "$" NAME "=" NAME "(" [call_arg_list] ")" [call_output_clause] _NL  -> call_proc_assign_stmt
call_output_clause: "as"i "$" NAME  -> call_output_as
call_arg_list: call_arg ("," call_arg)*
?call_arg: STRING -> call_arg_str
         | number -> call_arg_num
         | var_ref -> call_arg_var

// ─── 控制流 ───────────────────────────────────────────────

if_stmt: "if"i condition _NL (_NL | statement)* else_clause? "end"i _NL

else_clause: "else"i _NL (_NL | statement)*

for_stmt: "for"i NAME "in"i for_iter _NL (_NL | statement)* "end"i _NL

for_iter: for_range    -> for_iter_range
        | func_call    -> for_iter_func
        | list_literal -> for_iter_static
        | var_ref      -> for_iter_var

// 范围迭代：[start...end] 闭区间，支持数字和变量
for_range: "[" for_range_endpoint RANGE_OP for_range_endpoint "]"
for_range_endpoint: number | var_ref
RANGE_OP.2: /\.\.\./

loop_count_stmt: "loop"i (number | NAME | var_ref) _NL (_NL | statement)* "end"i _NL

loop_while_stmt: "loop"i "while"i condition _NL (_NL | statement)* "end"i _NL

loop_until_stmt: "loop"i "until"i condition _NL (_NL | statement)* "end"i _NL

break_stmt: "break"i _NL

continue_stmt: "continue"i _NL

return_stmt: "return"i [literal | arith_expr] _NL

label_stmt: "@" NAME _NL

goto_stmt: "goto"i NAME _NL

// try/catch：异常处理
// catch 后可选绑定一个变量名，接收错误消息字符串
// 控制流信号（break/return/goto）穿透 try/catch，不被捕获
try_stmt: "try"i _NL (_NL | statement)* catch_clause? "end"i _NL
catch_clause: "catch"i var_ref? _NL (_NL | statement)*

// ─── 条件表达式（优先级：or < and < not < atom）──────────

?condition: or_cond

?or_cond: and_cond -> cond_passthrough
        | or_cond "or"i and_cond -> or_op

?and_cond: not_cond
         | and_cond "and"i not_cond -> and_op

?not_cond: cond_atom -> cond_passthrough
         | "not"i cond_atom -> not_op

?cond_atom: field_access "contains"i cond_text -> contains_op
          | field_access "equals"i cond_text -> equals_op
          | field_access "in"i list_literal -> in_op
          | field_access "is_empty"i -> is_empty_op
          | arith_expr ">" arith_expr -> gt_op
          | arith_expr "<" arith_expr -> lt_op
          | arith_expr ">=" arith_expr -> ge_op
          | arith_expr "<=" arith_expr -> le_op
          | arith_expr "!=" arith_expr -> ne_op
          | arith_expr "==" arith_expr -> eq_num_op
          | var_ref "equals"i cond_text -> equals_op
          | var_ref "contains"i cond_text -> contains_op
          | var_ref "in"i list_literal -> in_op
          | var_ref "is_empty"i -> is_empty_op
          | field_access -> var_cond
          | var_ref -> var_cond

// 条件中的文本操作数：支持 "string" 或 $var
?cond_text: STRING | var_ref

// $var.field 支持链式访问：$var.f1.f2.f3
// $var.$key 支持动态字典访问（用 . 代替 Python 的 dict[] 语法）
// $var[$i] 支持列表索引访问（直接 [] 表示 index）
// $var."key" / $var.[key] 支持静态字面量访问（"" 与 [] 在非赋值语境等价）
// $var.[1] 支持数字字面量 key（整面板扫描结果按 行.列 取值）
// session.field / context.field 支持关键字作为字段访问根（KeywordRef）
field_access: field_access "." NAME -> field_chain
            | field_access "." var_ref -> field_var_chain
            | field_access "[" var_ref "]" -> field_index_chain
            | field_access "[" INT "]" -> field_bracket_chain
            | field_access "." STRING -> field_str_chain
            | field_access "." "[" NAME "]" -> field_bracket_chain
            | field_access "." "[" INT "]" -> field_bracket_chain
            | var_ref "." NAME -> field_base
            | var_ref "." var_ref -> field_var_base
            | var_ref "[" var_ref "]" -> field_index_base
            | var_ref "[" INT "]" -> field_bracket_base
            | var_ref "." STRING -> field_str_base
            | var_ref "." "[" NAME "]" -> field_bracket_base
            | var_ref "." "[" INT "]" -> field_bracket_base
            | keyword_ref "." NAME -> kw_field_base
            | keyword_ref "." var_ref -> kw_field_var_base
            | keyword_ref "." STRING -> kw_field_str_base
            | keyword_ref "." "[" NAME "]" -> kw_field_bracket_base
            | field_access "." keyword_ref -> field_kw_chain

// DSL 关键字引用：session / context（持久/临时状态入口）
keyword_ref: "session" -> session_ref
           | "context" -> context_ref

// 算术表达式（优先级：+ - < * /，支持 () 分组）
// factor 包含所有原子表达式：数字、变量、字段访问、函数调用、括号分组
?arith_expr: arith_expr "+" term -> arith_add
           | arith_expr "-" term -> arith_sub
           | term

?term: term "*" factor -> arith_mul
     | term "/" factor -> arith_div
     | factor

?factor: number
       | STRING -> string_atom
       | var_ref
       | field_access
       | func_call
       | "(" arith_expr ")"

// 数值字面量：支持负数，统一为 number（float）
?number: FLOAT -> number_float
       | INT -> number_int
       | "-" FLOAT -> number_neg_float
       | "-" INT -> number_neg_int

// 任意字面量（用于 eval 赋值右侧）
?literal: STRING
        | number
        | "null"i -> null_literal
        | "true"i -> true_literal
        | "false"i -> false_literal
        | dict_literal
        | list_literal
        | range_literal

// 范围字面量：(min, max) 用于 wait 随机等待
range_literal: "(" number "," number ")"

// 列表字面量：["a", "b", 1, 2]，支持字符串、数字和变量引用
list_literal: "[" [list_item ("," list_item)*] "]"

?list_item: STRING -> list_item_str
          | number -> list_item_num
          | "null"i -> list_item_null
          | "true"i -> list_item_true
          | "false"i -> list_item_false
          | var_ref -> list_item_var
          | dict_literal -> list_item_dict
          | list_literal -> list_item_list

// 字典字面量：{"key": "value", "key2": $var, "nested": {"a": 1}, "list": [1, 2]}
// key 限定字符串，value 支持字符串、数字、变量引用、嵌套字典、列表
dict_literal: "{" [dict_pair ("," dict_pair)*] "}"

dict_pair: STRING ":" dict_value

?dict_value: STRING -> dict_val_str
           | number -> dict_val_num
           | "null"i -> dict_val_null
           | "true"i -> dict_val_true
           | "false"i -> dict_val_false
           | var_ref -> dict_val_var
           | dict_literal -> dict_val_dict
           | list_literal -> dict_val_list

// ─── 通用原子 ─────────────────────────────────────────────

var_ref: "$" NAME

bracket_expr: "[" NAME "]"

// 逗号分隔列表：用于 for 迭代源和 in 条件
// 元素可以是裸 NAME 或 "字符串"，统一视为字面量
bracket_list: "[" [bracket_item ("," bracket_item)*] "]"

?bracket_item: NAME | STRING | number

field_list: "." "[" NAME ("," NAME)* "]"

// ─── 词法 ─────────────────────────────────────────────────

STRING: "\"" /[^"\n]*/ "\""
NAME: /[a-zA-Z_\u4e00-\u9fff][a-zA-Z0-9_\u4e00-\u9fff]*/
FLOAT: /[0-9]+\.[0-9]+/
INT: /[0-9]+/

COMMENT: /#[^\n]*\n?/
_NL: /(\s*\n)+/

%ignore COMMENT
%ignore /[ \t]+/
