# 在调律页材料格中逐个寻找指定材料（early return 优化）
# with: $target_material — 目标材料名称
# return: collect $found as "position" — 找到的坐标（空则未找到）

recognize [equip_tune_detail].[material_1] as $m1
find $m1 $target_material as $p1
if $p1
    collect $p1 as "position"
    return
end

recognize [equip_tune_detail].[material_2] as $m2
find $m2 $target_material as $p2
if $p2
    collect $p2 as "position"
    return
end

recognize [equip_tune_detail].[material_3] as $m3
find $m3 $target_material as $p3
if $p3
    collect $p3 as "position"
    return
end

recognize [equip_tune_detail].[material_4] as $m4
find $m4 $target_material as $p4
if $p4
    collect $p4 as "position"
    return
end

recognize [equip_tune_detail].[material_5] as $m5
find $m5 $target_material as $p5
if $p5
    collect $p5 as "position"
    return
end

recognize [equip_tune_detail].[material_6] as $m6
find $m6 $target_material as $p6
if $p6
    collect $p6 as "position"
    return
end

recognize [equip_tune_detail].[material_7] as $m7
find $m7 $target_material as $p7
if $p7
    collect $p7 as "position"
    return
end

log "材料格中未找到目标材料"
