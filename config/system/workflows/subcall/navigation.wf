#% name: 导航子过程集合

# 通用导航子过程库
# 提供页面间导航的原子操作，供各工作流 import 后调用。
#
# 包含过程：
#   nav_main_to_equip()  — 主界面 → 背包装备页
#   nav_back_to_main()   — 背包装备页 → 主界面
#   nav_equip_to_tune()  — 装备详情页 → 调律页

# ─── nav_main_to_equip ────────────────────────────────────
# 从主界面导航到装备培养页面
# 路径：主界面 → 菜单 → 包裹 → 培养（如不在装备页则自动切换）
# 前置：在主界面或菜单页
# 后置：在背包装备页（bag_equip_detail）

def nav_main_to_equip()
    # 检查当前是否在菜单页
    scan [game_menu_page].[wulinlu] as $result
    if not $result.[wulinlu] equals "武林录"
        # 不在菜单页，从主界面进入菜单
        click [game_main_page].[menu] after wait @page_refresh
    else
        log "当前已在菜单页"
    end

    # 菜单页 → 背包页
    click [game_menu_page].[baoguo] after wait @page_refresh

    # 检查是否在装备页（可能开包裹后在道具页等其他页面）
    scan [bag_equip_detail].[sub_equip] as $bag_scan
    if not $bag_scan.sub_equip contains "装备"
        # 不在装备页，点击培养切换
        click [bag_equip_detail].[peiyang] after wait @page_refresh
    end
end

# ─── nav_back_to_main ─────────────────────────────────────
# 从装备详情弹窗返回主界面
# 路径：详情弹窗 → 背包页 → 菜单页 → 主界面
# 前置：在背包页且装备详情弹窗已打开（bag_equip_detail 场景内）
# 后置：在主界面
# 注意：详情弹窗是覆盖在背包页上的隐形弹窗，需先关闭再逐层返回

def nav_back_to_main()
    # 关闭详情弹窗 → 背包页
    click [bag_equip_detail].[back] after wait @page_refresh
    # 背包页 → 菜单页
    click [bag_equip_detail].[back] after wait @page_refresh
    # 菜单页 → 主界面
    click [game_menu_page].[back] after wait @page_refresh
end

# ─── nav_equip_to_tune ────────────────────────────────────
# 从装备详情页进入调律页面
# 前置：在装备详情页（equip_detail）
# 后置（成功）：在调律详情页（equip_tune_detail）
# 后置（失败）：仍在装备详情页，弹窗已收起

def nav_equip_to_tune()
    # 展开「更多」弹窗
    click [equip_detail].[more_func] after wait @page_refresh

    # 在次功能按钮中寻找「调律」
    scan [equip_detail].[sub_func_1, sub_func_2, sub_func_3, sub_func_4] as $tune_key by contains "调律"

    if not $tune_key
        log "未找到调律按钮"
        # 再次点击 more_func 收起弹窗，保持页面干净
        click [equip_detail].[more_func] after wait @step_interval
        return -1
    end

    # 点击调律按钮，进入调律页
    click [equip_detail].$tune_key after wait @page_refresh
end
