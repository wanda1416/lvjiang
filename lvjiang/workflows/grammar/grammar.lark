// 工作流 DSL v2 - Lark 语法文件
//
// 关键约定：
// - [name] / [name].[name] → 静态配置引用（场景名/区域名），来自 yaml
// - $name → 运行时变量引用，来自 variables dict
// - 两者在语法层面完全不交叉，无歧义

start: (_NL | statement)*

// ─── 语句分派 ─────────────────────────────────────────────

?statement: click_stmt
          | drag_stmt
          | wait_stmt
          | scan_stmt
          | recognize_stmt
          | collect_stmt
          | log_stmt
          | eval_stmt
          | implicit_eval_stmt
          | default_stmt
          | calibrate_stmt
          | call_stmt
          | if_stmt
          | for_stmt
          | loop_stmt
          | break_stmt
          | return_stmt
          | label_stmt
          | goto_stmt

// ─── 基础指令 ─────────────────────────────────────────────

// calibrate：触发 panel 区域截图 + 图像自校准，缓存格子坐标
// 语法：calibrate [scene].[panel]
calibrate_stmt: "calibrate"i bracket_expr "." bracket_expr _NL

// click 支持三种目标：
//   1. [scene].[panel][row][col] — panel 三级索引（点击格子中心）
//   2. [scene].[region] / $var.[region] / ... — scene.area 引用
//   3. (rx, ry) — 画布归一化坐标点
//
// 注意：panel 与 scene.area 都以 [x].[y] 开头，必须用同一规则避免歧义。
// transformer 根据 row/col 是否存在分派为 SceneRef 或 PanelRef。
click_stmt: "click"i click_target _NL
click_target: const_or_var "." const_or_var panel_index panel_index -> click_panel_target
            | const_or_var "." const_or_var                          -> click_scene_target
            | coord_point                                             -> click_coord_target

// drag 支持三种目标：
//   1. [scene].[panel][row][col] [up|down [n]] — panel 三级索引 + 可选方向距离
//   2. scene.arrow — scene.arrow 引用
//   3. (rx1, ry1) (rx2, ry2) — 两坐标点
drag_stmt: "drag"i drag_target drag_duration? drag_hold? _NL
drag_target: const_or_var "." const_or_var panel_index panel_index drag_direction? -> drag_panel_target
           | const_or_var "." const_or_var                          -> drag_scene_target
           | coord_point coord_point                                -> drag_coord_target

// panel 拖拽方向：up/down/left/right + 可选距离（默认 1，支持数值或变量）
// up/down 按行计算，left/right 按列计算
// 使用 DRAG_DIST 终端避免与 drag_duration 的 number 冲突
// 优先级 .2 确保在 drag_direction 上下文中优先匹配
drag_direction: DRAG_DIR DRAG_DIST?
DRAG_DIR: /up/i | /down/i | /left/i | /right/i
DRAG_DIST.2: /[0-9]+/ | /\$[a-zA-Z_][a-zA-Z0-9_]*/

// panel 索引：[数字] 或 [$var]，显式包含括号以避免与 bracket_list 歧义
panel_index: "[" INT "]" -> panel_index_int
           | "[" var_ref "]" -> panel_index_var

// 画布归一化坐标点：(rx, ry)，rx/ry ∈ [0,1]
coord_point: "(" number "," number ")"

// 常量或变量：scene/region/arrow 都支持三种形式
?const_or_var: bracket_expr    // [name] — 括号常量
            | STRING            // "name" — 字符串常量
            | var_ref           // $var — 变量引用

drag_duration: number | bracket_list

drag_hold: "hold"i number

wait_stmt: "wait"i (NAME | number | bracket_expr | var_ref | wait_range) _NL

wait_range: "(" number "," number ")"

scan_stmt: "scan"i scene_target "as"i var_ref by_clause? _NL

recognize_stmt: "recognize"i scene_target "as"i var_ref by_clause? group_clause? _NL

// by 子句：短路识别模式
// 有 by 时返回首个命中的字段名（str），无 by 时返回完整 dict
// match_mode 顺序：长关键字在前，确保词法 max-munch 正确分词
by_clause: "by"i match_mode by_target
match_mode: "equals_any"i -> match_equals_any
          | "contains_any"i -> match_contains_any
          | "equals"i -> match_equals
          | "contains"i -> match_contains
?by_target: STRING | var_ref

// group 子句：限定材料识别的分组范围
group_clause: "on"i "group"i (STRING | var_ref)

// 场景目标：支持静态/动态场景名 + 静态/动态字段
// 场景名：[scene] / "scene" / $var
// 字段：.[field] / .$var / .[f1,f2] / 无字段
scene_target: scene_name "." var_ref         -> scene_target_dyn
            | scene_name field_list?         -> scene_target_static

?scene_name: bracket_expr | STRING | var_ref

collect_stmt: "collect"i collect_source collect_as_clause? _NL

// collect 源：变量引用、字段访问、或字面量（数字/字符串）
?collect_source: var_ref | field_access | literal

// collect as 支持字符串常量或变量
collect_as_clause: "as"i (STRING | var_ref)

log_stmt: "log"i log_arg _NL

// log 参数：任何能求值为字符串的表达式
?log_arg: STRING | func_call | var_ref | field_access

eval_stmt: "eval"i "$" NAME "=" NAME "(" arg_list? ")" _NL    -> eval_assign_func
         | "eval"i "$" NAME "=" literal _NL                    -> eval_assign_lit
         | "eval"i "$" NAME "=" field_access _NL               -> eval_assign_expr
         | "eval"i "$" NAME "=" var_ref _NL                    -> eval_assign_expr
         | "eval"i field_access "=" eval_rhs _NL               -> eval_field_assign
         | "eval"i NAME "(" arg_list? ")" _NL                  -> eval_discard

// 隐式 eval：省略 eval 关键字，直接 $var = ...
implicit_eval_stmt: "$" NAME "=" NAME "(" arg_list? ")" _NL    -> implicit_eval_assign_func
                  | "$" NAME "=" literal _NL                    -> implicit_eval_assign_lit
                  | "$" NAME "=" field_access _NL               -> implicit_eval_assign_expr
                  | "$" NAME "=" var_ref _NL                    -> implicit_eval_assign_expr
                  | field_access "=" eval_rhs _NL               -> implicit_eval_field_assign

eval_rhs: NAME "(" arg_list? ")"  -> eval_rhs_func
        | literal                   -> eval_rhs_lit
        | field_access              -> eval_rhs_field
        | var_ref                   -> eval_rhs_var

// 默认值赋值：仅当变量未从外部传入时才赋值
default_stmt: "default"i "$" NAME "=" literal _NL

func_call: NAME "(" arg_list? ")"

arg_list: arg ("," arg)*

?arg: STRING -> arg_lit
    | number -> arg_num
    | field_access -> arg_field
    | var_ref -> arg_var

// ─── 子工作流调用 ──────────────────────────────────────────

call_stmt: "call"i STRING call_with_clause? call_read_clause? _NL

call_with_clause: "with"i as_var ("," as_var)*

call_read_clause: "read"i as_var ("," as_var)*

// 对称结构：两侧均支持 $var 或 "string"
as_var: as_side "as"i as_side

?as_side: var_ref | STRING

// ─── 控制流 ───────────────────────────────────────────────

if_stmt: "if"i condition _NL statement* else_clause? "end"i _NL

else_clause: "else"i _NL statement*

for_stmt: "for"i NAME "in"i for_iter _NL statement* "end"i _NL

for_iter: for_range    -> for_iter_range
        | func_call    -> for_iter_func
        | list_literal -> for_iter_static
        | var_ref      -> for_iter_var

// 范围迭代：[start...end] 闭区间，支持数字和变量
for_range: "[" for_range_endpoint RANGE_OP for_range_endpoint "]"
for_range_endpoint: number | var_ref
RANGE_OP.2: /\.\.\./

loop_stmt: "loop"i (number | NAME | var_ref) _NL statement* "end"i _NL

break_stmt: "break"i _NL

return_stmt: "return"i _NL

label_stmt: "@" NAME _NL

goto_stmt: "goto"i NAME _NL

// ─── 条件表达式（优先级：or < and < not < atom）──────────

?condition: or_cond

?or_cond: and_cond -> cond_passthrough
        | or_cond "or"i and_cond -> or_op

?and_cond: not_cond
         | and_cond "and"i not_cond -> and_op

?not_cond: cond_atom -> cond_passthrough
         | "not"i cond_atom -> not_op

?cond_atom: field_access "contains"i cond_text -> contains_op
          | field_access "equals"i cond_text -> equals_op
          | field_access "in"i list_literal -> in_op
          | var_ref "equals"i cond_text -> equals_op
          | var_ref "contains"i cond_text -> contains_op
          | var_ref "in"i list_literal -> in_op
          | var_ref "is_empty"i -> is_empty_op
          | field_access "is_empty"i -> is_empty_op
          | field_access ">" number -> gt_op
          | field_access "<" number -> lt_op
          | field_access ">=" number -> ge_op
          | field_access "<=" number -> le_op
          | field_access "!=" number -> ne_op
          | field_access "==" number -> eq_num_op
          | var_ref ">" number -> gt_op
          | var_ref "<" number -> lt_op
          | var_ref ">=" number -> ge_op
          | var_ref "<=" number -> le_op
          | var_ref "!=" number -> ne_op
          | var_ref "==" number -> eq_num_op
          | var_ref -> var_cond

// 条件中的文本操作数：支持 "string" 或 $var
?cond_text: STRING | var_ref

// $var.field 支持链式访问：$var.f1.f2.f3
// $var.$key 支持动态字典访问（用 . 代替 Python 的 dict[] 语法）
// $var[$i] 支持列表索引访问（直接 [] 表示 index）
// $var."key" / $var.[key] 支持静态字面量访问（"" 与 [] 在非赋值语境等价）
// session.field / context.field 支持关键字作为字段访问根（KeywordRef）
field_access: field_access "." NAME -> field_chain
            | field_access "." var_ref -> field_var_chain
            | field_access "[" var_ref "]" -> field_index_chain
            | field_access "." STRING -> field_str_chain
            | field_access "." "[" NAME "]" -> field_bracket_chain
            | var_ref "." NAME -> field_base
            | var_ref "." var_ref -> field_var_base
            | var_ref "[" var_ref "]" -> field_index_base
            | var_ref "." STRING -> field_str_base
            | var_ref "." "[" NAME "]" -> field_bracket_base
            | keyword_ref "." NAME -> kw_field_base
            | keyword_ref "." var_ref -> kw_field_var_base
            | keyword_ref "." STRING -> kw_field_str_base
            | keyword_ref "." "[" NAME "]" -> kw_field_bracket_base
            | field_access "." keyword_ref -> field_kw_chain

// DSL 关键字引用：session / context（持久/临时状态入口）
keyword_ref: "session" -> session_ref
           | "context" -> context_ref

// 数值字面量：支持负数，统一为 number（float）
?number: FLOAT -> number_float
       | INT -> number_int
       | "-" FLOAT -> number_neg_float
       | "-" INT -> number_neg_int

// 任意字面量（用于 eval 赋值右侧）
?literal: STRING
        | number
        | "{" "}" -> empty_dict
        | list_literal
        | range_literal

// 范围字面量：(min, max) 用于 wait 随机等待
range_literal: "(" number "," number ")"

// 列表字面量：["a", "b", 1, 2]，支持字符串、数字和变量引用
list_literal: "[" [list_item ("," list_item)*] "]"

?list_item: STRING -> list_item_str
          | number -> list_item_num
          | var_ref -> list_item_var

// ─── 通用原子 ─────────────────────────────────────────────

var_ref: "$" NAME

bracket_expr: "[" NAME "]"

// 逗号分隔列表：用于 for 迭代源和 in 条件
// 元素可以是裸 NAME 或 "字符串"，统一视为字面量
bracket_list: "[" [bracket_item ("," bracket_item)*] "]"

?bracket_item: NAME | STRING | number

field_list: "." "[" NAME ("," NAME)* "]"

// ─── 词法 ─────────────────────────────────────────────────

STRING: "\"" /[^"\n]*/ "\""
NAME: /[a-zA-Z_\u4e00-\u9fff][a-zA-Z0-9_\u4e00-\u9fff]*/
FLOAT: /[0-9]+\.[0-9]+/
INT: /[0-9]+/

COMMENT: /#[^\n]*\n?/
_NL: /(\s*\n)+/

%ignore COMMENT
%ignore /[ \t]+/
