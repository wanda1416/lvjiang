#% name: 指定方案基础属性扫描

# 进入角色详情页采集基础属性，并按模式写入指定备战方案或弹出面板交人工确认。
# 依赖 navigation.wf 的导航；面板文本解析与属性反推由 Python 侧完成。
#
# 包含过程：
#   scan_role_base_attr_for_plan — 进角色页扫描并写入/弹面板（返回结果或状态码）
#   capture_role_base_attrs      — 滚动采集属性面板原始文本（内部过程）

import "subcall/navigation.wf"

# ─── scan_role_base_attr_for_plan ─────────────────────────
# 进入角色详情页采集基础属性，按模式写入方案或弹出创建面板。
#
# 参数：
#   $name、$main_art、$sub_art — 目标方案与两门武学（静默模式下作为写入目标）
#   $silent_write — true=自动写入方案；false=弹面板交人工确认
#   $scroll_count — 属性列表向下滚动的轮数
# 前置：在主页（内部走 nav_main_to_role 进角色页）。
# 后置：弹窗模式成功时停在角色页供确认；静默模式成功或失败后都回主页
#       （回不到主页时返回 -1）。
# 返回："dialog"=已弹面板待确认；$saved_name=静默写入成功；-2=识别或写入失败
#       但已回主页；-1=导航或页面不安全。
def scan_role_base_attr_for_plan($name, $main_art, $sub_art, $silent_write, $scroll_count)
    call $nav_result = nav_main_to_role()
    if $nav_result < 0
        log error "无法进入角色详情页，终止"
        return -1
    end
    eval $scan_error = ""
    eval $saved_name = ""
    try
        call $parsed = capture_role_base_attrs($scroll_count)
        if not $parsed
            eval $scan_error = "基础属性识别为空"
        else if not $silent_write
            eval open_base_attr_form($parsed)
            log info "基础属性识别完成，已弹出创建面板供确认"
            return "dialog"
        else
            eval bind_scanned_loadout($name, $main_art, $sub_art)
            eval $saved_name = save_scanned_base_attrs($parsed)
        end
    catch $err
        eval $scan_error = $err
    end
    if not $silent_write
        log error "自动写基础属性失败，请用户手动新建属性: " + $scan_error
        return -1
    end
    click [role_detail].[back] after wait @page_refresh
    click [game_menu_page].[back] after wait @page_refresh
    # 菜单第二页没有“包裹/培养”；背景的“限时”也不能单独证明已回主页。
    scan [general_control].[back] as $remaining_back by image
    if $remaining_back
        screenshot from last
        log error "退出角色页后仍检测到返回按钮，未确认已回主页"
        return -1
    end
    call $in_main = is_in_main_page()
    if not $in_main
        screenshot from last
        log error "退出角色页后未识别到主页"
        return -1
    end
    if $scan_error
        log error "自动写基础属性失败，请用户手动新建属性: " + $name + "；" + $scan_error
        return -2
    end
    log info "基础属性识别并写入: " + $saved_name
    return $saved_name
end

# ─── capture_role_base_attrs ──────────────────────────────
# 滚动采集角色属性面板的原始文本，并解析成结构化属性（不做 UI 与存储写入）。
#
# 参数：
#   $scroll_count — 向下滚动的轮数上限
# 前置：角色详情页。
# 后置：页面停在最后一次滚动位置；不改写任何配置或 profile。
# 返回：结构化属性字典，另带 _right_*_valid 校验位（右区四段详情是否完整）。
#
# 连续两次识别到相同内容即认为已到列表底部并提前结束。
# 四段右区详情独立解析和校验；左区的汇总值不能替代右区的基础/分流派数值。
# 属性攻击至少要识别一门流派的完整区间；仅识别无相攻击不算成功。
def capture_role_base_attrs($scroll_count)
    eval $data = {}
    eval $got_outer_attack = false
    eval $got_attr_attack = false
    eval $got_outer_pen = false
    eval $got_attr_pen = false
    eval $previous = ""
    eval $i = 1

    loop while $i <= $scroll_count
        scan [role_detail].[detail_1] as $r1
        eval $current = $r1.detail_1
        if len($current) > 0 and $current == $previous
            log info "角色属性列表连续两次识别相同，结束滚动扫描"
            break
        end
        eval $key = "left_" + $i
        eval $data.$key = $current
        eval $previous = $current
        if not $got_outer_attack
            find [role_detail].[detail_1] as $f by contains "外功攻击"
            if $f
                click $f after wait stable @page_refresh
                scan [role_detail].[detail_2] as $r2
                eval $data.right_outer_attack = $r2.detail_2
                eval $got_outer_attack = true
            end
        end
        if not $got_attr_attack
            find [role_detail].[detail_1] as $f by contains "属性攻击"
            if $f
                click $f after wait stable @page_refresh
                scan [role_detail].[detail_2] as $r2
                eval $data.right_attr_attack = $r2.detail_2
                eval $got_attr_attack = true
            end
        end
        if not $got_outer_pen
            find [role_detail].[detail_1] as $f by contains "外功穿透"
            if $f
                click $f after wait stable @page_refresh
                scan [role_detail].[detail_2] as $r2
                eval $data.right_outer_pen = $r2.detail_2
                eval $got_outer_pen = true
            end
        end
        if not $got_attr_pen
            find [role_detail].[detail_1] as $f by contains "属攻穿透"
            if $f
                click $f after wait stable @page_refresh
                scan [role_detail].[detail_2] as $r2
                eval $data.right_attr_pen = $r2.detail_2
                eval $got_attr_pen = true
            end
        end

        if $i < $scroll_count
            $is_post = is_post()
            if $is_post
                scroll [role_detail].[detail_1] down 2 interval 0.1
            else
                drag [role_detail].[detail_1] up 0.5
            end
            wait stable @scroll_settle
        end
        eval $i = $i + 1
    end
    # 四段右区详情独立解析和校验；左区的汇总值不能替代右区的基础/分流派数值。
    # 属性攻击至少要识别一门流派的完整区间；仅识别无相攻击不算成功。
    eval $parsed = to_role_base_attrs($data)
    eval $outer_detail = to_role_base_attrs({"right_outer_attack": $data.right_outer_attack})
    eval $attr_attack_detail = to_role_base_attrs({"right_attr_attack": $data.right_attr_attack})
    eval $outer_pen_detail = to_role_base_attrs({"right_outer_pen": $data.right_outer_pen})
    eval $attr_pen_detail = to_role_base_attrs({"right_attr_pen": $data.right_attr_pen})
    eval $parsed._right_outer_valid = has_key($outer_detail, "min_outer") and has_key($outer_detail, "max_outer")
    eval $parsed._right_attr_attack_valid = (has_key($attr_attack_detail, "min_mingjin") and has_key($attr_attack_detail, "max_mingjin")) or (has_key($attr_attack_detail, "min_lieshi") and has_key($attr_attack_detail, "max_lieshi")) or (has_key($attr_attack_detail, "min_qiansi") and has_key($attr_attack_detail, "max_qiansi")) or (has_key($attr_attack_detail, "min_pozhu") and has_key($attr_attack_detail, "max_pozhu"))
    eval $parsed._right_outer_pen_valid = has_key($outer_pen_detail, "outer_pen")
    eval $parsed._right_attr_pen_valid = len(keys($attr_pen_detail)) > 0
    return $parsed
end
