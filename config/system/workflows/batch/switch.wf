# 批处理切换：退出游戏 → 比对 account → 决定流程
# 由 Runner 在后续行调用，变量由 Runner 注入

import "_exit_to_login.wf"
import "_switch_account.wf"
import "_select_role.wf"

# 1. 退出到登录页
call _exit_to_login()

# 2. 比对当前行与上一行的 account（游戏账号）
# 同账号 → 只需选角色；不同账号 → 需要切换账号重新登录
# batch_table 和 batch_index 由 Runner 注入
eval $prev_index = $batch_index - 1
eval $prev_account = ""
if $prev_index >= 0
    # 获取上一行的 account
    eval $prev_row = $batch_table[$prev_index]
    eval $prev_account = $prev_row.account
end

log "当前账号：" + $account
log "上次账号：" + $prev_account

# 3. 根据比对结果决定流程
if $prev_account equals $account
    # 同账号：直接选角色
    log "同账号切换，直接选角色: " + $role
    call _select_role($role_index)
else
    # 不同账号：选账号 + 登录 + 选角色
    log "不同账号切换，重新登录: " + $role
    call _switch_account($tail, $role_index)
end
