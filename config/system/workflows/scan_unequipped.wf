#% id: scan_unequipped
#% name: 扫描全部装备
#% runnable: true
#% batchable: true
#% env: [android, desktop]
#% parameters:
#%   - name: slots
#%     label: 扫描部位
#%     type: checkgroup
#%     default:
#%       weapon: true
#%       ring: true
#%       pendant: true
#%       head: true
#%       chest: true
#%       leg: true
#%       wrist: true
#%     options:
#%       - { value: weapon, label: 武器 }
#%       - { value: ring, label: 环 }
#%       - { value: pendant, label: 佩 }
#%       - { value: head, label: 冠胄 }
#%       - { value: chest, label: 胸甲 }
#%       - { value: leg, label: 胫甲 }
#%       - { value: wrist, label: 腕甲 }
#%   - name: min_level
#%     label: 装备最小等级
#%     type: number
#%     default: 110
#%   - name: min_affix_count
#%     label: 最少词条数
#%     type: number
#%     default: 0
#%     min: 0
#%     max: 5

# 对应槽位背包装备全量扫描。
# 主副武器共用武器背包，只通过 main_weapon 扫描一次；环、佩使用
# 武器详情字段，四件防具使用防具详情字段。指纹按业务约定唯一，
# 行首装备指纹用于判断该物理行是否读过；装备指纹作为
# 公共装备池的装备 key。已读行只读第一列锚点，不再重复
# 点击和 OCR 第 2～6 列。背包装备按等级倒序排列，首次读到低于
# min_level 的装备后立即结束当前槽位扫描。
# min_affix_count=0 表示不过滤；1～5 表示词条不足的装备仍参与扫描去重，
# 但不写入装备库。定音不计入普通词条数量。
#
# 参数：
#   slots           — 要扫描的部位（checkgroup，键为槽位 key）
#   min_level       — 最低等级；低于它的装备触发当前槽位截断
#   min_affix_count — 最少词条数，0 表示不过滤
# 前置：在主页（内部走 nav_main_to_equip 进背包装备列表）。
# 后置：成功时已回到主页，命中的装备已写入公共装备池。
# 返回：-1=导航失败或未能回到主页；否则正常结束。

default $min_level = 110
default $min_affix_count = 0

import "subcall/navigation.wf"
import "subcall/loadout/equipment_scan.wf"

call $nav_result = nav_main_to_equip()
if $nav_result < 0
    return -1
end

if $slots.weapon
    call scan_slot_bag("main_weapon", "weapon", "weapon", $min_level, $min_affix_count)
end
if $slots.ring
    call scan_slot_bag("ring", "ring", "weapon", $min_level, $min_affix_count)
end
if $slots.pendant
    call scan_slot_bag("pendant", "pendant", "weapon", $min_level, $min_affix_count)
end
if $slots.head
    call scan_slot_bag("head", "head", "armor", $min_level, $min_affix_count)
end
if $slots.chest
    call scan_slot_bag("chest", "chest", "armor", $min_level, $min_affix_count)
end
if $slots.leg
    call scan_slot_bag("leg", "leg", "armor", $min_level, $min_affix_count)
end
if $slots.wrist
    call scan_slot_bag("wrist", "wrist", "armor", $min_level, $min_affix_count)
end

call $nav_result = nav_back_to_main()
if $nav_result < 0
    return -1
end


# ─── scan_slot_bag ────────────────────────────────────────
# 扫描一个部位的整个背包窗口，逐窗口写到装备池。
#
# 参数：
#   $slot            — 穿戴槽位 key（点击它把右侧背包过滤到该部位）
#   $group           — 装备池分组名（weapon / armor）
#   $detail_kind     — 详情场景种类（"weapon" / "armor"，决定用哪套详情字段）
#   $min_level       — 最低等级，低于它触发当前槽位截断
#   $min_affix_count — 最少词条数，0 表示不过滤
# 前置：在背包装备列表页。
# 后置：本部位窗口全部扫完并写入；桌面端不遗留详情层。
# 返回：无返回值（隐式 null）；失败只体现在装备池内容与日志里。
def scan_slot_bag($slot, $group, $detail_kind, $min_level, $min_affix_count)
    log "═══ 开始扫描部位: " + $group + " (detail=" + $detail_kind + ", min_level=" + $min_level + ", min_affix_count=" + $min_affix_count + ") ═══"
    # 点击穿戴槽位会把右侧背包过滤到对应部位并回到该列表顶部。
    click [bag_equip_detail].$slot after wait @step_interval
    eval bag_cursor_init()
    eval $items = {}
    eval $signal = ""
    eval $total_count = 0
    eval $filtered_count = 0
    eval $window_idx = 0
    call $slot_cell = scan_cell($detail_kind)
    eval $slot_equip = $slot_cell.equip
    eval $slot_type = $slot_equip.type
    # 穿戴槽位可能为空；按实际扫描到的详情内容记录界面状态。
    eval $detail_open = $slot_cell.detail_open
    eval mark_equipment_seen($slot_equip)

    loop while 1 == 1
        align [bag_equip_detail].[bag_grid]
        eval $rows = panel_rows("bag_equip_detail", "bag_grid")
        eval $cols = panel_cols("bag_equip_detail", "bag_grid")
        eval $hit_confirmed_empty = 0
        eval $window_idx = $window_idx + 1
        log "[窗口 " + $window_idx + "] 部位 " + $group + ": 检测到 " + $rows + " 行 × " + $cols + " 列"

        if $rows <= 0
            log "  未检测到背包行，结束扫描"
            break
        end

        eval $r = 1
        loop while $r <= $rows
            # 第一列是物理行锚点。锚点已见过意味着整行此前已完整读取，
            # 直接跳过剩余列；只有新行才扫描第 2～末列。
            # 桌面端详情功能区只会遮挡第一列；第 2～末列可保持详情打开连续扫描。
            if env("desktop")
                if $detail_open
                    press "ESC" after wait @page_refresh
                    eval $detail_open = 0
                end
            end
            click [bag_equip_detail].[bag_grid][$r][1] after wait @step_interval
            call $cell = scan_cell($detail_kind)
            eval $equip = $cell.equip
            eval $detail_open = $cell.detail_open
            # type 为空 → equip_type OCR 失败，当前槽位结束
            if not $equip.type
                # 只有用于判定详情的关键字段均为空才确认空槽；背景聊天等 OCR 噪声
                # 会让 detail_open 保持为 1，不参与提前截断。
                if not $detail_open
                    eval $hit_confirmed_empty = 1
                end
                log error "  [" + $r + ",1] equip_type OCR 失败，槽位结束"
                break
            end
            eval $fp = make_fingerprint($equip)
            eval $signal = bag_cursor_visit($fp)
            log "  [" + $r + ",1] " + $equip.type + " Lv" + $equip.level + " fp=" + $fp + " → " + $signal

            if $signal == "end"
                log "  锚点已见过，结束当前窗口"
                break
            end

            if $signal == "new"
                if $equip.level < $min_level
                    eval mark_equipment_seen($equip)
                    if $group == "weapon" and $equip.type == $slot_type
                        log "  同类型低等级，跳过到下一行"
                    else
                        log "  等级 " + $equip.level + " < " + $min_level + "，等级截止"
                        eval $signal = "level_end"
                        break
                    end
                else
                    eval $items.$fp = $equip
                    if $min_affix_count <= 0 or $equip._extra.affix_count >= $min_affix_count
                        eval write_bag_item($group, $equip)
                        eval $total_count = $total_count + 1
                    else
                        eval mark_equipment_seen($equip)
                        eval $filtered_count = $filtered_count + 1
                        log "  [" + $r + ",1] 词条 " + $equip._extra.affix_count + " < " + $min_affix_count + "，不写入"
                    end

                    eval $c = 2
                    loop while $c <= $cols
                        click [bag_equip_detail].[bag_grid][$r][$c] after wait @step_interval
                        call $cell = scan_cell($detail_kind)
                        eval $equip = $cell.equip
                        # 点击空槽会关闭原详情，必须在下一行首列判断前同步状态。
                        eval $detail_open = $cell.detail_open
                        # type 为空 → equip_type OCR 失败，结束本行
                        if not $equip.type
                            if not $detail_open
                                eval $hit_confirmed_empty = 1
                            end
                            log warn "    [" + $r + "," + $c + "] equip_type OCR 失败，结束本行"
                            break
                        end
                        eval $fp = make_fingerprint($equip)
                        log "    [" + $r + "," + $c + "] " + $equip.type + " Lv" + $equip.level + " fp=" + $fp

                        if not $fp
                            log "    指纹为空，空白格，结束本行"
                            break
                        end
                        # 指纹已存在于本槽位 → 点击落到了空白格（详情页未刷新），结束本行
                        if $items.$fp
                            log "    指纹已存在，空白格残留数据，结束本行"
                            break
                        end
                        if $equip.level < $min_level
                            eval mark_equipment_seen($equip)
                            if $group == "weapon" and $equip.type == $slot_type
                                log "    同类型低等级，跳过到下一行"
                                break
                            else
                                log "    等级 " + $equip.level + " < " + $min_level + "，等级截止"
                                eval $signal = "level_end"
                                break
                            end
                        end
                        eval $items.$fp = $equip
                        if $min_affix_count <= 0 or $equip._extra.affix_count >= $min_affix_count
                            eval write_bag_item($group, $equip)
                            eval $total_count = $total_count + 1
                        else
                            eval mark_equipment_seen($equip)
                            eval $filtered_count = $filtered_count + 1
                            log "    [" + $r + "," + $c + "] 词条 " + $equip._extra.affix_count + " < " + $min_affix_count + "，不写入"
                        end
                        eval $c = $c + 1
                    end
                end
            end

            if $signal == "end" or $signal == "level_end"
                break
            end
            eval $r = $r + 1
        end

        if $signal == "end" or $signal == "level_end"
            break
        end

        eval $signal = bag_cursor_finish_window(
            $rows, $rows, $hit_confirmed_empty)
        if $signal == "end"
            log "  已到达背包末尾"
            break
        end

        log "  滚动到下一窗口 (已收集 " + $total_count + " 件)"
        drag [bag_equip_detail].[bag_grid] up
        wait stable @scroll_settle
    end

    # 保证离开当前部位时不遗留详情层；空槽不会触发这次 ESC。
    if env("desktop")
        if $detail_open
            press "ESC" after wait @page_refresh
            eval $detail_open = 0
        end
    end

    log "═══ 部位 " + $group + " 扫描完成，写入 " + $total_count + " 件，过滤 " + $filtered_count + " 件 ═══"
end

# ─── scan_cell ────────────────────────────────────────────
# 扫描当前格子并解析装备，同时判断详情层是否仍然打开（内部过程）。
#
# 参数：
#   $detail_kind — 详情场景种类（"weapon" / "armor"）
# 前置：已点开一个装备格子的详情（也可能点到空槽）。
# 后置：无副作用（只截图识别）。
# 返回：{"equip": 解析后的装备, "detail_open": 1/0}；equip.type 为空即
#       本格没有可用详情。
#
# equip_type 单字段可能 OCR 失败，不能单独用它区分空槽和识别失败。
def scan_cell($detail_kind)
    if $detail_kind == "weapon"
        call $raw = scan_equipment_detail("equip_weapon_detail")
    else
        call $raw = scan_equipment_detail("equip_armor_detail")
    end
    eval $result = {}
    eval $result.equip = to_equipment($raw)
    eval $result.detail_open = 0
    if $raw.equip_type or $raw.equip_level or $raw.base_attr or $raw.equip_detail
        eval $result.detail_open = 1
    end
    return $result
end
