<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ── 权限状态卡：一行一个权限，主按钮永远指向下一件要做的事。
             自检模式整卡隐藏（enterSelfTestLayout），布局回到旧版形态 ── -->

        <LinearLayout
            android:id="@+id/guide_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <TextView
                android:id="@+id/guide_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/guide_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_subtitle"
                android:textSize="14sp"
                android:paddingBottom="16dp" />

            <TextView
                android:id="@+id/check_a11y"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/check_pc_connection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/check_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/check_notification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:paddingBottom="16dp" />

            <Button
                android:id="@+id/btn_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/guide_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:paddingTop="8dp" />

        </LinearLayout>

        <!-- ── 功能区：配置入口 + 悬浮图标启停（自检模式同样整体隐藏） ── -->

        <LinearLayout
            android:id="@+id/features_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_features"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <Button
                android:id="@+id/btn_tuning_config"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_tuning_config" />

            <Button
                android:id="@+id/btn_calib"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_calib" />

            <Button
                android:id="@+id/btn_float_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_start_float" />

        </LinearLayout>

        <!-- ── 状态行：自检报告回填 + 点击回显目标，e2e 闭环靠 OCR 读这里 ── -->

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_placeholder"
            android:textSize="15sp"
            android:paddingBottom="16dp" />

        <!-- ── 高级面板：开发者自检按钮，默认折叠；adb 触发自检时自动展开 ── -->

        <TextView
            android:id="@+id/advanced_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/advanced_collapsed"
            android:textSize="15sp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/advanced_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_overlay" />

            <Button
                android:id="@+id/btn_a11y"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_a11y" />

            <Button
                android:id="@+id/btn_shizuku"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_shizuku" />

            <Button
                android:id="@+id/btn_notification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_notification" />

            <Button
                android:id="@+id/btn_test_shell"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_test_shell" />

            <Button
                android:id="@+id/btn_test_python"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_test_python" />

            <!-- 三通道闭环自检的被点目标：点中后上方状态行会出现「已生效」，
                 而这三个字在点击前的界面上不存在，因此 OCR 自己就能判定点击是否真的落地 -->
            <Button
                android:id="@+id/btn_test_click"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_test_click" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
