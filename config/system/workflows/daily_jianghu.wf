#% id: daily_jianghu
#% name: 每日江湖号令
#% runnable: true
#% batchable: true
#% env: [android, desktop]
#% note: |-
#%   请准备好'黄泉酿'并收藏
#%   如果反复匹配不上黄泉酿，可将「黄泉酿置信度」适当降低
#%   但不要太低——阈值过低容易把其他道具误认成黄泉酿。
#% parameters:
#%   - name: claim_reward
#%     label: 领取奖励
#%     type: bool
#%     default: false
#%   - name: max_refresh
#%     label: 任务最多刷新
#%     type: number
#%     default: 50
#%     min: 15
#%   - name: max_claim_reputation
#%     label: 最大领取声望
#%     require: $claim_reward
#%     type: number
#%     default: 1500
#%     min: 0
#%   - name: do_heying
#%     label: 合影
#%     type: bool
#%     default: true
#%   - name: do_huanzhuang
#%     label: 换装
#%     type: bool
#%     default: true
#%   - name: do_qingjing
#%     label: 情境
#%     type: bool
#%     default: true
#%   - name: do_kanbao
#%     label: 看报
#%     type: bool
#%     default: true
#%   - name: do_yinjiu
#%     label: 饮酒
#%     type: bool
#%     default: true
#%   - name: do_juezhanglin
#%     label: 觉障林
#%     type: bool
#%     default: true
#%   - name: min_yinjiu_confidence
#%     label: 黄泉酿置信度
#%     type: select
#%     default: "0.65"
#%     options: ["0.65", "0.6", "0.55", "0.5"]
#
# 江湖号令日常：在号令页把六张任务卡刷成目标任务并执行，按配置领取奖励。
#
# 流程结构：
#   1. 起始定位与首次同步：确认在号令页（允许自动导航），并读一次当周已获取声望
#   2. 处理六张任务卡：逐卡校验页面 → 判断是否已完成 → 命中目标则执行动作 →
#      按配置领奖；未命中则刷新到命中或达到 $max_refresh
#   3. 首轮遇到「处理前就已完成」的任务时补扫一轮，覆盖任务换位
#   4. 收尾：退回游戏首页；本次为合影切过多人模式则回到主页后切回单人模式
#
# 参数：
#   max_refresh          — 单个任务最大刷新次数，默认 50
#   claim_reward         — 是否领取奖励，默认 false
#   max_claim_reputation — 最大领取声望，默认 1500；仅当任务确实完成且
#                          当周已领取声望小于该值时才领奖
#   do_heying / do_huanzhuang / do_qingjing — 是否执行合影、换装、情境
#   do_kanbao / do_yinjiu / do_juezhanglin — 是否执行看报、饮酒、觉障林
#   min_yinjiu_confidence — 黄泉酿识别置信度阈值，默认 0.65；反复匹配
#                          不上时可降到 0.5 以上，但不要太低以免误认
# 前置：在游戏首页或江湖号令活动页（两种入口都按页面判定自行收敛）。
# 后置：成功时已退回游戏首页；为合影切过多人模式时已切回单人模式。
# 返回：0=六项都没勾选，未做任何操作或正常收尾；-1=Profile 声明失败、
#       页面校验失败或导航失败。
#
# 各过程在下方以 `# ─── 过程名 ───` 分隔，注释给出参数、前置、后置与返回。

default $claim_reward = false
default $max_refresh = 50
default $max_claim_reputation = 1500
default $do_heying = true
default $do_huanzhuang = true
default $do_qingjing = true
default $do_kanbao = true
default $do_yinjiu = true
default $do_juezhanglin = true
default $min_yinjiu_confidence = "0.65"

# 各任务过程共享运行配置与跨任务状态；当前任务的 idx / label / task_text
# 仍显式传递，避免子过程依赖隐藏的当前任务上下文。
# $min_yinjiu_confidence 必须在 global 中声明：过程作用域的变量表是全局表副本，
# 漏声明时 action_yinjiu 内读不到阈值，where 会静默失效（等于不过滤、任意分数都命中）。
global $claim_reward, $max_refresh, $max_claim_reputation, $haoling_of_week, $mode_checked, $mode_switched
global $do_heying, $do_huanzhuang, $do_qingjing, $do_kanbao, $do_yinjiu, $do_juezhanglin
global $min_yinjiu_confidence
global $jianghu_result, $jianghu_item

import "subcall/navigation.wf"
import "subcall/page_detection.wf"
import "subcall/page_action.wf"
import "subcall/game_profile.wf"
import "subcall/profile_registry.wf"
import "subcall/visual_state.wf"

# ─── 起始定位与首次同步 ────────────────────────────────────────────
# 仅记录已有流程的事实：共享可变对象在顶层 collect，子过程更新也保留部分结果。
call $jianghu_result = new_jianghu_result()
eval $jianghu_item = {}
collect $jianghu_result.summary as "jianghu"

call $profile_ok = declare_profiles(["haoling_of_week"])
if $profile_ok < 0
   call record_jianghu_failure("profile_declaration_failed")
   return -1
end

eval $haoling_of_week = -1
eval $mode_checked = false
eval $mode_switched = false

# 六项都未勾选时没有执行诉求，直接退出；只要勾选任一项，候选匹配仍按
# 完整六类目标进行，用户开关只影响命中后的动作与领奖。
call $has_task = has_selected_task()
if not $has_task
   log "未选择要执行的江湖号令任务，跳过流程"
   eval $jianghu_result.summary.status = "skipped"
   eval $jianghu_result.summary.reason = "未选择执行任务"
   eval $jianghu_result.status = "skipped"
   eval $jianghu_result.reason = "no_selected_task"
   eval $jianghu_result.finished = true
   return 0
end

# 起始定位：用户可能在江湖号令活动页点 F9，也可能停在游戏首页
# 读不到「号令」标题即视为在首页，先自动导航进活动页（auto_nav=1）
call $haoling_ok = ensure_at_haoling("起始", 1)
if $haoling_ok < 0
   call record_jianghu_failure("initial_page_failed")
   return -1
end

# 首次进入读取一次：识别到有效值即写入 profile；无效 OCR 优先回退到
# 当前用户 profile 的同步值。两者都无效时才保留本轮上次有效值。
# 此后只有领奖会改变该值，故「读取即写入」足以保证实时与存储一致。
call $haoling_of_week = sync_haoling_of_week()
eval $jianghu_result.reputation.before = $haoling_of_week
eval $jianghu_result.summary.reputation.before = $haoling_of_week

# ─── 处理六张任务卡 ──────────────────────────────────────────────
call $first_pass = process_jianghu_cards(false)
if not $first_pass.ok
   call record_jianghu_failure("first_pass_page_failed")
   return -1
end

# 处理前遇到已经完成的任务，既可能是用户提前做过，也可能是前面的任务
# 完成后卡片换位。两者不再额外区分：六张卡处理完后统一补扫一次即可。
if $first_pass.found_precompleted
   log "首轮遇到处理前已完成的任务，补扫六张江湖号令卡片"
   # 第六项外部任务且不领奖时会停在游戏主页；其他情况仍在号令页。
   # 复用既有页面校验，已在号令页时不导航，否则按主页路径返回。
   call $haoling_ok = ensure_at_haoling("补扫", 1)
   if $haoling_ok < 0
      call record_jianghu_failure("rescan_page_failed")
      return -1
   end
   call $second_pass = process_jianghu_cards(true)
   if not $second_pass.ok
      call record_jianghu_failure("rescan_processing_failed")
      return -1
   end
end

log "六个任务刷新处理完成"

# ─── 收尾：退回首页与切回单人模式 ───────────────────────────────────────
# 收尾：末个任务非合影时仍停在江湖号令页，连点三次返回退回游戏首页
call $at_haoling = is_in_haoling_page()
if $at_haoling
   log "仍在江湖号令页，退回游戏首页"
   click [activity_jianghu].[back] after wait @step_interval
   click [school_main].[back] after wait @step_interval
   click [game_menu_page].[back] after wait @step_interval
   eval $jianghu_result.cleanup.home = "return_attempted"
end

# 本次为合影切到过多人模式：从主页进菜单切回单人模式，再确认回到主页。
# 未切换过的不动作，保持用户原有模式。
if $mode_switched
   call restore_single_mode()
end

call finish_jianghu_result()

# ─── process_jianghu_cards ────────────────────────────────
# 完整处理当前页面的六张任务卡。
#
# 参数：
#   $is_rescan — true=本轮是补扫（已完成卡片不再重复领奖）
# 前置：已在江湖号令页；每张卡内部还会再校验一次页面。
# 后置：六张卡都过了一遍；未勾选执行的任务保留原样。
# 返回：{"ok": 六张卡是否正常处理完, "found_precompleted": 是否有卡片在本轮执行前就已完成}。
#
# 调用方仅依据第一轮结果决定是否补扫一次，第二轮不会继续递归。
def process_jianghu_cards($is_rescan)
   if $is_rescan
      eval $jianghu_result.passes = 2
   else
      eval $jianghu_result.passes = 1
   end
   eval $found_precompleted = false

   for idx in ["1", "2", "3", "4", "5", "6"]
      call $jianghu_item = begin_jianghu_record($is_rescan, $idx)

      # 任务开头再校验一次是否仍在号令页：前一个任务若卡住退出，
      # 可能未回到号令页，导致后续任务全部错乱。此时停在未知页面，
      # 不能自动导航（auto_nav=0），阻塞弹窗提示用户手动处理
      call $haoling_ok = ensure_at_haoling($idx, 0)
      if $haoling_ok < 0
         call record_jianghu_outcome("failed", "page_check_failed")
         return {"ok": false, "found_precompleted": $found_precompleted}
      end

      # 动态构造本组的子场景引用 key
      eval $label = "card_" + $idx

      # 完成后的任务仍保留原文案，右上角刷新按钮才是稳定状态信号。
      # 只有这个执行前入口会记录 found_precompleted；本轮动作完成不触发补扫。
      call $task_completed = is_task_completed($label)
      if $jianghu_item
         if $task_completed
            eval $jianghu_item.refresh_icon_before = false
         else
            eval $jianghu_item.refresh_icon_before = true
         end
      end
      if $task_completed
         eval $found_precompleted = true
         call record_jianghu_outcome("already_done", "completed_before_processing")
         call record_jianghu_completion("completed", false)
         log "任务 " + $idx + " 在处理前已经完成，跳过任务切换与执行"
         # 首轮已经处理过全部可领取奖励；补扫只补漏任务，不重复点击
         # 已完成卡片。补扫中新执行完成的任务仍走下方正常领奖分支。
         if $claim_reward and not $is_rescan
            call claim_completed_reward($label, $idx)
         end
         continue
      end

      scan [activity_jianghu].$label.[label] as $text_result
      log "任务 " + $idx + "（" + $label + "）初次扫描：" + $text_result.label

      # 复用上面的 OCR 文字判断是否为目标任务，不重复扫描。
      eval $task_text = $text_result.label
      if $jianghu_item
         eval $jianghu_item.initial_text = $task_text
      end
      call $hit = is_target_task($task_text)
      if $hit
         log "任务 " + $idx + " 已是目标任务"
      else
         call $refresh_result = refresh_task_until_terminal(
            $label, $idx, $task_text)
         eval $refresh_status = $refresh_result.status
         eval $task_text = $refresh_result.task_text
         if $jianghu_item
            eval $jianghu_item.task_text = $task_text
         end

         if $refresh_status == "completed"
            call record_jianghu_outcome("already_done", "completed_during_refresh")
            call record_jianghu_completion("completed", false)
            if $claim_reward
               call claim_completed_reward($label, $idx)
            end
            continue
         end

         if $refresh_status == "target"
            eval $hit = 1
         else
            log "任务 " + $idx + " 达到刷新上限仍未命中，跳过"
            call record_jianghu_outcome("refresh_exhausted", "refresh_limit")
         end
      end

      # 命中目标任务 → 读取任务文本，分发执行对应动作
      if $hit
         call $should_execute = should_execute_task($task_text)
         call identify_jianghu_record($is_rescan, $idx, $task_text, $should_execute)
         if not $should_execute
            log "任务 " + $idx + "（" + $label + "）属于固定目标，但用户未勾选执行，保留任务并跳过动作与领奖"
            call record_jianghu_outcome("disabled", "user_disabled")
            call record_jianghu_reward("disabled", "user_disabled")
            continue
         end
         log "任务 " + $idx + "（" + $label + "）执行前：" + $task_text

         call record_jianghu_outcome("executing", "")
         call $skip_reward_check = execute_target_task($task_text, $label, $idx)
         if $skip_reward_check
            log "任务 " + $idx + " 未完成，跳过领奖检测"
            call record_jianghu_reward("task_incomplete", "action_blocked")
            continue
         end

         call record_jianghu_action_returned()

         # 领取奖励（勾选时）：完成后任务文字仍会保留，刷新按钮消失才
         # 表示任务已经真正完成。觉障林未实现，无论是否勾选均跳过领奖。
         if $claim_reward and not $task_text contains "觉障林"
            call $task_completed = is_task_completed($label)
            if $task_completed
               call record_jianghu_completion("completed", false)
               call record_jianghu_outcome("completed", "completion_observed")
               call claim_completed_reward($label, $idx)
            else
               log "任务 " + $idx + " 执行后刷新按钮仍存在，判定未真正完成，跳过领奖"
               call record_jianghu_completion("incomplete", true)
               call record_jianghu_outcome("incomplete", "refresh_icon_present")
               call record_jianghu_reward("task_incomplete", "refresh_icon_present")
            end
         end
      end

   end

   return {"ok": true, "found_precompleted": $found_precompleted}
end

# ─── is_task_completed ────────────────────────────────────
# 卡片是否已经完成。
#
# 参数：
#   $label — 卡片 key（card_1 … card_6）
# 前置：在江湖号令页。
# 后置：无副作用（只识别，不点击）。
# 返回：1=已完成；0=任务仍在进行中（右上角刷新按钮还在）。
#
# 任务完成后文字仍会保留，但右上角刷新按钮消失；所有调用点统一使用布局绑定
# 模板，避免 OCR 文案长度造成误判。
def is_task_completed($label)
   scan [activity_jianghu].$label.[refresh] as $refresh_found by image
   if $refresh_found
      return 0
   end
   return 1
end

# ─── has_selected_task ────────────────────────────────────
# 六个执行开关里是否至少勾选了一项。
#
# 参数：无
# 前置：无。
# 后置：无副作用。
# 返回：1=至少勾选一项；0=六项全关。
#
# 仅用于六项全关时快速退出，不参与目标候选判定。
def has_selected_task()
   return $do_heying or $do_huanzhuang or $do_qingjing or $do_kanbao or $do_yinjiu or $do_juezhanglin
end

# ─── is_target_task ───────────────────────────────────────
# 卡片文案是否属于六类目标任务。
#
# 参数：
#   $text — 卡片 label 区域的 OCR 原文
# 前置：无。
# 后置：无副作用。
# 返回：1=属于六类之一；0=不是目标任务（应继续刷新）。
#
# targets 领域约束：六类任务关键词由游戏文案保证互斥，一张任务卡片只会
# 命中其中一个关键词，不存在多个目标关键词同时命中的正交情况。
# 界面使用用户熟悉的“看报”和“饮酒”，OCR 仍分别匹配“东方”和“醉意”。
# 六类是否属于目标是游戏领域事实，不受用户执行开关影响。
def is_target_task($text)
   if $text contains "合影"
      return 1
   end
   if $text contains "换装"
      return 1
   end
   if $text contains "情境"
      return 1
   end
   if $text contains "东方"
      return 1
   end
   if $text contains "醉意"
      return 1
   end
   if $text contains "觉障林"
      return 1
   end
   return 0
end

# ─── should_execute_task ──────────────────────────────────
# 用户开关是否允许执行这个已命中的目标任务。
#
# 参数：
#   $text — 卡片 label 区域的 OCR 原文
# 前置：$text 已确认属于六类目标任务。
# 后置：无副作用。
# 返回：1=对应开关已勾选，可以执行；0=开关关闭或不属于六类。
#
# 用户开关只控制已匹配目标是否执行；关闭时保留该任务，不执行动作和领奖。
def should_execute_task($text)
   if $text contains "合影"
      call record_jianghu_task("heying", "合影")
      return $do_heying
   end
   if $text contains "换装"
      call record_jianghu_task("huanzhuang", "换装")
      return $do_huanzhuang
   end
   if $text contains "情境"
      call record_jianghu_task("qingjing", "情境")
      return $do_qingjing
   end
   if $text contains "东方"
      call record_jianghu_task("kanbao", "看报")
      return $do_kanbao
   end
   if $text contains "醉意"
      call record_jianghu_task("yinjiu", "饮酒")
      return $do_yinjiu
   end
   if $text contains "觉障林"
      call record_jianghu_task("juezhanglin", "觉障林")
      return $do_juezhanglin
   end
   return 0
end

# ─── execute_target_task ──────────────────────────────────
# 按 OCR 任务文字分发到对应动作。
#
# 参数：
#   $task_text — 卡片 label 区域的 OCR 原文（决定执行哪个动作）
#   $label     — 卡片 key（card_1 … card_6）
#   $idx       — 任务序号，用于判断是否为末个任务
# 前置：已在号令页，且开关允许执行该任务。
# 后置：对应动作已执行完；各动作自行负责把页面收回到号令页或首页。
# 返回：1=动作明确无法完成，主流程应跳过领奖检测；0=可以继续判领奖。
#
# 当前仅饮酒未找到黄泉酿时返回 1。
def execute_target_task($task_text, $label, $idx)
   eval $skip_reward_check = 0
   if $task_text contains "换装"
      call action_huanzhuang($label)
   end
   if $task_text contains "合影"
      call action_heying($label, $idx)
   end
   if $task_text contains "情境"
      call action_qingjing($label)
   end
   if $task_text contains "东方"
      call action_kanbao($label, $idx)
   end
   if $task_text contains "醉意"
      call $skip_reward_check = action_yinjiu($label, $idx)
   end
   if $task_text contains "觉障林"
      call action_juezhanglin($label)
   end
   return $skip_reward_check
end

# ─── refresh_task_until_terminal ──────────────────────────
# 反复刷新非目标任务，直到出现一种终态。
#
# 参数：
#   $label        — 卡片 key（card_1 … card_6）
#   $idx          — 任务序号，仅用于日志
#   $initial_text — 初次扫描到的任务文字（作为刷新前的基线）
# 前置：在江湖号令页，且该卡片不是目标任务。
# 后置：停在号令页，卡片内容为最后一轮刷新后的状态。
# 返回：{"status": "target"|"completed"|"exhausted", "task_text": 最后一次 OCR}。
#
# 三种终态：
#   target    — 已刷新到目标任务，task_text 为命中的任务文字；
#   completed — 刷新按钮消失，说明卡片已经完成；
#   exhausted — 达到刷新上限仍未命中。
# 返回字典同时携带最后一次 OCR，避免依赖过程外变量或 context。
def refresh_task_until_terminal($label, $idx, $initial_text)
   eval $previous_task_text = trim($initial_text)

   loop $max_refresh
      click [activity_jianghu].$label.[refresh] after wait stable @page_refresh least 0.3
      if $jianghu_item
         eval $jianghu_item.refresh_count = $jianghu_item.refresh_count + 1
      end

      # 任务文字可能保持不变，不能据此推断完成；每次刷新后只认刷新按钮。
      call $task_completed = is_task_completed($label)
      if $task_completed
         log "任务 " + $idx + " 刷新按钮已经消失，判定任务已完成"
         return {"status": "completed", "task_text": $previous_task_text}
      end

      scan [activity_jianghu].$label.[label] as $text_result
      eval $task_text = trim($text_result.label)
      if $jianghu_item
         eval $jianghu_item.task_text = $task_text
      end
      log "任务 " + $idx + "（" + $label + "）刷新扫描：" + $task_text

      call $hit = is_target_task($task_text)
      if $hit
         log "任务 " + $idx + " 刷新命中目标任务"
         return {"status": "target", "task_text": $task_text}
      end

      eval $previous_task_text = $task_text
   end

   return {"status": "exhausted", "task_text": $previous_task_text}
end

# ─── claim_completed_reward ───────────────────────────────
# 对已经确认完成的任务检查奖励金光与声望上限后领奖。
#
# 参数：
#   $label — 卡片 key（card_1 … card_6）
#   $idx   — 任务序号，仅用于日志
# 前置：该卡片已确认完成（刷新按钮消失），且当周声望已同步过。
# 后置：领奖成功时已刷新并写回 haoling_of_week；不领奖时现场不变。
# 返回：恒为 0；是否真的领了由日志与 profile 值体现。
#
# 刷新图标消失只能证明任务完成，不能证明奖励尚未领取；领奖入口必须再次区分
# 两种状态。haoling_of_week 在六轮任务间持续更新，max_claim_reputation 是运行
# 配置。
def claim_completed_reward($label, $idx)
   if $haoling_of_week < 0
      log "任务 " + $idx + " 已完成，但当周声望识别无效，跳过领奖"
      call record_jianghu_reward("progress_unknown", "invalid_weekly_progress")
      return 0
   end
   if $haoling_of_week < $max_claim_reputation
      call $reward_state = detect_jianghu_card_reward_state($label)
      if $jianghu_item
         eval $jianghu_item.reward.observed_state = $reward_state
      end
      if $reward_state == "claimed"
         log "任务 " + $idx + " 已完成且奖励已领取，跳过重复点击"
         call record_jianghu_reward("already_claimed", "reward_already_claimed")
         return 0
      end
      if $reward_state != "unclaimed"
         log "任务 " + $idx + " 已完成但奖励金光状态无法确认，跳过领奖"
         call record_jianghu_reward("reward_unknown", "reward_state_unknown")
         return 0
      end
      call record_jianghu_reward("claim_attempted", "claim_not_verified")
      call claim_reward($label, $idx)
      # 领奖改变了当周累计值，立即刷新并写入 profile；识别失败或数值回退
      # 会保留上次有效值，后续继续按该值判断是否领奖。
      call $haoling_of_week = sync_haoling_of_week()
      return 0
   end
   # $haoling_of_week 来自上一次 sync_haoling_of_week，当时已写入 profile，
   # 未领奖即无变化，无需重复写
   log "当周已领取声望 " + $haoling_of_week + "，达到最大领取声望 " + $max_claim_reputation + "，跳过领奖"
   call record_jianghu_reward("limit_reached", "weekly_limit")
   return 0
end

# ─── sync_haoling_of_week ─────────────────────────────────
# 读取号令页的当周累计声望并同步 profile。
#
# 参数：无
# 前置：在江湖号令页。
# 后置：识别到有效值时已写入 haoling_of_week；识别失败只回退取值、不报错。
# 返回：本次采用的当周声望；无有效值时沿用本轮上次有效值。
#
# 按完整 a/b 进度解析。这是当周声望的唯一读取入口；公共同步过程负责 OCR 失败
# 回退、本轮防回退，Profile 底层负责同周期防回写并允许跨周后的合法归零。
def sync_haoling_of_week()
   scan [activity_jianghu].[haoling_of_week] as $result
   call $value = sync_weekly_progress($result.haoling_of_week, "haoling_of_week", $haoling_of_week, "当周获取号令", "江湖号令")
   eval append($jianghu_result.reputation.observations, {"raw_text": $result.haoling_of_week, "adopted_value": $value})
   eval $jianghu_result.reputation.after = $value
   eval $jianghu_result.summary.reputation.after = $value
   log debug "号令周声望原文：" + $result.haoling_of_week + "；采用：" + $value
   return $value
end

# ─── ensure_at_haoling ────────────────────────────────────
# 校验当前是否位于江湖号令页，不在则先设法回到号令页再校验一次。
#
# 参数：
#   $idx      — 调用点标识，仅用于日志（"起始" 或任务序号）
#   $auto_nav — 1：视为停在游戏首页，调 back_to_haoling() 自动导航；
#               0：停在未知页面（上个任务卡住未收尾），自动导航不可靠，
#                  改为阻塞弹窗提示用户手动返回号令页
# 前置：无（任意页面均可调用）。
# 后置：0 时已在号令页；-1 时停在补救失败的位置。
# 返回：0=已在号令页；-1=补救后仍不在，调用方应终止流程。
def ensure_at_haoling($idx, $auto_nav)
   call $at_haoling = is_in_haoling_page()
   if $at_haoling
      return 0
   end

   if $auto_nav
      log $idx + "：未识别到号令标题，视为当前在游戏首页，先导航至江湖号令页"
      call back_to_haoling()
   else
      log "任务 " + $idx + " 开始前检测到不在江湖号令页，可能是上个任务未正常收尾"
      screenshot from last
      eval pause("检测到当前不在江湖号令页，请手动返回号令页后点击继续")
   end

   call $at_haoling = is_in_haoling_page()
   if $at_haoling
      return 0
   end

   screenshot from last
   log "仍未进入江湖号令页，终止流程"
   return -1
end

# ─── claim_reward ─────────────────────────────────────────
# 点击任务标签领取奖励。
#
# 参数：
#   $label — 卡片 key（card_1 … card_6）
#   $idx   — 任务序号，仅用于日志
# 前置：已在号令页（状态由各动作保证），且奖励状态已判定为待领取。
# 后置：已点击领奖并点空白区域关掉全屏奖励窗口，页面回到号令页。
# 返回：无返回值（隐式 null）。
#
# 领奖后弹出全屏奖励窗口，点一次空白区域关闭，否则遮挡下一轮页面校验。
def claim_reward($label, $idx)
   click [activity_jianghu].$label.[label] after wait @step_interval
   log "任务 " + $idx + " 奖励已领取"
   click [general_control].[blank_area] after wait @step_interval
end

# ─── 各活动动作过程 ──────────────────────────────────────────────
# 每个过程接收命中任务的卡片引用 key（如 "card_1"），从江湖号令页出发执行
# 对应活动，并按下面的约定把页面收回到号令页或游戏首页。

# ─── finish_external_task ─────────────────────────────────
# 外部任务（合影/看报/饮酒）执行完后的收尾（内部过程）。
#
# 参数：
#   $idx       — 任务序号，用于判断是否为末个任务
#   $task_name — 任务名，仅用于日志
# 前置：该动作已执行完，当前停在游戏首页。
# 后置：末个任务且不领奖时留在游戏首页；其他情况已回到号令页。
# 返回：恒为 0。
#
# 合影、看报、饮酒都会落在游戏首页：非末个任务或需要领奖时返回号令页；
# 末个任务且无需领奖时保持在首页。调用位置和导航时机由各动作自行决定。
def finish_external_task($idx, $task_name)
   if $idx == "6" and not $claim_reward
      log "末个任务" + $task_name + "完成且无需领奖，留在桌面"
   else
      call back_to_haoling()
   end
   return 0
end

# ─── action_huanzhuang ────────────────────────────────────
# 换装动作。
#
# 参数：
#   $label — 卡片 key（card_1 … card_6）
# 前置：在江湖号令页，且该卡片已命中「换装」。
# 后置：执行完已回到号令页基底（浮层已关闭）。
# 返回：无返回值（隐式 null）。
#
# 路径：点击任务 → 浮层前往 → 外观衣柜（穿搭方案 → 方案1 → 套用方案）
# → 衣柜返回任务浮层 → 关闭浮层回到号令基底
def action_huanzhuang($label)
   click [activity_jianghu].$label.[label] after wait @step_interval
   click [activity_jianghu].[goto] after wait stable @page_refresh least 0.5
   click [appearance_main].[chuanda] after wait @step_interval
   click [appearance_main].[fangan_1] after wait @step_interval
   click [appearance_main].[taoyong] after wait @step_interval
   click [appearance_main].[back] after wait @step_interval
   click [appearance_main].[back] after wait stable @page_refresh least 0.5
   click [activity_jianghu].[overlay_back] after wait @step_interval
end

# ─── action_heying ────────────────────────────────────────
# 合影拍照动作。
#
# 参数：
#   $label — 卡片 key（card_1 … card_6）
#   $idx   — 任务序号，交给 finish_external_task 决定是否返回号令页
# 前置：在江湖号令页，且该卡片已命中「合影」。
# 后置：末个任务且不领奖时留在游戏首页；其他情况已回到号令页。
# 返回：无返回值（隐式 null）。
#
# 路径：点击任务 → 前往 → 拍照页面（动作控制·拍照）→ 等待刷新 → 返回×2 → 可选确认。
# 退出拍照会落到游戏首页（桌面），拍照结束后主动返回号令页；
# 末个任务仅在需要领奖时才返回，否则留在桌面。
# 本次为合影切过多人模式时由主流程收尾切回单人模式。
def action_heying($label, $idx)
   click [activity_jianghu].$label.[label] after wait @step_interval
   click [activity_jianghu].[goto] after wait stable @page_refresh least 0.5

   click [general_action].[camera_shot] after wait @page_refresh
   click [general_action].[back] after wait @step_interval
   click [general_action].[back] after wait @step_interval
   call scan_and_confirm("退出拍照", 0)

   # 拍照结束落在桌面，按任务位置和领奖配置决定是否返回号令页。
   call finish_external_task($idx, "合影")
end

# ─── action_qingjing ──────────────────────────────────────
# 情境动作。
#
# 参数：
#   $label — 卡片 key（card_1 … card_6）
# 前置：在江湖号令页，且该卡片已命中「情境」。
# 后置：执行完已回到号令页基底（浮层已关闭）。
# 返回：无返回值（隐式 null）。
#
# 路径：点击任务 → 弹出情境视图（展开 → 前往编辑情境）
# → 情境编辑视图（保存 → 取消按钮出现则点一次 → 轮询等待保存完成）
# → 退出编辑（若回到外观情境 tab 则退出外观）→ 号令情境层返回任务浮层 → 关闭浮层
def action_qingjing($label)
   click [activity_jianghu].$label.[label] after wait @step_interval
   click [activity_jianghu].[goto] after wait @step_interval
   if env("android")
      click [activity_jianghu].[expand_up] after wait @step_interval
   end
   click [activity_jianghu].[goto_qingjing] after wait @secondary_confirm

   # 外观入口为衣柜（基底）；若未直达编辑页，切换情境 tab 后进入独立编辑页
   scan [appearance_main].[chuanda] as $in_yigui by contains "穿搭"
   if $in_yigui
      log "检测到在衣柜页面，导航回情境编辑页面"
      click [appearance_main].[qingjing] after wait @step_interval
      click [appearance_main].[edit_qingjing] after wait @secondary_confirm
   end

   # 保存后弹窗需要渲染时间，先等一下再扫描
   click [appearance_main].[save] after wait @secondary_confirm

   # 保存后可能弹出二次确认，识别到取消按钮才点一次
   scan [general_control].[cancel] as $has_cancel by contains "取消"
   if $has_cancel
      log "情境保存弹出取消按钮，点击一次"
      click [general_control].[cancel] after wait @step_interval
   end
   # 轮询检查 save 区域是否出现「保存」，最多等待 10 次
   eval $save_i = 0
   eval $save_found = ""
   loop while $save_i < 10
      eval $save_i = $save_i + 1
      wait @step_interval
      scan [appearance_main].[save] as $save_found by contains "保存"
      if $save_found
         break
      end
   end
   if not $save_found
      screenshot from last
      eval pause("保存情境失败，请手动处理")
   end

   click [appearance_main].[back] after wait stable @page_refresh least 0.5
   # 普通入口会回到外观情境 tab；号令直达可能直接回到号令情境层。
   scan [appearance_main].[edit_qingjing] as $in_appearance by contains "编辑情境"
   if $in_appearance
      click [appearance_main].[back] after wait stable @page_refresh least 0.5
   end
   click [activity_jianghu].[qingjing_back] after wait @step_interval
   click [activity_jianghu].[overlay_back] after wait @step_interval
end

# ─── action_kanbao ────────────────────────────────────────
# 看报动作（任务文字「东方第一枝」）。
#
# 参数：
#   $label — 卡片 key（card_1 … card_6）
#   $idx   — 任务序号，交给 finish_external_task 决定是否返回号令页
# 前置：在江湖号令页，且该卡片已命中「东方」（看报）。
# 后置：末个任务且不领奖时留在游戏首页；其他情况已回到号令页。
# 返回：无返回值（隐式 null）。
#
# 路径：点击任务 → 前往 → 立刻进入表情动作视图 → 整面板扫描 actions 定位
# 「看报」格子并点击 → 等 5s 弹出报纸阅读视图 → 点第一个选择 → 连点两次返回
# 回到游戏首页（桌面）。看报动作未解锁时只记日志，跳过看报操作。
def action_kanbao($label, $idx)
   click [activity_jianghu].$label.[label] after wait @step_interval
   click [activity_jianghu].[goto] after wait @step_interval

   # 整面板扫描动作列表，定位「看报」所在行列（行列数读自布局定义）
   scan [general_action].[actions] as $acts
   eval $nrows = panel_rows("general_action", "actions")
   eval $ncols = panel_cols("general_action", "actions")
   eval $fr = ""
   for r in [1...$nrows]
      for c in [1...$ncols]
         if $acts.$r.$c contains "看报"
            eval $fr = $r
            eval $fc = $c
            goto found_kanbao
         end
      end
   end

   @found_kanbao
   if $fr is_empty
      # 扫描读不到时回退默认位置：看报固定在 1 行 3 列
      log "动作列表未识别到「看报」，按默认位置 [1][3] 处理"
      eval notify("东方第一枝：未识别到「看报」，按默认位置 [1][3] 处理")
      eval $fr = 1
      eval $fc = 3
   end

   if env("android")
      click [general_action].[actions][$fr][$fc] after wait @step_interval
   else
      press $fc after wait @step_interval
   end
   # 看报动作生效需时间，固定等 5 秒弹出报纸阅读视图
   wait 5

   # 检查是否仍在主页（看报动作未解锁，未进入表情动作视图）
   call $in_main = is_in_main_page()
   if $in_main
       log "仍在主页，看报动作可能未解锁，跳过看报操作"
       call record_jianghu_outcome("blocked", "reading_not_entered")
   else
       call perform_kanbao()
   end
   # 端游处于动作列表必须 ESC 关闭才能结束，暂时不做判断，除非后续此处大量报错
   env:"desktop" -> press "ESC" after wait @step_interval

   # 看报结束落在桌面，按任务位置和领奖配置决定是否返回号令页。
   call finish_external_task($idx, "看报")
end

# ─── perform_kanbao ───────────────────────────────────────
# 看报阅读视图内的操作（内部过程）。
#
# 参数：无
# 前置：已进入表情动作视图（不在主页）。
# 后置：已点选择、处理确认弹窗并尝试返回；仍在表情动作视图时会再点一次返回。
# 返回：无返回值（隐式 null）。
#
# 点第一个选择 → 返回 → 处理确认弹窗 → 检查是否已回到主页。
def perform_kanbao()
   click [general_action].[choose_1] after wait stable @page_refresh least 0.5
   click [general_control].[blank_area] after wait stable @page_refresh least 0.5

   # 投票后可能弹出确认弹窗，识别到"确认"则点击"取消"关闭
   scan [general_control].[confirm] as $has_confirm by contains "确认"
   if $has_confirm
      log "检测到确认弹窗，点击取消关闭"
      click [general_control].[cancel] after wait @step_interval
   end

   # 如果已经完成过任务，可能导致此时已经在主页，所以需要额外判断
   call $in_main_page = is_in_main_page()
   if $in_main_page == 0
       click [general_action].[kanbao_back] after wait @step_interval
   end
end

# ─── action_yinjiu ────────────────────────────────────────
# 饮酒动作（任务文字「醉意」）。
#
# 参数：
#   $label — 卡片 key（card_1 … card_6）
#   $idx   — 任务序号，交给 finish_external_task 决定是否返回号令页
# 前置：在江湖号令页，且该卡片已命中「醉意」。
# 后置：末个任务且不领奖时留在游戏首页；其他情况已回到号令页。
# 返回：1=没找到黄泉酿（动作无法完成，调用方应跳过领奖检测）；0=已食用或导航失败。
#
# 路径：号令 → 退回首页 → 菜单 → 包裹 → 道具 - 普通道具 → 找黄泉酿食用
# → 退回首页 → 返回号令
# 阈值：$min_yinjiu_confidence（默认 0.65，可降至 0.5 以上；过低会误认其他道具）
def action_yinjiu($label, $idx)
   # ── 从江湖号令退回首页 ──
   click [activity_jianghu].[back] after wait stable @page_refresh least 0.5
   click [school_main].[back] after wait stable @page_refresh least 0.5
   click [game_menu_page].[back] after wait stable @page_refresh least 0.5

   # ── 首页 → 菜单 → 包裹 → 道具 - 普通道具 ──
   call $nav_result = nav_main_to_item()
   if $nav_result < 0
      # 保持既有导航失败处理：仅“没找到黄泉酿”会跳过领奖检测。
      call record_jianghu_outcome("failed", "item_navigation_failed")
      return 0
   end

   # ── 在背包网格中寻找黄泉酿 ──
   # 阈值来自 select 参数，值本身是字符串档位；显式转成数值再做比较，
   # 不依赖 where 内部的隐式转换（$min_yinjiu_confidence 必须已在 global 中声明）。
   eval $yinjiu_threshold = to_num($min_yinjiu_confidence)
   recognize [bag_item_detail].[bag_grid][1...2][1...6] as $result \
      by equals "黄泉酿" \
      on group ["增益道具"] \
      where confidence >= $yinjiu_threshold

   if $result
      eval $yinjiu_r = $result.row
      eval $yinjiu_c = $result.col
      log "找到黄泉酿：row=" + $yinjiu_r + ", col=" + $yinjiu_c

      # 点击黄泉酿所在格子，打开道具详情
      click [bag_item_detail].[bag_grid][$yinjiu_r][$yinjiu_c] after wait stable @page_refresh least 0.5

      if env("android")
         # 在详情面板中寻找「食用」按钮
         find [bag_item_detail].[main_area] as $btn by contains "食用"
         if $btn
            click $btn after wait @step_interval
            wait 1
            # 食用后可能弹出确认弹窗，识别到"确认"则点击"取消"关闭
            scan [general_control].[confirm] as $has_confirm by contains "确认"
            if $has_confirm
               click [general_control].[cancel] after wait @step_interval
            end
         else
            log "找不到食用按钮"
            call record_jianghu_outcome("blocked", "use_button_not_found")
         end
      else
         press "F" after wait @step_interval
      end
   else
      log "找不到黄泉酿"
      call record_jianghu_outcome("blocked", "item_not_found")
   end

   # ── 关闭背包，退回首页 ──
   call nav_back_to_main()

   call finish_external_task($idx, "醉意")
   if not $result
      return 1
   end
   return 0
end

# ─── action_juezhanglin ───────────────────────────────────
# 觉障林动作占位。
#
# 参数：
#   $label — 卡片 key（card_1 … card_6）
# 前置：在江湖号令页。
# 后置：不做任何操作（动作暂未实现）。
# 返回：无返回值（隐式 null）。
#
# 动作暂未实现：只记一条日志，卡片按「未执行动作」处理，主流程跳过领奖。
def action_juezhanglin($label)
   log "觉障林动作暂未实现"
   call record_jianghu_outcome("not_implemented", "action_not_implemented")
   call record_jianghu_reward("task_incomplete", "action_not_implemented")
end

# ─── switch_game_mode ─────────────────────────────────────
# 切换游戏模式（单人 / 多人）。
#
# 参数：
#   $target — "mp"=多人模式；"sp"=单人模式
# 前置：在菜单页。
# 后置：1 时已在游戏主页；0 时仍在菜单页且未做任何点击。
# 返回：1=执行了切换（调用方需重新打开菜单）；0=已是目标模式，未动作。
#
# 两种模式在模式选择页结构对称，只是按钮不同。模式标签已显示目标模式则不动
# 作；否则经模式选择页切换并踏入，轮询等待回到游戏主页。
def switch_game_mode($target)
   if $target == "mp"
      eval $from_text = "单人"
      eval $target_name = "多人模式"
   else
      eval $from_text = "多人"
      eval $target_name = "单人模式"
   end
   scan [game_menu_page].[mode] as $need_switch by contains $from_text
   if not $need_switch
      return 0
   end

   log "检测到" + $from_text + "模式，切换至" + $target_name
   eval $mode_key = $target + "_mode"
   click [game_menu_page].[mode] after wait @step_interval
   click [game_menu_page].$mode_key after wait @step_interval
   click [game_menu_page].[enter_mode] after wait @page_refresh

   # 踏入后每 2s 检测一次游戏主页，最多 10 次
   eval $main_i = 0
   eval $in_main = 0
   loop while $main_i < 10
      eval $main_i = $main_i + 1
      wait 2
      call $in_main = is_in_main_page()
      if $in_main
         log "已进入" + $target_name + "，回到游戏主页"
         break
      end
   end
   if not $in_main
      log "等待 20s 仍未回到游戏主页"
      screenshot from last
      eval pause("切换" + $target_name + "后未检测到游戏主页，请手动处理后点击确定")
   end
   return 1
end

# ─── restore_single_mode ──────────────────────────────────
# 收尾把游戏切回单人模式。
#
# 参数：无
# 前置：本次为合影切换过多人模式。
# 后置：0=已确认在游戏主页；-1=菜单打不开或切完仍未回到主页（已 pause 提示）。
# 返回：0=成功；-1=失败。
#
# 路径：主页 → 菜单 → 切换单人模式 → 确认回到游戏主页。
# 已是单人模式（用户中途手动切回）则只关闭菜单。
def restore_single_mode()
   eval $jianghu_result.cleanup.mode = "restoring"
   log "本次为合影切换过多人模式，收尾切回单人模式"
   call $nav_result = nav_main_to_menu()
   if $nav_result < 0
      log "打不开菜单页，无法切回单人模式"
      eval $jianghu_result.cleanup.mode = "failed"
      return -1
   end
   call $switched = switch_game_mode("sp")
   if not $switched
      log "已是单人模式，关闭菜单"
      click [game_menu_page].[back] after wait @step_interval
   end
   call $in_main = is_in_main_page()
   if not $in_main
      log "切回单人模式后未回到游戏主页"
      eval $jianghu_result.cleanup.mode = "failed"
      screenshot from last
      eval pause("切回单人模式后未检测到游戏主页，请手动回到主页后点击确定")
      return -1
   end
   log "已切回单人模式并回到游戏主页"
   eval $jianghu_result.cleanup.mode = "restored"
   eval $jianghu_result.cleanup.home = "confirmed"
   return 0
end

# ─── back_to_haoling ──────────────────────────────────────
# 从游戏首页导航到江湖号令页。
#
# 参数：无
# 前置：在游戏首页（或菜单页）。
# 后置：0=已点击号令入口（或已交由用户手动处理后继续）；-1=找不到门派或号令。
# 返回：0=成功；-1=失败。
#
# 路径：菜单 → find 门派 → 门派首页 → find 江湖号令。
# 每步找不到时 pause 通知用户手动定位，用户点确定后重试一次。
# 首次打开菜单时会按合影开关检查游戏模式，需要时切到多人模式并重新打开菜单。
def back_to_haoling()
   call $nav_result = nav_main_to_menu()
   if $nav_result < 0
      eval pause("打不开菜单页，请手动定位到菜单页后点击确定")
      call $in_menu = is_in_menu_page()
      if $in_menu < 1
         screenshot from last
         return -1
      end
   end

   # 首次打开菜单时检查游戏模式，识别到单人则切到多人模式；
   # 切换后会回到游戏主页，需重新打开菜单；未切换则仍在菜单页，
   # 无需再次导航。mode_checked 是本次执行内的全局标记，下次运行会重置。
   if $do_heying and not $mode_checked
      eval $mode_checked = true
      call $switched = switch_game_mode("mp")
      if $switched
         # 记下本次切换过，收尾时切回；切换后落在游戏主页，重新打开菜单继续导航
         eval $mode_switched = true
         call $nav_result = nav_main_to_menu()
         if $nav_result < 0
            return -1
         end
      end
   end

   # 在菜单区域搜索「门派」，可能需要下滑翻页
   find [game_menu_page].[menu] as $found by contains "门派"
   if not $found
      drag [general_control].[menu_up] after wait @step_interval
      find [game_menu_page].[menu] as $found by contains "门派"
   end
   if not $found
      log "找不到门派，请手动定位后继续"
      screenshot from last
      eval pause("找不到「门派」，请手动定位到门派入口后点击确定")
      find [game_menu_page].[menu] as $found by contains "门派"
   end
   if not $found
      screenshot from last
      log "仍未找到门派，无法前往江湖号令页"
      return -1
   end
   click $found after wait (2, 3)

   # 门派页三种形态：
   # # 有门派（基底，入口文字「江湖号令」）
   # # 无门无派（no_school 视图，入口换成 haoling_2）
   # # 问津（wenjin 视图，入口换成 haoling_3）
   scan [school_main].[haoling_1, haoling_2, haoling_3] as $haoling_key by contains "号令"
   if $haoling_key
      log "识别到号令，正常进入，区域：" + $haoling_key
      click [school_main].$haoling_key after wait stable @page_refresh least 0.5
      return 0
   end

   # 三种都识别不到，干脆全图扫
   # 门派页三种形态均含「号令」文字，find 统一搜索
   find as $haoling_key by contains "号令"
   if $haoling_key
      screenshot from last
      log "全图扫识别到江湖号令，已截图，建议检查问题"
      click $haoling_key after wait @step_interval
   else
      log "找不到江湖号令，请手动定位后继续"
      screenshot from last
      eval pause("找不到「江湖号令」，请手动定位到号令页后点击确定")
   end
   return 0
end

# ─── 结果记录（只更新输出对象，不参与原有动作决策）──────────────────
def new_jianghu_result()
   return {"summary": {"status": "running", "tasks": {}, "unidentified": [], "reputation": {}}, "schema_version": 1, "status": "running", "finished": false, "reason": "", "passes": 0, "counts": {}, "tasks": {}, "unidentified": [], "reputation": {"before": -1, "after": -1, "observations": []}, "cleanup": {"home": "unknown", "mode": "not_needed"}}
end

def make_jianghu_record($pass, $idx)
   eval $reward = "not_checked"
   if not $claim_reward
      eval $reward = "disabled"
   end
   return {"summary": {"status": "unknown"}, "pass": $pass, "card": "card_" + $idx, "task": "", "task_name": "", "initial_text": "", "task_text": "", "refresh_count": 0, "outcome": "unknown", "reason": "", "completion": "unknown", "refresh_icon_before": "unknown", "refresh_icon_after": "unknown", "action": {"status": "not_attempted", "reason": ""}, "events": [], "reward": {"status": $reward, "reason": "", "observed_state": "unknown"}}
end

def begin_jianghu_record($is_rescan, $idx)
   if $is_rescan
      call $record = make_jianghu_record(2, $idx)
      return $record
   end
   call $record = make_jianghu_record(1, $idx)
   eval append($jianghu_result.unidentified, $record)
   eval append($jianghu_result.summary.unidentified, $record.summary)
   return $record
end

# 使用既有任务分发给出的稳定类型 key，位置和 OCR 原文都不是任务身份。
# 条件只过滤结果写入，不改变原有刷新、动作、领奖或补扫决策。
def identify_jianghu_record($is_rescan, $idx, $text, $allowed)
   eval $task_key = $jianghu_item.task
   if $is_rescan
      if $task_key is_empty or has_key($jianghu_result.tasks, $task_key) or not $allowed or $task_key == "juezhanglin"
         eval $jianghu_item = {}
         return 0
      end
   else
      if $task_key is_empty
         return 0
      end
      eval remove($jianghu_result.unidentified, $jianghu_item)
      eval remove($jianghu_result.summary.unidentified, $jianghu_item.summary)
   end
   eval $jianghu_item.task_text = $text
   if not has_key($jianghu_result.tasks, $task_key)
      eval append($jianghu_result.tasks, $task_key, {"task_name": $jianghu_item.task_name, "records": []})
      eval append($jianghu_result.summary.tasks, $task_key, {"name": $jianghu_item.task_name, "records": []})
   end
   eval $task_group = $jianghu_result.tasks.$task_key
   eval append($task_group.records, $jianghu_item)
   eval $summary_group = $jianghu_result.summary.tasks.$task_key
   eval append($summary_group.records, $jianghu_item.summary)
   return 0
end

def record_jianghu_task($key, $name)
   if $jianghu_item
      eval $jianghu_item.task = $key
      eval $jianghu_item.task_name = $name
   end
end

def record_jianghu_outcome($outcome, $reason)
   if $jianghu_item
      eval $jianghu_item.outcome = $outcome
      eval $jianghu_item.reason = $reason
      log debug "号令 " + $jianghu_item.task_name + "：" + $outcome + " " + $reason
      eval $jianghu_item.summary.status = $outcome
      if not $reason is_empty
         call $description = jianghu_reason_text($reason)
         eval $jianghu_item.summary.reason = $description
      else
         eval del_key($jianghu_item.summary, "reason")
      end
      if $outcome == "executing"
         eval $jianghu_item.action.status = "running"
      else if $outcome == "blocked" or $outcome == "failed"
         eval $jianghu_item.action.status = $outcome
         eval $jianghu_item.action.reason = $reason
      else if $outcome == "disabled" or $outcome == "not_implemented"
         eval $jianghu_item.action.status = "skipped"
         eval $jianghu_item.action.reason = $reason
      else if $outcome == "executed_unverified"
         eval $jianghu_item.action.status = "executed"
      end
      if $outcome == "completed"
         if $jianghu_item.action.status == "blocked" or $jianghu_item.action.status == "failed"
            call $problem = jianghu_reason_text($jianghu_item.action.reason)
            eval $jianghu_item.summary.problem = $problem
         end
      end
   end
end

def record_jianghu_action_returned()
   if $jianghu_item and $jianghu_item.outcome == "executing"
      call record_jianghu_outcome("executed_unverified", "completion_not_checked")
   end
end

def record_jianghu_completion($completion, $refresh_icon)
   if $jianghu_item
      eval $jianghu_item.completion = $completion
      eval $jianghu_item.refresh_icon_after = $refresh_icon
   end
end

def record_jianghu_reward($status, $reason)
   if $jianghu_item
      eval $jianghu_item.reward.status = $status
      eval $jianghu_item.reward.reason = $reason
      log debug "号令领奖 " + $jianghu_item.task_name + "：" + $status + " " + $reason
      if $status != "task_incomplete" and $status != "disabled" and $status != "not_checked"
         eval $jianghu_item.summary.reward = $status
      end
   end
end

def record_jianghu_failure($reason)
   eval $jianghu_result.summary.status = "failed"
   call $description = jianghu_reason_text($reason)
   eval $jianghu_result.summary.reason = $description
   eval $jianghu_result.status = "failed"
   eval $jianghu_result.reason = $reason
   eval $jianghu_result.finished = true
end

def finish_jianghu_result()
   eval $counts = {}
   eval $status = "skipped"
   eval $records = []
   for record in $jianghu_result.unidentified
      eval append($records, $record)
   end
   for task_key in keys($jianghu_result.tasks)
      eval $task_group = $jianghu_result.tasks.$task_key
      for record in $task_group.records
         eval append($records, $record)
      end
   end
   for record in $records
      eval $outcome = $record.outcome
      eval $count = 0
      if has_key($counts, $outcome)
         eval $count = $counts.$outcome
      end
      eval append($counts, $outcome, $count + 1)
      if $record.outcome != "disabled" and $record.outcome != "already_done"
         if $status == "skipped"
            eval $status = "success"
         end
         if $record.outcome != "completed"
            eval $status = "partial"
         end
      end
      if $record.action.status == "blocked" or $record.action.status == "failed"
         eval $status = "partial"
      end
      if $record.reward.status == "reward_unknown" or $record.reward.status == "progress_unknown" or $record.reward.status == "claim_attempted"
         eval $status = "partial"
      end
   end
   if $status == "skipped" and has_key($counts, "already_done")
      if $counts.already_done == len($records)
         eval $status = "already_done"
      end
   end
   if $jianghu_result.cleanup.mode == "failed"
      eval $status = "failed"
      eval $jianghu_result.reason = "mode_restore_failed"
   end
   eval $jianghu_result.counts = $counts
   eval $jianghu_result.summary.status = $status
   if not $jianghu_result.reason is_empty
      call $description = jianghu_reason_text($jianghu_result.reason)
      eval $jianghu_result.summary.reason = $description
   end
   eval $jianghu_result.status = $status
   eval $jianghu_result.finished = true
end

# 展示解释只属于结果，不参与任务判断。
def jianghu_reason_text($reason)
   eval $descriptions = {"action_not_implemented": "暂未实现", "user_disabled": "未启用", "completed_before_processing": "执行前已完成", "completed_during_refresh": "刷新时已完成", "completion_not_checked": "执行后未确认完成", "completion_observed": "已确认完成", "refresh_icon_present": "仍未完成", "refresh_limit": "达到刷新上限", "reading_not_entered": "未进入阅读", "item_not_found": "未找到黄泉酿", "use_button_not_found": "未找到食用按钮", "item_navigation_failed": "背包导航失败", "profile_declaration_failed": "档案声明失败", "mode_restore_failed": "恢复单人模式失败", "initial_page_failed": "初始页面检查失败", "first_pass_page_failed": "首轮页面检查失败", "rescan_page_failed": "补扫页面检查失败", "rescan_processing_failed": "补扫处理失败", "page_check_failed": "号令页面检查失败"}
   if has_key($descriptions, $reason)
      return $descriptions.$reason
   end
   return $reason
end
