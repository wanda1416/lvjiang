{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Workflow DSL",
  "scopeName": "source.wf",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#ranges"
    },
    {
      "include": "#scene-refs"
    },
    {
      "include": "#keywords-control"
    },
    {
      "include": "#keywords-instruction"
    },
    {
      "include": "#keywords-clause"
    },
    {
      "include": "#keywords-timing"
    },
    {
      "include": "#keywords-wait-stable"
    },
    {
      "include": "#keywords-match"
    },
    {
      "include": "#keywords-boolean"
    },
    {
      "include": "#keywords-direction"
    },
    {
      "include": "#keywords-special"
    },
    {
      "include": "#labels"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.wf",
          "match": "#%.*$"
        },
        {
          "name": "comment.line.number-sign.wf",
          "match": "#(?!%).*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.wf",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.wf",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.wf",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    "variables": {
      "name": "variable.other.wf",
      "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
    },
    "ranges": {
      "name": "constant.other.range.wf",
      "match": "\\[[0-9]+\\.\\.\\.[0-9]+\\]"
    },
    "scene-refs": {
      "name": "entity.name.tag.wf",
      "match": "\\[(?!\\d+\\.\\.\\.)[^\\]]+\\](?:\\.\\[(?!\\d+\\.\\.\\.)[^\\]]+\\])*"
    },
    "keywords-control": {
      "name": "keyword.control.wf",
      "match": "\\b(if|else|end|for|in|loop|while|until|break|continue|return|goto|try|catch)\\b"
    },
    "keywords-instruction": {
      "name": "keyword.operator.wf",
      "match": "\\b(click|drag|wait|scan|recognize|collect|log|screenshot|eval|default|align|find|import|def|call)\\b"
    },
    "keywords-clause": {
      "name": "keyword.operator.wf",
      "match": "\\b(as|by|where|on|group|hold)\\b"
    },
    "keywords-timing": {
      "name": "keyword.other.timing.wf",
      "match": "\\b(before|after|around)\\b"
    },
    "keywords-wait-stable": {
      "name": "keyword.other.wait-stable.wf",
      "match": "\\b(stable|threshold|interval|duration|least)\\b"
    },
    "keywords-match": {
      "name": "keyword.operator.match.wf",
      "match": "\\b(equals_any|contains_any|equals|contains)\\b"
    },
    "keywords-boolean": {
      "name": "constant.language.wf",
      "match": "\\b(true|false|null|not|and|or|is_empty)\\b"
    },
    "keywords-direction": {
      "name": "keyword.other.direction.wf",
      "match": "\\b(up|down|left|right)\\b"
    },
    "keywords-special": {
      "name": "keyword.other.special.wf",
      "match": "\\b(session|context)\\b"
    },
    "labels": {
      "name": "entity.name.label.wf",
      "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
    }
  }
}
