#% name: 导航至装备页

# 从主界面导航到装备培养页面
# 路径：主界面 → 菜单 → 包裹 → 培养（如不在装备页则自动切换）
# 前置：在主界面或菜单页
# 后置：在背包装备页（bag_equip_detail）

def nav_main_to_equip()
    # 检查当前是否在菜单页
    scan [game_menu_page].[wulinlu] as $result
    if not $result.[wulinlu] equals "武林录"
        # 不在菜单页，从主界面进入菜单
        click [game_main_page].[menu] after wait page_refresh_wait
    else
        log "当前已在菜单页"
    end

    # 菜单页 → 背包页
    click [game_menu_page].[baoguo] after wait page_refresh_wait

    # 检查是否在装备页（可能开包裹后在道具页等其他页面）
    scan [bag_equip_detail].[sub_equip] as $bag_scan
    if not $bag_scan.sub_equip contains "装备"
        # 不在装备页，点击培养切换
        click [bag_equip_detail].[peiyang] after wait page_refresh_wait
    end
end
