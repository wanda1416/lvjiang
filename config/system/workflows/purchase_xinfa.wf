#% name: 自动购买心法

# 自动购买心法流程
#
# 流程结构：
#   1. 导航：从首页 → 菜单 → 培养 → 功法 → 心法 → 置换
#   2. 循环购买：
#      a. 扫描 5 个散本槽位，寻找含"自选"标记的槽位
#      b. 未找到 → 返回并结束
#      c. 先执行回收，清空已有心法（避免书票不足或心法过多）
#      d. 点击目标槽位 → 全部添加 → 购买
#      e. 检查是否出现确认弹窗（未出现说明书票不足）→ 返回并结束
#      f. 最大数量添加 → 确认购买 → 点击空白处重置
#   3. 重复步骤 2 直到无法继续购买

# ─── 导航：从首页到心法置换视图 ─────────────────────────
click [game_main_page].[menu] after wait @page_refresh

scan [game_menu_page].[peiyang] as $nav_check by contains "培养"
if not $nav_check
    eval pause("未找到「培养」入口，请确认当前在菜单页后点击继续")
end
click [game_menu_page].[peiyang] after wait @page_refresh

click [training_main].[gongfa] after wait @step_interval
click [training_main].[xinfa] after wait @page_refresh
click [training_xinfa].[exchange] after wait @page_refresh

scan [training_xinfa].[exchange] as $nav_check by contains "心得置换"
if not $nav_check
    eval pause("未进入心得置换页面，请手动导航后点击继续")
end

# ─── 返回导航 ────────────────────────────────────────────
def go_back()
    click [training_xinfa].[back] after wait @page_refresh
    click [training_main].[back] after wait @page_refresh
    click [game_menu_page].[back] after wait @page_refresh
end

# 循环购买心法
loop while 1 == 1
    # 检查有没有找到自选标记
    wait @step_interval
    scan [training_xinfa].[sanben_1,sanben_2,sanben_3,sanben_4,sanben_5] as $zixuan by contains "自选"
    if not $zixuan
       log "找不到自选散本，结束"
       call go_back()
       return -1
    end

    # 先走一遍回收，避免书票不足，心法过多
    click [training_xinfa].[count] after wait @step_interval
    click [training_xinfa].[recycle_entry] after wait @step_interval
    click [training_xinfa].[recycle] after wait @step_interval
    click [training_xinfa].[confirm] after wait @page_refresh

    click [training_xinfa].$zixuan after wait @step_interval
    click [training_xinfa].[add_all] after wait @step_interval
    click [training_xinfa].[purchase] after wait @page_refresh

    # 检查购买后是否出现确认按钮（未出现则数量不足）
    scan [training_xinfa].[confirm] as $confirm by contains "确认"
    if not $confirm
       log "书票数量不足，结束"
       call go_back()
       return -1
    end

    click [training_xinfa].[add_max] after wait @step_interval
    click [training_xinfa].[confirm] after wait @page_refresh

    click [training_xinfa].[blank] after wait @step_interval
end