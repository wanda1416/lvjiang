#% name: 纯逻辑集合过程

# 保留首次出现顺序，不修改原列表。判重用 ==，因此按类型判等：数字与其字符串
# 形态视为同一个值（3 与 "3"），布尔只与布尔相等、null 只与 null 相等，
# false 与 0、null 与 false 都是不同的值。列表与字典元素不参与判重（== 对它们
# 恒假），需要去重嵌套结构时先自行投影成标量。
def unique($items)
    eval $result = []
    for item in $items
        eval $found = false
        for existing in $result
            if $item == $existing
                eval $found = true
                break
            end
        end
        if not $found
            eval append($result, $item)
        end
    end
    return $result
end

# 只展开一层，内层元素原样保留。
def flatten_once($groups)
    eval $result = []
    for group in $groups
        for item in $group
            eval append($result, $item)
        end
    end
    return $result
end

# 按正整数 size 分块；size <= 0 返回空列表。
def chunk($items, $size)
    eval $result = []
    if $size <= 0
        return $result
    end
    eval $start = 0
    loop while $start < len($items)
        eval $part = slice($items, $start, $start + $size - 1)
        eval append($result, $part)
        eval $start = $start + $size
    end
    return $result
end

# 按字典中的非空字符串字段分组；缺少字段的行不进入结果。
def group_by_key($rows, $key)
    eval $result = {}
    for row in $rows
        eval $group = $row.$key
        if $group
            if not has_key($result, $group)
                eval append($result, $group, [])
            end
            eval $members = $result.$group
            eval append($members, $row)
        end
    end
    return $result
end
