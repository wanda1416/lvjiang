#% name: 导航子过程集合

# 通用导航子过程库
# 提供页面间导航的原子操作，供各工作流 import 后调用。
# 页面状态判断是本文件的直接依赖，由 page_detection.wf 提供。
#
# 包含过程：
#   nav_main_to_bag()    — 主界面 → 背包页（>=0 成功，<0 导航失败）
#   nav_main_to_equip()  — 主界面 → 背包装备列表页（0 成功，-1 失败）
#   nav_main_to_wallet() — 主界面 → 背包钱袋页（0 成功，-1 失败）
#   nav_main_to_item()   — 主界面 → 背包道具页（0 成功，-1 失败）
#   nav_main_to_menu()   — 主界面 → 菜单页（0 成功，-1 失败）
#   nav_main_to_role()   — 主界面 → 角色详情页（0 成功，-1 失败）
#   nav_back_to_main()   — 背包装备页 → 主界面（0 成功，-1 失败）
#   nav_equip_to_tune()  — 装备详情页 → 调律页（0 成功，-1 失败）

import "subcall/page_detection.wf"

# ─── nav_main_to_bag ──────────────────────────────────────
# 从主界面导航到背包页面
# 路径：主界面 → 菜单 → 包裹
# 前置：在主界面或菜单页
# 后置：在背包页（bag_equip_detail），通过 sub_baoguo 判定当前 tab
# 返回：1=培养, 2=道具, 3=任务, 4=钱袋；0=已确认在背包页但 tab 未识别；-1=失败

def nav_main_to_bag()
    call $in_bag = is_in_bag_page()
    # 如果已经在背包页就不用操作
    if $in_bag
        log info "当前已在背包页"
    else
        if env("desktop")
            # 桌面端：简单处理，主页、菜单页 均通过 B 进入背包
            log info "桌面端：按 B 打开背包"
            press "B" after wait @step_interval
        else
            # 安卓端：检查当前是否在菜单页
            call $in_menu = is_in_menu_page()
            if $in_menu
                log info "当前已在菜单页"
            else
                # 不在菜单页，检查是否在主页
                call $in_main = is_in_main_page()
                if $in_main
                    log info "从主页进入菜单页"
                    click [game_main_page].[menu] after wait @page_refresh
                else
                    eval pause("未进入菜单页面，请手动导航后点击继续")
                end
            end

            # 菜单页 → 背包页
            log info "从菜单页进入包裹页"
            click [game_menu_page].[baoguo] after wait @page_refresh
        end
    end

    # 通过 sub_baoguo 判定当前 tab
    scan [bag_equip_detail].[sub_baoguo] as $tab_text
    eval $tab = 0
    if $tab_text.sub_baoguo contains "培养"
        eval $tab = 1
    end
    if $tab_text.sub_baoguo contains "道具"
        eval $tab = 2
    end
    if $tab_text.sub_baoguo contains "任务"
        eval $tab = 3
    end
    if $tab_text.sub_baoguo contains "钱袋"
        eval $tab = 4
    end

    if $tab == 0
        # tab 未识别，通过 zhengli 区域二次确认是否在背包页
        scan [bag_equip_detail].[zhengli] as $zhengli_text
        if $zhengli_text.zhengli contains "整理"
            log info "通过整理按钮确认在背包页"
        else
            log error "未进入包裹页面"
            eval $tab = -1
        end
    end

    return $tab
end

# ─── nav_main_to_equip ────────────────────────────────────
# 从主界面导航到装备页面
# 路径：主界面 → 菜单 → 包裹 → 培养 → 装备列表
# 前置：在主界面或菜单页
# 后置：在装备列表页（bag_equip_detail 培养 tab）

def nav_main_to_equip()
    call $tab = nav_main_to_bag()
    if $tab < 0
        return -1
    end

    # 不在培养 tab 则点击切换
    if $tab != 1
        log info "从包裹页切换到培养页"
        click [bag_equip_detail].[peiyang] after wait @page_refresh
    end
    # 幂等点击，没必要额外判断
    click [bag_equip_detail].[sub_equip] after wait @step_interval

    # 最终校验
    scan [bag_equip_detail].[recycle] as $recycle_check by contains "回收"
    if not $recycle_check
        eval pause("未进入装备列表，请手动导航后点击继续")
        scan [bag_equip_detail].[recycle] as $recycle_check by contains "回收"
        if not $recycle_check
            return -1
        end
    end
    return 0
end

# ─── nav_main_to_wallet ───────────────────────────────────
# 从主界面导航到背包钱袋页面
# 路径：主界面 → 菜单 → 包裹 → 钱袋
# 前置：在主界面或菜单页
# 后置：在背包钱袋页（bag_wallet_detail）

def nav_main_to_wallet()
    call $tab = nav_main_to_bag()
    if $tab < 0
        return -1
    end

    # 不在钱袋 tab 则点击切换
    if $tab != 4
        log info "从包裹页切换到钱袋页"
        click [bag_equip_detail].[qiandai] after wait @page_refresh
    end

    # 校验是否到达钱袋页
    scan [bag_equip_detail].[sub_baoguo] as $wallet_check by contains "钱袋"
    if not $wallet_check
        eval pause("未进入钱袋页面，请手动导航后点击继续")
        scan [bag_equip_detail].[sub_baoguo] as $wallet_check by contains "钱袋"
        if not $wallet_check
            return -1
        end
    end
    log info "已到达钱袋页"
    return 0
end

# ─── nav_main_to_item ─────────────────────────────────────
# 从主界面导航到背包道具页的普通道具子区域
# 路径：主界面 → 菜单 → 包裹 → 道具 → 普通道具
# 前置：在主界面或菜单页
# 后置：在背包道具页（bag_item_detail），普通道具子区域已选中

def nav_main_to_item()
    call $tab = nav_main_to_bag()
    if $tab < 0
        return -1
    end

    # 不在道具 tab 则点击切换
    if $tab != 2
        log info "从包裹页切换到道具页"
        click [bag_equip_detail].[item] after wait @page_refresh
    end

    # 道具识别错误率较高，暂时注释掉
    # 校验是否到达道具页
    #scan [bag_equip_detail].[sub_baoguo] as $item_check by contains "道具"
    #if not $item_check
    #    eval pause("未进入道具页面，请手动导航后点击继续")
    #end

    # 点击普通道具，锁定子区域
    log info "从道具页进入普通道具"
    click [bag_item_detail].[putong] after wait @step_interval
    return 0
end

# ─── nav_main_to_menu ─────────────────────────────────────
# 从主页进入菜单页；若已在菜单页则不执行操作
# 前置：在主页或菜单页
# 后置：在菜单页

def nav_main_to_menu()
    call $in_menu = is_in_menu_page()
    if $in_menu
        return 0
    end
    if env("android")
        click [game_main_page].[menu] after wait @page_refresh
    else
        press "ESC" after wait @page_refresh
    end
    call $in_menu = is_in_menu_page()
    if not $in_menu
        eval pause("未进入菜单页面，请手动导航后点击继续")
        call $in_menu = is_in_menu_page()
        if not $in_menu
            return -1
        end
    end
    return 0
end

# ─── nav_main_to_role ─────────────────────────────────────
# 从主界面导航到角色详情页
# 路径：主界面 → 菜单 → 角色（在菜单项列表里查找，找不到翻一页再找）
# 前置：在主界面或菜单页
# 后置：在角色详情页（role_detail）
# 返回：-1 表示彻底找不到「角色」入口（已 pause 提示手动介入过）

def nav_main_to_role()
    call $in_menu = nav_main_to_menu()
    if $in_menu < 0
        return -1
    end

    find [game_menu_page].[menu] as $found by contains "角色"
    if not $found
        # 翻一页再找
        drag [general_control].[menu_up] after wait @step_interval
        find [game_menu_page].[menu] as $found by contains "角色"
    end
    if not $found
        log "找不到「角色」，请手动定位后继续"
        eval pause("找不到「角色」，请手动定位到角色入口后点击确定")
        find [game_menu_page].[menu] as $found by contains "角色"
    end
    if not $found
        log "仍未找到「角色」，无法进入角色详情页"
        return -1
    end

    click $found after wait @page_refresh
    return 0
end

# ─── nav_back_to_main ─────────────────────────────────────
# 从背包装备页返回主界面
# 检测式返回：循环检测是否在背包页，点击返回直到离开背包页，再从菜单页返回主界面
# 前置：在背包页（bag_equip_detail 场景内）
# 后置：在主界面

def nav_back_to_main()
    eval $is_android = env("android")

    eval $tries = 0
    loop while $tries < 3
        call $in_bag = is_in_bag_page()
        if $in_bag
            if $is_android
                click [bag_equip_detail].[back] after wait @step_interval
            else
                press "ESC" after wait @step_interval
            end
        else
            break
        end
        eval $tries = $tries + 1
    end

    call $in_menu = is_in_menu_page()
    if $in_menu
        if $is_android
            click [game_menu_page].[back] after wait @step_interval
        else
            press "ESC" after wait @step_interval
        end
    end

    call $in_main = is_in_main_page()
    if not $in_main
        eval confirm("当前未回到主页，请手动回到主页后点击确定")
        call $in_main = is_in_main_page()
        if not $in_main
            return -1
        end
    end
    return 0
end

# ─── nav_equip_to_tune ────────────────────────────────────
# 从装备详情页进入调律页面
# android：展开「更多」弹窗 → 扫描次功能按钮找「调律」→ 点击进入
# desktop：直接扫描功能按钮区找「调律」→ 按 F 进入调律详情页
# 前置：在装备详情页（equip_detail）
# 后置（成功）：在调律详情页（equip_tune_detail）
# 后置（失败）：仍在装备详情页（android 弹窗已收起）

def nav_equip_to_tune()
    if env("desktop")
        # 桌面端：直接扫描检查是否存在调律，有的话按 F 进入
        scan [equip_detail].[func_area] as $tune_key by contains "调律"
        if not $tune_key
            log "桌面端：未找到调律入口"
            return -1
        end

        log info "桌面端：找到调律入口，按 F 进入调律详情页"
        press "F" after wait @page_refresh
    else
        # 展开「更多」弹窗
        click [equip_detail].[more_func] after wait @page_refresh

        # 在次功能按钮中寻找「调律」
        scan [equip_detail].[sub_func_1, sub_func_2, sub_func_3, sub_func_4] as $tune_key by contains "调律"
        if not $tune_key
            log "未找到调律按钮"
            # 再次点击 more_func 收起弹窗，保持页面干净
            click [equip_detail].[more_func] after wait @step_interval
            return -1
        end

        # 点击调律按钮，进入调律页
        log info "从装备详情页进入调律页"
        click [equip_detail].$tune_key after wait @page_refresh
    end

    # 校验是否到达调律页
    scan [equip_tune_detail].[tune_btn] as $tune_check by contains "词库预览"
    if not $tune_check
        eval pause("未进入调律页面，请手动导航后点击继续")
        scan [equip_tune_detail].[tune_btn] as $tune_check by contains "词库预览"
        if not $tune_check
            return -1
        end
    end
    log info "已到达调律页"
    return 0
end
