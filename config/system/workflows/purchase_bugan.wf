#% name: 自动购买不肝
#% env: [android, desktop]

# 自动购买不肝商店商品
#
# 流程结构：
#   1. 导航：首页 → 菜单 → 不肝 → 切换到不肝商店视图
#   2. 战斗养成（默认类目）：依次处理两个商品面板（各 2 行 × 4 列），
#      整面板 OCR 扫描 → 逐格判断是否命中购买关键词 → 命中则购买
#      商品1 处理完后，商品2 上滑 2 行再处理
#   3. 营生（cat_4）：扫描 (1,1) 确认含「营生」后才购买
#   5. 赛季（cat_5）：shangpin_1 全部 2×4 格各购买一次
#   6. 目前外观拖动存在问题，暂时忽略
#   7. 完成后返回主页
#
# 购买动作统一为：点击格子 → 全部添加 → 购买

# ─── 配置：战斗养成要购买的商品类目（新增类目直接在此追加） ────
eval $buy_keywords = ["心法", "武学", "奇术", "生活", "宝钱", "短陌钱"]

import "subcall/game_profile.wf"

# ─── 导航：从首页到不肝商店视图 ─────────────────────────
if env("android")
    click [game_main_page].[menu] after wait @page_refresh
else if env("desktop")
    press "ESC" after wait @page_refresh
end

scan [game_menu_page].[bugan] as $nav_check by contains "不肝"
if not $nav_check
    eval pause("未找到「不肝」入口，请确认当前在菜单页后点击继续")
end
click [game_menu_page].[bugan] after wait @page_refresh

# ─── 获取本周不肝进度 ──────────────────────────────────
click [bugan_detail].[bugan_view] after wait @step_interval
scan [bugan_detail].[bugan_jindu] as $jindu_str
call parse_bugan_jindu($jindu_str.bugan_jindu)

# 领取不肝进度奖励
scan [bugan_detail].[purchase] as $found by contains "全部领取"
if $found
    click [bugan_detail].[purchase] after wait @step_interval
    click [general_action].[space_area] after wait @step_interval
    log "领取本周不肝奖励"
end

click [bugan_detail].[shop] after wait @page_refresh

scan [bugan_detail].[liebiao] as $nav_check by contains "战斗养成"
if not $nav_check
    eval pause("未进入商店购买区域，请确认当前在不肝商店后点击继续")
end

if env("android")
    # ─── 战斗养成：依次购买两个商品面板 ─────────────────────
    call buy_panel("shangpin_1", $buy_keywords)
    drag [bugan_detail].[shangpin_1] up 2 after wait @step_interval
    call buy_panel("shangpin_2", $buy_keywords)
else if env("desktop")
    # PC 端可以展示 3行，直接买全部即可
    call buy_panel("shangpin_1", $buy_keywords)
end

# ─── 营生：只买第一格（先确认格子内容是营生） ────────────
click [bugan_detail].[cat_4] after wait @page_refresh
scan [bugan_detail].[shangpin_1][1][1] as $cat4_cell
if $cat4_cell contains "营生"
   call buy_cell("shangpin_1", 1, 1)
else
   log "营生 (1,1) 未命中，跳过购买"
end

# ─── 赛季：shangpin_1 全部 2×4 格子买一遍 ───
click [bugan_detail].[cat_5] after wait @page_refresh
scan [bugan_detail].[shangpin_1] as $season_grid
for r in [1, 2]
    for c in [1, 2, 3, 4]
        eval $cell = $season_grid.$r.$c
        call $reason = buy_block_reason($cell)
        if $reason
            log "赛季追赶 行" + $r + "列" + $c + " " + $reason + "，跳过"
            continue
        end
        call buy_cell("shangpin_1", $r, $c)
    end
end

# ─── 返回主页 ──────────────────────────────────────────
click [bugan_detail].[back] after wait @step_interval
click [game_menu_page].[back] after wait @step_interval
log "不肝商店购买流程结束。"

# ─── 关键词命中判断 ────────────────────────────────────
# 返回文本中命中的第一个关键词，未命中返回 ""
def match_keyword($text, $keywords)
    for kw in $keywords
        if $text contains $kw
            return $kw
        end
    end
    return ""
end

# ─── 判断商品格子是否可购买 ────────────────────────────
# 返回不可购买原因（"库存不足"/"条件不足"），可购买返回 ""
def buy_block_reason($cell)
    if $cell contains "库存不足"
        return "库存不足"
    end
    if $cell contains "条件不足"
        return "条件不足"
    end
    return ""
end

# ─── 购买单个格子：点击格子 → 全部添加 → 购买 ─────────
def buy_cell($panel_key, $r, $c)
    click [bugan_detail].$panel_key[$r][$c] after wait @step_interval
    click [bugan_detail].[add_all] after wait @step_interval
    click [bugan_detail].[purchase] after wait @step_interval
end

# ─── 按关键词购买单个商品面板 ──────────────────────────
# 整面板 OCR 后逐格判断，命中目标类目则购买
# 行数从 panel 实际检测结果读取（PC 端可显示 3 行）
def buy_panel($panel_key, $keywords)
    scan [bugan_detail].$panel_key as $grid
    eval $rows = panel_rows("bugan_detail", $panel_key)
    for r in range(1, $rows)
        for c in [1, 2, 3, 4]
            eval $cell = $grid.$r.$c
            call $hit = match_keyword($cell, $keywords)
            if not $hit
                continue
            end
            call $reason = buy_block_reason($cell)
            if $reason
                log "战斗养成 [" + $panel_key + "] 行" + $r + "列" + $c + " " + $reason + "，跳过"
                continue
            end
            log "命中商品 [" + $panel_key + "] 行" + $r + "列" + $c + " (" + $hit + "): " + $cell
            call buy_cell($panel_key, $r, $c)
        end
    end
end
