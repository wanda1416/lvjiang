// 工作流 DSL v2 - Lark 语法文件
//
// 关键约定：
// - [name] / [name].[name] → 静态配置引用（场景名/区域名），来自 yaml
// - $name → 运行时变量引用，来自 variables dict
// - 两者在语法层面完全不交叉，无歧义

start: (_NL | statement)*

// ─── 语句分派 ─────────────────────────────────────────────

?statement: click_stmt
          | drag_stmt
          | wait_stmt
          | scan_stmt
          | recognize_stmt
          | find_stmt
          | collect_stmt
          | log_stmt
          | eval_stmt
          | call_stmt
          | if_stmt
          | for_stmt
          | loop_stmt
          | break_stmt
          | return_stmt
          | label_stmt
          | goto_stmt

// ─── 基础指令 ─────────────────────────────────────────────

click_stmt: "click"i click_target _NL

click_target: bracket_expr "." bracket_expr   // 静态 [scene].[region]
            | bracket_expr "." bracket_var     // 动态 region [scene].[$var]
            | var_ref                          // 动态 $var（find 产出的坐标）

drag_stmt: "drag"i bracket_expr "." bracket_expr drag_duration? drag_hold? _NL

drag_duration: number | bracket_list

drag_hold: "hold"i number

wait_stmt: "wait"i (NAME | number | bracket_expr) _NL

scan_stmt: "scan"i bracket_expr field_list? "as"i var_ref _NL

recognize_stmt: "recognize"i bracket_expr field_list? "as"i var_ref _NL

find_stmt: "find"i var_ref (STRING | var_ref) "as"i var_ref error_clause? _NL

error_clause: "error"i STRING

collect_stmt: "collect"i var_ref collect_as_clause? _NL

collect_as_clause: "as"i STRING

log_stmt: "log"i (STRING | func_call) _NL

eval_stmt: "eval"i "$" NAME "=" NAME "(" arg_list? ")" _NL    -> eval_assign_func
         | "eval"i "$" NAME "=" literal _NL                    -> eval_assign_lit
         | "eval"i "$" NAME "." NAME "=" eval_rhs _NL          -> eval_field_assign
         | "eval"i NAME "(" arg_list? ")" _NL                  -> eval_discard

eval_rhs: NAME "(" arg_list? ")"  -> eval_rhs_func
        | literal                   -> eval_rhs_lit

func_call: NAME "(" arg_list? ")"

arg_list: arg ("," arg)*

?arg: STRING -> arg_lit
    | field_access -> arg_field
    | var_ref -> arg_var

// ─── 子工作流调用 ──────────────────────────────────────────

call_stmt: "call"i STRING call_with_clause? call_read_clause? _NL

call_with_clause: "with"i call_arg ("," call_arg)*

call_arg: var_ref "as"i NAME

call_read_clause: "read"i call_read_item ("," call_read_item)*

call_read_item: STRING "as"i var_ref

// ─── 控制流 ───────────────────────────────────────────────

if_stmt: "if"i condition _NL statement* else_clause? "end"i _NL

else_clause: "else"i _NL statement*

for_stmt: "for"i NAME "in"i bracket_list _NL statement* "end"i _NL

loop_stmt: "loop"i (number | NAME) _NL statement* "end"i _NL

break_stmt: "break"i _NL

return_stmt: "return"i _NL

label_stmt: "@" NAME _NL

goto_stmt: "goto"i NAME _NL

// ─── 条件表达式（优先级：or < and < not < atom）──────────

?condition: or_cond

?or_cond: and_cond -> cond_passthrough
        | or_cond "or"i and_cond -> or_op

?and_cond: not_cond
         | and_cond "and"i not_cond -> and_op

?not_cond: cond_atom -> cond_passthrough
         | "not"i cond_atom -> not_op

?cond_atom: field_access "contains"i STRING -> contains_op
          | field_access "equals"i STRING -> equals_op
          | field_access "in"i bracket_list -> in_op
          | field_access "is_empty"i -> is_empty_op
          | field_access ">" number -> gt_op
          | field_access "<" number -> lt_op
          | field_access ">=" number -> ge_op
          | field_access "<=" number -> le_op
          | field_access "!=" number -> ne_op
          | field_access "==" number -> eq_num_op
          | var_ref -> var_cond

// $var.field 支持链式访问：$var.f1.f2.f3
field_access: field_access "." NAME -> field_chain
            | var_ref "." NAME -> field_base

// 数值字面量：支持负数，统一为 number（float）
?number: FLOAT -> number_float
       | INT -> number_int
       | "-" FLOAT -> number_neg_float
       | "-" INT -> number_neg_int

// 任意字面量（用于 eval 赋值右侧）
?literal: STRING
        | number
        | "{" "}" -> empty_dict

// ─── 通用原子 ─────────────────────────────────────────────

var_ref: "$" NAME

bracket_expr: "[" NAME "]"

bracket_var: "[" var_ref "]"   // [$var] 动态引用

// 逗号分隔列表：用于 for 迭代源和 in 条件
// 元素可以是裸 NAME 或 "字符串"，统一视为字面量
bracket_list: "[" [bracket_item ("," bracket_item)*] "]"

?bracket_item: NAME | STRING | number

field_list: "." "[" NAME ("," NAME)* "]"

// ─── 词法 ─────────────────────────────────────────────────

STRING: "\"" /[^"\n]*/ "\""
NAME: /[a-zA-Z_\u4e00-\u9fff][a-zA-Z0-9_\u4e00-\u9fff]*/
FLOAT: /[0-9]+\.[0-9]+/
INT: /[0-9]+/

COMMENT: /#[^\n]*/
_NL: /(\s*\n)+/

%ignore COMMENT
%ignore /[ \t]+/
