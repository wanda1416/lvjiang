#% name: 纯逻辑数值过程

# 纯逻辑数值过程库：整数运算与前缀和，供各工作流 import 后调用。
# 只做算术，不做识别、点击，也不读写配置或 profile。
#
# 包含过程：
#   gcd($a, $b)         — 整数最大公约数
#   prefix_sums($items) — 逐位累加和

# ─── gcd ──────────────────────────────────────────────────
# 整数最大公约数。
#
# 参数：
#   $a、$b — 任意整数，允许负数与零
# 前置：无。
# 后置：无副作用。
# 返回：gcd；gcd(0, 0) = 0，任一侧为 0 时返回另一侧的绝对值。
def gcd($a, $b)
    eval $left = abs($a)
    eval $right = abs($b)
    loop while $right != 0
        eval $remainder = mod($left, $right)
        eval $left = $right
        eval $right = $remainder
    end
    return $left
end

# ─── prefix_sums ──────────────────────────────────────────
# 每个位置的累加和。
#
# 参数：
#   $items — 数字列表
# 前置：无。
# 后置：无副作用（不修改 $items）。
# 返回：新列表，输出长度与输入相同；空列表返回空列表。
def prefix_sums($items)
    eval $result = []
    eval $total = 0
    for item in $items
        eval $total = $total + $item
        eval append($result, $total)
    end
    return $result
end
