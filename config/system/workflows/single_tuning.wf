#% name: 单次调律
#% required_scenes: [game_main_page, game_menu_page, bag_equip_detail, equip_weapon_detail, equip_tune_detail, equip_tune_result]
#% parameters:
#%   - name: target_material
#%     label: 目标材料
#%     type: select
#%     default: 紫色狗粮
#%     options:
#%       - { value: "", label: 不添加 }
#%       - { value: 紫色狗粮, label: 紫色狗粮 }
#%       - { value: 金色狗粮, label: 金色狗粮 }
#%       - { value: 彩色狗粮, label: 彩色狗粮 }
#%   - name: equip_slot
#%     label: 装备部位
#%     type: select
#%     default: main_weapon
#%     options:
#%       - { value: main_weapon, label: 主武器 }
#%       - { value: sub_weapon, label: 副武器 }
#%       - { value: ring, label: 环 }
#%       - { value: pendant, label: 佩 }
#%       - { value: head, label: 头部 }
#%       - { value: chest, label: 衣服 }
#%       - { value: leg, label: 鞋子 }
#%       - { value: wrist, label: 护腕 }
#%   - name: bag_row
#%     label: 背包行号
#%     type: select
#%     default: "1"
#%     options: ["1", "2", "3"]
#%   - name: bag_col
#%     label: 背包列号
#%     type: select
#%     default: "1"
#%     options: ["1", "2", "3", "4", "5"]

# 单次调律工作流
# 参数：$target_material — 目标材料（由 UI 参数面板注入）
# 参数：$equip_slot — 装备部位（由 UI 参数面板注入）
# 参数：$bag_row, $bag_col — 背包行列（由 UI 参数面板注入）

call "subcall/nav_main_to_equip.wf"

# 点击指定装备部位
click [bag_equip_detail].$equip_slot
wait step_interval

# 拼接背包槽位名：bag_{row}_{col}
eval $bag_slot = concat("bag_", $bag_row, "_", $bag_col)
click [bag_equip_detail].$bag_slot
wait step_interval

scan [equip_weapon_detail].[equip_type, equip_level, base_attr, affix_gong, affix_shang, affix_jue, affix_zhi, affix_yu] as $main_weapon_scan
eval $main_weapon = to_equipment($main_weapon_scan)

if $main_weapon.[_extra].[affix_count] < 5
else 
    log "词条满了，不用调律了"
    loop 2
        click [bag_equip_detail].[back]
        wait step_interval
    end
    click [game_menu_page].[back]
    eval $exit_code = -1
    collect $exit_code
    return
end

eval $result = {}
call "subcall/nav_equip_to_tune.wf" read "status" as $tune_status

if $tune_status
    scan [equip_tune_detail].[one_click_add] as $add_scan
    if $add_scan.one_click_add contains "添加"
        eval $should_tune = "yes"
        if $target_material
            call "subcall/find_tune_material.wf" with $target_material as "material_name" read "slot_name" as $slot
            if $slot
                click [equip_tune_detail].$slot
                wait step_interval
            else
                log concat($target_material, "材料不足，提前结束")
                eval $should_tune = ""
            end
        end
        if $should_tune
            click [equip_tune_detail].[one_click_add]
            wait step_interval
            click [equip_tune_detail].[tune_btn]
            wait step_interval
            wait after_tune_wait
            scan [equip_tune_result] as $result
            log "调律结果已识别"
            click [equip_tune_result].[close_btn]
            wait step_interval
        end
    else
        log "装备已调律完毕，无需调律"
    end
else
    log "未进入调律页面，提前结束"
end

click [equip_tune_detail].[back]
wait step_interval

loop 3
    click [bag_equip_detail].[back]
    wait step_interval
end

click [game_menu_page].[back]
collect $result

eval $exit_code = 0
collect $exit_code
