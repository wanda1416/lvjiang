# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environment
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Tool caches (mypy baseline worktree etc.)
.git-mypy-base/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.testmondata*
# .coverage* 而非 .coverage：pytest-xdist 并行跑覆盖率会产生
# .coverage.<host>.<pid>.<rand> 分片，中断的运行会把它们留在工作区。
.coverage*
coverage.xml

# Logs
logs/

# local config (user overlay / session runtime / 在线下发层)
/config/local*
/config/session*
/config/remote*
/config/system/workflows/_*

# local data
/data/local
/data/video
/data/picture
/data/temp*

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Qoder
.qoder/
# Claude
.claude/

# Android 构建（工具链自包含在 .tooling/，不入库）
.tooling/
android/.gradle/
android/local.properties
android/keystore.properties
*.jks
*.keystore
android/**/build/
android/**/.cxx/

# Kotlin build cache
android/.kotlin/

# VS Code extension build artifacts
editors/vscode/lvjiang-wf/out/
editors/vscode/lvjiang-wf/node_modules/
editors/vscode/lvjiang-wf/*.vsix

# Cloudflare Workers CLI 本地缓存（含账号信息，不进仓库）
ops/stats-worker/.wrangler/

# stats-client 本地缓存/凭据（含 install_id 与本地文件回退的 token，不进仓库）
ops/stats-client/data/
ops/stats-client/.env
