#% name: 太极炸鱼
#% env: [android, desktop]
#% note: |-
#%   PC 端必须关闭后台模式后运行；技能按键无法通过后台模式发送。
#% parameters:
#%   - name: max_loops
#%     label: 最大循环次数
#%     type: number
#%     default: 500
#%     min: 1
#%   - name: skill_key
#%     label: 技能按键
#%     type: select
#%     default: "1"
#%     options: ["1", "2", "3", "4"]

# 太极炸鱼流程
#
# 流程结构：
#   1. 安卓点击轻击 → 奇术；PC 按配置的技能键，启动炸鱼
#   2. 循环等待约 1 秒，共 20 轮
#   3. 回到 zhayu 标签，最多循环 max_loops 次
#
# PC 技能键必须由前台 SendInput 发送，PostMessage 后台模式不生效。

default $max_loops = 500
default $skill_key = "1"

if not $skill_key in ["1", "2", "3", "4"]
   log error "太极炸鱼：技能按键只允许配置 1-4"
   return -1
end

if is_post()
   log error "太极炸鱼：技能按键不支持后台模式，请关闭后台模式后重试"
   return -1
end

eval $loop_count = 0

@zhayu
if env("android")
   click [general_control].[qingji] after wait @step_interval
   click [general_control].[qishu]
else if env("desktop")
   press $skill_key after wait @step_interval
end

loop 20
   wait (1.10,1.15)
end
eval $loop_count = $loop_count + 1
if $loop_count < $max_loops
   goto zhayu
end
log "太极炸鱼已完成 " + $loop_count + " 轮"
