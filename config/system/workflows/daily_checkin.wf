#% name: 每日自动签到
#% runnable: true
#% batchable: true
#% env: [android, desktop]
#% note: |-
#%   左侧活动名称与右侧领奖关键字必须逐行对应。
#% parameters:
#%   - name: activity_names
#%     label: 左侧活动名称（每行一个）
#%     type: text
#%     multiline: true
#%     default: "朝夕共赏"
#%   - name: reward_keywords
#%     label: 右侧领奖关键字（与活动名称逐行对应）
#%     type: text
#%     multiline: true
#%     default: "签到"

# 每日自动签到流程
#
# 流程结构：
#   1. 执行前校验两份逐行对应的活动配置
#   2. 从游戏首页进入菜单 → 活动页面
#   3. 逐屏扫描活动列表，每屏检查所有尚未处理的活动
#   4. 全部完成后从菜单退回主页

import "subcall/navigation.wf"
import "subcall/page_detection.wf"

default $activity_names = "朝夕共赏"
default $reward_keywords = "签到"

# ─── 校验并整理逐行配置 ──────────────────────────────────
eval $activity_lines = split_lines($activity_names)
eval $reward_lines = split_lines($reward_keywords)

if len($activity_lines) == 0
    log error "每日签到配置无效：请至少填写一个左侧活动名称。"
    return -1
end
if len($activity_lines) != len($reward_lines)
    log error "每日签到配置无效：左侧活动名称有 " + len($activity_lines) + " 项，右侧领奖关键字有 " + len($reward_lines) + " 项，请逐行对应填写。"
    return -1
end

eval $activities = []
eval $rewards = []
eval $pending = {}
for activity_line in $activity_lines
    eval $activity_name = trim($activity_line)
    if $activity_name is_empty
        log error "每日签到配置无效：左侧活动名称不能包含空行。"
        return -1
    end
    eval append($activities, $activity_name)
end
for reward_line in $reward_lines
    eval $reward_keyword = trim($reward_line)
    if $reward_keyword is_empty
        log error "每日签到配置无效：右侧领奖关键字不能包含空行。"
        return -1
    end
    eval append($rewards, $reward_keyword)
end

# 活动名是后续查找与领奖关键字配对的稳定 key，重复名称会产生歧义。
for activity_name in $activities
    eval $reward_head = slice($rewards, 0, 0)
    eval $reward_keyword = $reward_head[0]
    eval remove($rewards, $reward_keyword)
    if has_key($pending, $activity_name)
        log error "每日签到配置无效：左侧活动名称“" + $activity_name + "”重复。"
        return -1
    end
    eval append($pending, $activity_name, $reward_keyword)
end

# ─── 从游戏首页进入活动页面 ──────────────────────────────
call $nav_result = nav_main_to_menu()
if $nav_result < 0
    return -1
end

scan [game_menu_page].[huodong] as $nav_check by contains "活动"
if not $nav_check
    eval pause("未进入菜单页，请手动导航后点击继续")
end
click [game_menu_page].[huodong] after wait @page_refresh

# ─── 逐屏查找并领取各活动奖励 ────────────────────────────
# 初始视口加最多 5 次滚动；每个视口检查全部尚未处理的活动。
eval $previous_list_text = ""
eval $scroll_count = 0
loop 6
    scan [activity_main].[reward_list] as $list_scan
    eval $current_list_text = trim($list_scan.reward_list)

    # 滚动前后的非空 OCR 文本完全相同，说明列表已经到底。
    if not $current_list_text is_empty
        if $current_list_text == $previous_list_text
            log "领奖活动列表已到底。"
            break
        end
    end
    eval $previous_list_text = $current_list_text

    for activity_name in keys($pending)
        eval $reward_keyword = $pending.$activity_name
        call $claimed = claim_visible_activity($activity_name, $reward_keyword)
        if $claimed > 0
            eval del_key($pending, $activity_name)
        end
    end

    if len($pending) == 0
        break
    end
    if $scroll_count >= 5
        log "领奖活动列表已达到最大滚动次数。"
        break
    end

    drag [activity_main].[reward_list] up 0.5 after wait @step_interval
    eval $scroll_count = $scroll_count + 1
end

for activity_name in keys($pending)
    log "未找到活动“" + $activity_name + "”，可能未开放、已结束或不在当前滚动范围。"
end

# ─── 从活动退回菜单，再退回主页 ──────────────────────────
click [activity_main].[back] after wait @step_interval
click [game_menu_page].[back] after wait @step_interval
log "每日签到流程结束。"

# ─── 当前列表视口的通用活动领奖过程 ──────────────────────
# 活动列表与领奖区处于同一页面；这里只切换活动并领奖，不执行返回。
def claim_visible_activity($activity_name, $reward_keyword)
    find [activity_main].[reward_list] as $found by contains $activity_name
    if not $found
        return 0
    end

    log "定位到活动“" + $activity_name + "”，准备领奖。"
    click $found after wait @page_refresh

    find [activity_main].[checkin] as $reward by contains $reward_keyword
    if $reward
        log "检测到“" + $reward_keyword + "”，点击领取。"
        click $reward after wait @page_refresh
        log "活动“" + $activity_name + "”领取完成。"
    else
        log "活动“" + $activity_name + "”未找到“" + $reward_keyword + "”，可能已经领取。"
    end

    return 1
end
