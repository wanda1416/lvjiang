#% name: 扫描全部备战方案
#% runnable: true
#% batchable: true
#% env: [android, desktop]
#% parameters:
#%   - name: scroll_count
#%     label: 基础属性滚动次数
#%     type: number
#%     default: 8
#%     min: 1
#%     max: 20

default $scroll_count = 8
import "subcall/loadout/loadout_plan_navigation.wf"
import "subcall/loadout/equipped_plan_scan.wf"
import "subcall/loadout/role_base_attr_plan_scan.wf"

# 以游戏列表为扫描来源；主界面活动方案保持不变。
call $nav_result = nav_main_to_game_plans()
if $nav_result < 0
    log error "无法进入游戏备战方案管理"
    return -1
end
call $names = collect_game_plan_names()
if not $names
    log error "游戏方案列表未识别到任何方案"
    return -1
end
eval $first_plan = true
for name in $names
    if not $first_plan
        call $nav_result = nav_main_to_game_plans()
        if $nav_result < 0
            return -1
        end
    end
    eval $first_plan = false
    call $selected = select_game_plan($name)
    if $selected == -1
        return -1
    end
    call $nav_result = nav_game_plans_to_main()
    if $nav_result < 0
        return -1
    end
    eval $target = ensure_scanned_loadout(
        $selected.name, $selected.main_art, $selected.sub_art)
    if not $target.ok
        log error "跳过游戏方案 " + $selected.name + ": " + $target.reason
        continue
    end
    call $written = scan_equipped_plan(
        $target.name, $target.main_art, $target.sub_art)
    if $written != 8
        log error "备战方案装备未完整扫描，跳过基础属性: " + $target.name
        continue
    end
    if not $target.playstyle
        log warn "备战方案没有匹配玩法，已扫描装备但跳过基础属性: " + $target.name
        continue
    end
    call $saved = scan_role_base_attr_for_plan(
        $target.name, $target.main_art, $target.sub_art, true, $scroll_count)
    if $saved == -1
        return -1
    end
    log info "已扫描备战方案: " + $target.name + "，基础属性: " + $saved
end
return 0
