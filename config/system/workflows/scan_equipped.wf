#% name: 扫描备战装备
#% runnable: true
#% batchable: true
#% env: [android, desktop]
#% parameters:
#%   - name: plan_name
#%     label: 备战方案名称（留空使用当前方案）
#%     type: text
#%     default: ""
#%   - name: main_art
#%     label: 主武学（可留空从方案读取）
#%     type: text
#%     default: ""
#%   - name: sub_art
#%     label: 副武学（可留空从方案读取）
#%     type: text
#%     default: ""

# 直接运行只负责解析参数；可复用逻辑位于 scan_equipped_plan 子过程。
default $plan_name = ""
default $main_art = ""
default $sub_art = ""
import "subcall/equipped_plan_scan.wf"

eval $target = loadout_scan_target($plan_name, $main_art, $sub_art)
call $written = scan_equipped_plan($target.name, $target.main_art, $target.sub_art)
if $written < 0
    return -1
end
log info "备战方案装备扫描完成: " + $target.name + "，成功写入 " + $written + "/8 件"
return $written
