#% name: 纯逻辑集合过程

# 纯逻辑集合过程库：去重、展开、分块与分组，供各工作流 import 后调用。
# 只处理内存中的列表与字典，不做识别、点击，也不读写配置或 profile。
#
# 包含过程：
#   unique($items)            — 按首次出现顺序去重（返回新列表）
#   flatten_once($groups)     — 只展开一层内层列表（返回新列表）
#   chunk($items, $size)      — 按固定大小分块（返回块列表）
#   group_by_key($rows, $key) — 按行内非空字段分组（返回 {分组: 行列表}）

# ─── unique ───────────────────────────────────────────────
# 按首次出现顺序去重，返回新列表。
#
# 参数：
#   $items — 待去重的列表
# 前置：无。
# 后置：无副作用（不修改 $items）。
# 返回：去重后的新列表。
#
# 判重用 ==，因此按类型判等：数字与其字符串形态视为同一个值（3 与 "3"），
# 布尔只与布尔相等、null 只与 null 相等，false 与 0、null 与 false 都是不同的
# 值。列表与字典元素不参与判重（== 对它们恒假），需要去重嵌套结构时先自行
# 投影成标量。
def unique($items)
    eval $result = []
    for item in $items
        eval $found = false
        for existing in $result
            if $item == $existing
                eval $found = true
                break
            end
        end
        if not $found
            eval append($result, $item)
        end
    end
    return $result
end

# ─── flatten_once ─────────────────────────────────────────
# 只展开一层内层列表，内层元素原样保留。
#
# 参数：
#   $groups — 元素本身是列表的列表
# 前置：无。
# 后置：无副作用（不修改 $groups）。
# 返回：展开一层后的新列表；不递归展开嵌套更深的列表。
def flatten_once($groups)
    eval $result = []
    for group in $groups
        for item in $group
            eval append($result, $item)
        end
    end
    return $result
end

# ─── chunk ────────────────────────────────────────────────
# 按正整数 $size 分块，返回块列表。
#
# 参数：
#   $items — 待分块的列表
#   $size  — 每块元素个数，须为正整数
# 前置：无。
# 后置：无副作用（不修改 $items）。
# 返回：分块后的新列表；$size <= 0 时返回空列表。
def chunk($items, $size)
    eval $result = []
    if $size <= 0
        return $result
    end
    eval $start = 0
    loop while $start < len($items)
        eval $part = slice($items, $start, $start + $size - 1)
        eval append($result, $part)
        eval $start = $start + $size
    end
    return $result
end

# ─── group_by_key ─────────────────────────────────────────
# 按字典中的非空字段分组。
#
# 参数：
#   $rows — 行字典列表
#   $key  — 用作分组键的字段名
# 前置：无。
# 后置：无副作用（不修改 $rows 与行字典）。
# 返回：{分组值: 行列表} 字典；缺少字段或字段为空的行走不进入结果。
def group_by_key($rows, $key)
    eval $result = {}
    for row in $rows
        eval $group = $row.$key
        if $group
            if not has_key($result, $group)
                eval append($result, $group, [])
            end
            eval $members = $result.$group
            eval append($members, $row)
        end
    end
    return $result
end
