# 单次调律工作流

call "subcall/nav_main_to_equip.wf"

# 点击主武器
click [bag_equip_detail].[slot_main_weapon]
wait step_interval

click [bag_equip_detail].[bag_1_1]
wait step_interval

call "subcall/nav_equip_to_tune.wf" read "status" as $tune_status
if not $tune_status
    log "未进入调律页面，提前结束"
    return
end

scan [equip_tune_detail].[one_click_add] as $add_scan
if not $add_scan.one_click_add contains "添加"
    log "装备已调律完毕，无需调律"
    return
end

# 识别材料格，找到紫狗粮则点击，否则提前结束
eval $target_material = "紫色狗粮"
call "subcall/find_material.wf" with $target_material as target_material read "position" as $purple_pos
if not $purple_pos
    log "紫色狗粮不足，提前结束"
    return
end
click $purple_pos
wait step_interval

click [equip_tune_detail].[one_click_add]
wait step_interval

click [equip_tune_detail].[tune_btn]
wait step_interval

wait after_tune_wait
scan [equip_tune_result] as $result
log "调律结果已识别"
collect $result

click [equip_tune_result].[close_btn]
wait step_interval

click [equip_tune_detail].[back]
wait step_interval

click [bag_equip_detail].[back]
wait step_interval

click [bag_equip_detail].[back]
wait step_interval

click [bag_equip_detail].[back]
wait step_interval

click [game_menu_page].[back]
