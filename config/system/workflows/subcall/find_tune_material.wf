# 在调律页材料格中逐个寻找指定材料（early return 优化）
# input: "material_name" — 目标材料名称
# output: "slot_name" — 找到的材料格 key 名（空则未找到）

eval $slots = ["material_1", "material_2", "material_3", "material_4", "material_5", "material_6", "material_7"]
for slot_name in $slots
    recognize [equip_tune_detail].$slot_name as $m
    if $m.$slot_name equals $material_name
        eval $found = $slot_name
        collect $found as "slot_name"
        return
    end
end

log "材料格中未找到目标材料"
