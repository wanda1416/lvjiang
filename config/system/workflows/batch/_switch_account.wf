# 公共子过程：账号切换流程
# 登录页 → 选账号 → 登录 → 到达角色选择页（page_state=1）
# 不包含选角色，由调用方决定是否接着调用 _select_role

def _switch_account($tail, $role_index, $account, $role, $batch_state)
    log "当前匹配" + $tail
    log "当前下标" + $role_index

    # 1. 登录页 → 用户切换视图
    click [game_login_page].[more_user]
    wait (1, 2)

    click [game_login_page].[users_icon]
    wait (1, 2)

    click [game_login_page].[switch_user]
    wait (1, 2)

    click [game_login_page].[tap_user]
    wait (1, 2)

    # 2. 查找目标账号（最多滚动 5 次）
    eval $found_user = ""
    loop 5
        find [game_login_page].[user_list] as $found_user by contains $tail
        if $found_user
            click $found_user
            goto account_selected
        end
        drag [game_login_page].[point_2] [game_login_page].[point_1]
        wait (1, 2)
    end

    # 找不到 → 暂停手动处理
    eval pause("未找到账号，请手动选定账号后点击 继续")

    @account_selected
    wait (1, 2)

    # 3. 登录 → 到达角色选择页
    click [game_login_page].[login]
    wait (2, 3)

    # 已确认目标账号，保留账号状态
    # 下一条同账号任务可以跳过账号切换，直接选角色
    eval $batch_state.account = $account
    eval $batch_state.role = ""
    eval $batch_state.page_state = 1

    return {"status": "account_ready", "message": "", "state": $batch_state}
end
