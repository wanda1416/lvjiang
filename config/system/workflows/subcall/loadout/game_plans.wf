#% name: 游戏备战方案导航

# 游戏内「备战方案」页面的导航与选择：菜单 → 培养 → 功法 → 方案。
# 依赖 navigation.wf 的通用导航。
#
# 包含过程：
#   nav_main_to_game_plans()  — 主页 → 备战方案页（0=成功 / -1=失败）
#   nav_game_plans_to_main()  — 备战方案页 → 主页（0=成功 / -1=用户放弃）
#   collect_game_plan_names() — 读当前网格里可见的方案名列表
#   select_game_plan($name)   — 选中指定方案并读出方案名与两门武学

import "subcall/navigation.wf"

# ─── nav_main_to_game_plans ───────────────────────────────
# 从主页进入备战方案页。
#
# 参数：无
# 前置：在主页或菜单页。
# 后置：0=已按路径走到备战方案页；-1=没进菜单页或菜单里读不到「培养」。
# 返回：0=成功；-1=失败。
#
# 后半段（功法 → 方案）不做到位校验，页面不对时会由随后的
# collect_game_plan_names / select_game_plan 暴露。
def nav_main_to_game_plans()
    call $result = nav_main_to_menu()
    if $result < 0
        return -1
    end
    scan [game_menu_page].[peiyang] as $entry by contains "培养"
    if not $entry
        return -1
    end
    click [game_menu_page].[peiyang] after wait @page_refresh
    click [training_main].[gongfa] after wait @step_interval
    click [training_main].[fangan] after wait @page_refresh
    return 0
end

# ─── nav_game_plans_to_main ───────────────────────────────
# 从备战方案页返回主页。
#
# 参数：无
# 前置：在备战方案页（或已退到菜单页）。
# 后置：0=已确认在主页；-1=用户选择结束本次扫描，现场未确认。
# 返回：0=成功；-1=用户在确认框选择停止。
#
# 按既定返回路径操作，只在终点确认主页；中途 OCR 偶发漏判不应终止整批扫描。
def nav_game_plans_to_main()
    click [training_plan].[back] after wait @page_refresh
    click [training_main].[back] after wait @page_refresh
    click [game_menu_page].[back] after wait @page_refresh
    call $in_main = is_in_main_page()
    loop while not $in_main
        eval $retry = confirm("未确认已返回主页。请手动回到主页后点击是重试检查；点击否结束本次扫描")
        if not $retry
            log warn "用户选择停止：未能确认已返回主页"
            return -1
        end
        call $in_main = is_in_main_page()
    end
    return 0
end

# ─── collect_game_plan_names ──────────────────────────────
# 读取当前网格里可见的方案名列表。
#
# 参数：无
# 前置：在备战方案页。
# 后置：无副作用（只识别，不滚动、不点击）。
# 返回：方案名列表（按网格行顺序，空槽跳过）。
#
# 第一版只扫描当前网格可见行；空槽无文字，不滚动、不去重。
def collect_game_plan_names()
    scan [training_plan].[plan_list] as $grid
    eval $names = []
    for row in keys($grid)
        eval $name = trim($grid.$row.[1])
        if len($name) > 0
            eval append($names, $name)
        end
    end
    return $names
end

# ─── select_game_plan ─────────────────────────────────────
# 选中指定方案，并读出方案名与两门武学。
#
# 参数：
#   $name — 方案名，必须是 collect_game_plan_names 读到的名字
# 前置：在备战方案页，且方案在当前网格内（超出网格的方案暂不支持）。
# 后置：成功时该方案已在使用；-2 时缺装备/未保存弹窗没能处理完，现场保留。
# 返回：{"name", "main_art", "sub_art"}；-1=找不到方案或名称/武学识别不完整；
#       -2=缺装备弹窗或未保存提示处理失败。
def select_game_plan($name)
    find [training_plan].[plan_list] as $found by equals $name
    if not $found
        log error "游戏方案列表未找到: " + $name
        return -1
    end
    click $found after wait @page_refresh
    scan [training_plan].[plan_title, main_art, sub_art] as $detail
    eval $title = trim($detail.plan_title)
    eval $main_art = trim($detail.main_art)
    eval $sub_art = trim($detail.sub_art)
    if $title != $name or not $main_art or not $sub_art
        log error "游戏方案名称或武学识别不完整: " + $name
        return -1
    end

    # 仅用按钮文案决定是否需要点击；不能用切换后的文案判定成败。
    # 当前方案再次选中时可能没有“使用方案”，也不保证出现“另存为”。
    scan [training_plan].[use_area] as $use by contains "使用方案"
    if $use
        click [training_plan].[use_area] after wait @page_refresh
        loop 3
            scan [training_plan].[modal_message] as $message
            if $message.modal_message contains "装备缺失"
                scan [training_plan].[smart_fill] as $action by contains "智能填充"
                if not $action
                    log error "缺装备弹窗未识别到智能填充按钮"
                    return -2
                end
                click [training_plan].[smart_fill] after wait @page_refresh
            else if $message.modal_message contains "未保存"
                scan [general_control].[confirm] as $action by contains "切换"
                if not $action
                    return -2
                end
                click [general_control].[confirm] after wait @page_refresh
            else
                break
            end
        end
        scan [training_plan].[modal_message] as $message
        if $message.modal_message contains "装备缺失" or $message.modal_message contains "未保存"
            return -2
        end
    end
    return {"name": $title, "main_art": $main_art, "sub_art": $sub_art}
end
