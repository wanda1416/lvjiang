#% name: 盟主争锋
#% parameters:
#%   - name: execute_times
#%     label: 执行局数
#%     type: number
#%     default: 10

# 盟主争锋自动化流程
#
# 流程结构：
#   loop $execute_times → 每轮执行一局游戏
#      @start → 开始匹配 → 等待"确认选择" → 点击进入
#         ↓
#      @round_loop → 等待"开始战斗" → 拖拽商品 → 开始战斗 → 处理确认弹窗 → 等待结果
#         ↓                                              ↓
#         ↑ ← "下个回合"（胜利，下一回合）          "继续"（失败）
#                                                   ↓
#                                              连续点击"继续"结算
#                                                   ↓
#                                              回到 @start 开始下一局
#
# 状态判定：
#   - "下个回合" = 胜利，进入下一回合
#   - "继续" = 失败，需要重开一局
#
# 参数：
#   execute_times — 循环执行次数，默认 10

default $execute_times = 10

$step_interval = (2, 3)

loop $execute_times

$skip_confirm = 0
scan [activity_mengzhu].[start_new] as $scan_result
if not $scan_result.[start_new] contains "开始匹配"
   if not $scan_result.[start_new] contains "继续对局"
      eval pause("请在初始界面开始执行")
      return
   else
      # 可以跳过确认选择
      $skip_confirm = 1
   end
end

# 点击开始匹配
click [activity_mengzhu].[start_new] after wait $step_interval

# 等待加载动画，直到出现“确认选择”
if $skip_confirm == 0
loop 100
   scan [activity_mengzhu].[start_new] as $scan_result
   if $scan_result.[start_new] contains "确认选择"
       click [activity_mengzhu].[start_new] around wait $step_interval
       break
   end
   wait $step_interval
end
end

# 单回合循环
@round_loop

# 等待"开始战斗"出现
loop 100
   scan [activity_mengzhu].[start_new] as $scan_result
   if $scan_result.[start_new] contains "开始战斗"
       break
   end
   wait $step_interval
end

# 拖拽一件商品购买，由于开始战斗会弹框阻断一会，所以多等 5s
wait (4, 5)
drag [activity_mengzhu].[add_item] hold 1 after wait $step_interval

# 点击"开始战斗"进行对局
click [activity_mengzhu].[start_new] after wait $step_interval

# 检查是否弹出购买确认对话框
scan [activity_mengzhu].[confirm] as $scan_result
if $scan_result.[confirm] contains "确认"
   click [activity_mengzhu].[confirm] around wait $step_interval
end

# 等待对局结果："下个回合" 或 "继续"
loop 100
   scan [activity_mengzhu].[start_new] as $scan_result
   if $scan_result.[start_new] equals "下个回合"
       # 进入下一回合
       click [activity_mengzhu].[next] before wait $step_interval
       goto round_loop
   end
   if $scan_result.[start_new] contains "继续"
       # 失败，需要重开
       break
   end
   # 这里可以等久一些，每次 5s
   wait (4, 6)
end

# 出现"继续"，连续点击"继续"结算，直到"开始匹配"重新出现
loop 100
   scan [activity_mengzhu].[start_new, next] as $scan_result
   if $scan_result.[start_new] contains "开始匹配"
       break
   end
   if $scan_result.[next] contains "继续"
       click [activity_mengzhu].[next] before wait $step_interval
   end
   wait $step_interval
end

# 失败结算完成，回到 loop 开头开始下一局（loop 计数器自动 +1）
end
