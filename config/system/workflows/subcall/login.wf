# 登录页切换账号、选择角色及退出登录的公共过程。

import "subcall/navigation.wf"
import "subcall/page_detection.wf"

def prepare_user($username, $batch_state, $skip_online_role, $online_role_max_wait, $max_roll_account, $allow_restart_app)
    eval check_env(["android", "desktop"])
    eval $account = user_get($username, "account")
    eval $role = user_get($username, "role")
    eval $role_index = user_get($username, "role_index")
    eval $tail = user_get($username, "tail")
    if not $account
        return {"status": "failed", "message": "用户未配置账号名", "state": $batch_state}
    end
    if not $role
        return {"status": "failed", "message": "用户未配置角色名", "state": $batch_state}
    end
    if not $role_index
        return {"status": "failed", "message": "用户未配置角色序号", "state": $batch_state}
    end
    # 自动流程停下来求助时，人工要能一眼看出该把客户端摆成什么样。批量里
    # 多个用户轮流跑，隔了几分钟回来看到一句「请手动选定账号」是没法操作的。
    eval $login_target = "账号 " + $account + "（尾号 " + $tail + "）、角色 " + $role

    call $in_login_page = is_in_login_page()
    if not $in_login_page
        call $in_startup_page = is_in_startup_page()
        if $in_startup_page
            call $in_login_page = leave_startup_page()
        else if $allow_restart_app
            if env("desktop") and not $tail
                return {"status": "failed", "message": "用户未配置账号尾号", "state": $batch_state}
            end
            call $in_login_page = ensure_login_page_by_restart(
                "yyslscn", $tail, $account, $batch_state, $max_roll_account,
                $login_target)
        else
            eval pause("当前不在登录页，请切换到登录页后点击继续。本次目标："
                + $login_target)
            call $in_login_page = is_in_login_page()
        end
        if not $in_login_page
            return {"status": "failed", "message": "未能回到登录主页", "state": $batch_state}
        end
    end

    log "目标账号：" + $account
    if not $batch_state.account equals $account
        if not $tail
            return {"status": "failed", "message": "用户未配置账号尾号", "state": $batch_state}
        end
        log "需要切换账号: " + $account
        call $switched = switch_account(
            $tail, $account, $batch_state, $max_roll_account, $login_target)
        if not $switched
            return {"status": "failed", "message": "未能切换到目标账号", "state": $batch_state}
        end
    end

    log "切换角色: " + $role
    call $result = select_role($role_index, $role, $batch_state, $skip_online_role, $online_role_max_wait)
    return $result
end


# ─── 登录页确认 ────────────────────────────────────────────

def is_in_login_page()
    scan [game_login_page].[switch_role] as $login_check by contains "选择角色"
    if $login_check
        return 1
    end
    wait 5
    scan [game_login_page].[switch_role] as $login_check by contains "选择角色"
    if $login_check
        return 1
    end
    return 0
end


# ─── 恢复到登录页 ───────────────────────────
# 调用方优先识别登录主页或启动页；其他现场按参数重启客户端。
# 登录页背景动画常驻，不等稳定帧；启动页用游戏 logo 识别。

# PC 重启后直接处于切换用户视图；Android 重启后处于启动页面。
# 调用方已检查当前不在登录主页和启动页面，并已校验目标账号资料。
def ensure_login_page_by_restart($app_id, $tail, $account, $batch_state, $max_roll_account, $login_target)
    if app_is_running($app_id)
        app stop $app_id
    end
    app start $app_id timeout 30
    if env("desktop")
        scene [game_login_page] view [users]
        call $ready = wait_for_switch_users_page()
        if not $ready
            return 0
        end
        call $logged_in = select_account_and_login(
            $tail, $max_roll_account, $login_target)
        if not $logged_in
            return 0
        end
        # PC 仅在重启后的首次账号登录会进入启动页；关闭后即回到登录主页。
        # 账号已经在本分支选定，prepare_user 随后会直接选择角色，不再重复切换账号。
        call $in_login_page = leave_startup_page()
        if not $in_login_page
            return 0
        end
        eval $batch_state.account = $account
        eval $batch_state.role = ""
        eval $batch_state.page_state = 1
        return 1
    end
    scene [game_login_page] view [init]
    call $in_login_page = leave_startup_page()
    return $in_login_page
end


def is_in_startup_page()
    scan [game_login_page].[yysls_logo] as $logo by image
    if $logo
        return 1
    end
    return 0
end


# back 仅是点击目标；启动页必须由 logo 判定。
def leave_startup_page()
    eval $startup_ready = 0
    loop 60
        call $startup_ready = is_in_startup_page()
        if $startup_ready
            break
        end
        wait @page_refresh
    end
    if not $startup_ready
        eval pause("未检测到游戏启动页标志，请手动回到登录主页后点击继续")
        call $in_login_page = is_in_login_page()
        if $in_login_page
            return 1
        end
        call $startup_ready = is_in_startup_page()
        if not $startup_ready
            return 0
        end
    end
    click [game_login_page].[back] after wait @page_refresh
    call $in_login_page = is_in_login_page()
    if not $in_login_page
        eval pause("点击启动页返回后未进入登录主页，请手动处理后点击继续")
        call $in_login_page = is_in_login_page()
    end
    return $in_login_page
end


def wait_for_switch_users_page()
    eval $ready = 0
    loop 60
        scan [game_login_page].[login] as $ready by contains "进入游戏"
        if $ready
            return 1
        end
        wait @page_refresh
    end
    eval pause("未检测到切换用户页的「进入游戏」，请手动定位后点击继续")
    scan [game_login_page].[login] as $ready by contains "进入游戏"
    if $ready
        return 1
    end
    return 0
end


# ─── 主页 → 退出 → 回到登录页 ──────────────────────────────
# 流程：主页进菜单 → 菜单点退出 → 二次确认弹窗点「登录」→ 回到登录页

def exit_to_login()
    # 1. 主页 → 菜单
    # 走标准导航并自带到位校验；click 由布局选择点菜单或按 ESC。
    call $in_menu = nav_main_to_menu()
    if $in_menu < 0
        log "未能进入菜单页，退出流程可能落空"
    end

    # 2. 菜单 → 退出（两端行为一致）
    click [game_menu_page].[exit] after wait @page_refresh

    # 3. 二次确认：检查退出弹窗中是否有「返回登录页面」按钮
    scan [game_login_page].[back_to_login] as $result by contains "返回登录"
    if $result
        click [game_login_page].[back_to_login] after wait @secondary_confirm
    else
        eval pause("未找到「返回登录界面」按钮，请手动退出到登录页后点击继续")
    end
end


# ─── 账号切换 ──────────────────────────────────────────────
# 登录页 → 选账号 → 登录 → 回到登录页角色入口（page_state=1）
# 不包含选角色，由调用方决定是否接着调用 select_role

def switch_account($tail, $account, $batch_state, $max_roll_account, $login_target)
    log "当前匹配" + $tail

    # 1. 登录页 → 用户切换视图
    click [game_login_page].[more_user] after wait @page_refresh
    click [game_login_page].[user_icon] after wait @page_refresh

    if env("desktop")
        # PC 端需要登出 后再点击触发 选择账号 登录
        scan [game_login_page].[switch_user] as $found by contains "登出"
        if not $found
            # 疑似登出太浅无法识别，此时继续识别是否存在 进入游戏，如果不存在那就是没有登出
            scan [game_login_page].[login] as $login_game by contains "进入游戏"
            if not $login_game
                $found = "登出"
            end
        end
        if $found
            click [game_login_page].[switch_user] after wait @page_refresh
            click [game_login_page].[user_icon] after wait @page_refresh
        end
    else if env("android")
        # 安卓端直接可以选择用户完成账号切换
        click [game_login_page].[switch_user] after wait @page_refresh
    end

    call $logged_in = select_account_and_login(
        $tail, $max_roll_account, $login_target)
    if not $logged_in
        return 0
    end
    # 非重启账号切换登录后直接回到登录主页，不经过启动页。
    eval $batch_state.account = $account
    eval $batch_state.role = ""
    eval $batch_state.page_state = 1
    return 1
end


# 前置：已经进入切换用户视图。这里只负责选择并登录账号；登录后的页面流转由
# 调用方按“PC 重启”或“普通账号切换”各自处理。
def select_account_and_login($tail, $max_roll_account, $login_target)
    click [game_login_page].[tap_user] after wait @page_refresh

    # 2. 按条目准备参数限定的次数查找目标账号
    eval $found_user = ""
    loop $max_roll_account
        find [game_login_page].[user_list] as $found_user by contains $tail
        if $found_user
            click $found_user
            break
        end
        env:"android" -> drag [game_login_page].[point_2] to [game_login_page].[point_1]
        env:"desktop" -> scroll [game_login_page].[user_list] down 2
        wait @page_refresh
    end

    # 找不到 → 暂停手动处理。这里不做二次校验：选没选对只有人能判断，
    # 所以提示必须写清该登录哪个账号，把正确性交给人工确认。
    if not $found_user
        eval pause("未找到账号，请手动选定并登录：" + $login_target
            + "，选好后点击继续")
    end
    wait @page_refresh

    # 3. 提交账号登录；登录后的页面由调用方按所在流程处理。
    click [game_login_page].[login] after wait @page_refresh
    return 1
end


# ─── 选角色 + 进入游戏 ─────────────────────────────────────

def select_role($role_index, $role, $batch_state, $skip_online_role, $online_role_max_wait)
    log "当前下标" + $role_index
    eval $online_deadline = clock() + to_num($online_role_max_wait)

    # 打开角色选择页。不假设点一次就进去了：登录鉴权、页面加载都可能还没完，
    # 此时盲点下去两次空点都不报错（panel 坐标算不出时是静默 return），
    # 错误要拖到 login_to_main_page 才以「无法确认已登录至主页」暴露，对不上因。
    # 故每点一次等一拍，以「进入游戏」是否出现为判据，最多重试 5 次。
    # 这 5 次只计「没进去角色列表」的重试；等角色下线由子过程按期限自己收敛。
    # 两个上界不能共用一个计数器，否则等待会把重试次数吃光。
    eval $role_page = 0
    loop 5
        click [game_login_page].[switch_role] after wait @secondary_confirm

        # 角色在线时会弹二次确认（confirm 区域含「其他角色」），
        # 这种情况下不可能进入角色列表。
        call $online = wait_until_role_offline($batch_state, $skip_online_role, $online_deadline)
        if $online
            return {"status": "skipped", "message": "角色在线", "state": $batch_state}
        end

        call $role_page = is_in_role_select_page()
        if $role_page
            break
        end
        log "未进入选择角色页面，重试"
    end
    if not $role_page
        eval pause("无法进入选择角色页面，请手动进入角色列表后点击继续。"
            + "本次目标角色：" + $role + "（第 " + $role_index + " 个）")
    end

    # 选角色（role_list: 1列4行，role_index 1-4 → panel 行 1-4）
    click [game_login_page].[role_list][$role_index][1] after wait @page_refresh
    # 进入游戏
    click [game_login_page].[enter] after wait @secondary_confirm

    # 等待加载完成并进入主页
    call login_to_main_page()

    eval $batch_state.page_state = 2
    eval $batch_state.role = $role
    wait @step_interval
    return {"status": "success", "message": "", "state": $batch_state}
end


# ─── 等待角色下线 ──────────────────────────────────────────
# 点「切换角色」可能撞上「其他角色在线」弹窗。弹窗必须取消——留着会挡住
# 后续任何页面判定。等待模式下由本过程自己重试到期限：取消弹窗、等一会儿、
# 重新点回「切换角色」再查；不重新点就永远读不到提示已经消失。
# 放弃时把 batch_state 复位回登录页状态并返回 1，调用方据此以 skipped 收尾
# （status/message 的措辞由调用方上下文决定）。返回 0 表示角色可登录。

def wait_until_role_offline($batch_state, $skip_online_role, $online_deadline)
    loop while 1 == 1
        scan [game_login_page].[online_label] as $online by contains "在线"
        if not $online
            return 0
        end
        click [game_login_page].[cancel] after wait @page_refresh
        if $skip_online_role
            log "角色在线，不可登录，跳过"
        else if clock() < $online_deadline
            log "角色仍在线，30 秒后重试登录"
            wait 30
            click [game_login_page].[switch_role] after wait @secondary_confirm
            continue
        else
            log "角色在线等待超时，跳过"
        end
        eval $batch_state.page_state = 1
        eval $batch_state.role = ""
        return 1
    end
end


# ─── 登录加载到主页 ────────────────────────────────────────
# 等待加载条消失 → 检测主页元素 → 处理战令领奖/关闭弹窗

def login_to_main_page()
    # 等待加载完成：检测 loading 区域的「加载」文字
    # 有「加载」→ 继续等；消失后再等 5 秒视为登录完成
    eval $loading_done = 0
    loop 10
        scan [game_login_page].[loading] as $load_text by contains "加载"
        if not $load_text
            eval $loading_done = 1
            break
        end
        wait 3
    end
    if not $loading_done
        eval pause("等待加载超时，请手动检查后点击确定")
    end
    wait 5

    # 等待主页加载完成：检测主界面入口按钮
    # 能读到 → 登录完成；否则先检查战令领奖，再尝试关闭活动弹窗
    loop 8
        call $in_main = is_in_main_page()
        if $in_main
            log "主页加载完成"
            # 检查是否有战令领奖入口
            call claim_zhanling_reward()
            return
        end

        # 未检测到主页，先检查战令领奖
        scan [game_login_page].[zllj_btn] as $zllj by contains "前往领奖"
        if $zllj
            log "检测到战令领奖入口，先领奖"
            call claim_zhanling_reward()
        else
            # 没有战令领奖，尝试关闭活动弹窗
            click [game_login_page].[close_btn]
        end
        wait @page_refresh
    end
    eval pause("无法确认已登录至主页，请手动检查后点击确定")
end


# ─── 战令领奖 ──────────────────────────────────────────────
# 检测战令领奖入口，有则进入领取并返回

def claim_zhanling_reward()
    scan [game_login_page].[zllj_btn] as $zllj by contains "前往领奖"
    if $zllj
        log "进入战令领奖页面"
        click [game_login_page].[zllj_btn] after wait @step_interval
        scan [zhanling_detail].[claim_all] as $claim by contains "一键领取"
        if $claim
            log "点击一键领取"
            click [zhanling_detail].[claim_all] after wait @step_interval
        end
        click [zhanling_detail].[back] after wait @step_interval
    end
end
