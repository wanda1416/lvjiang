#% name: 批量属性单元条目准备
#% batch_unit_prepare: true
#% parameters:
#%   - name: profile_key
#%     label: 选择数据模型
#%     type: text
#%     default: ""
#%   - name: max_roll_account
#%     label: 单轮最大滚动次数
#%     type: number
#%     default: 50
#%     min: 1
#%     max: 50
#%   - name: skip_online_role
#%     label: 角色在线跳过
#%     type: bool
#%     default: true
#%   - name: online_role_max_wait
#%     label: 最大等待时间
#%     require: not $skip_online_role
#%     type: number
#%     default: 0
#%     min: 0
#%     max: 3600
#%   - name: allow_restart_app
#%     label: 允许重启应用
#%     type: bool
#%     default: true

# 仅供属性执行单元使用：在单元成员里挑出指定 Profile 进度最小的一个角色，再交给
# subcall/login.wf 的 prepare_user 登录。声明了 #% batch_unit_prepare，调度器据此
# 认定本流程会返回本单元实际使用的用户名。
#
# 参数：
#   profile_key          — 参与比较的 Profile key，必须是数值型（stock / quota / regen）
#   max_roll_account     — 账号列表单轮滚动步数上限
#   skip_online_role     — true=角色在线直接跳过，false=等到 online_role_max_wait
#   online_role_max_wait — 等待角色下线的秒数上限
#   allow_restart_app    — 不在登录页/启动页时是否允许重启客户端
# 前置：调度器已注入 $batch_unit_members 与 $batch_state；key 已在本单元声明。
# 后置：成功时已在游戏主页，$batch_state 就地更新；本单元无可执行角色时以 skipped 收尾。
# 返回：{"status", "message", "state"}，成功时另带 username=本轮选中的用户；
#       Profile key 缺失或类型不对时返回 failed。

import "subcall/login.wf"

# 选择依据必须是数值型 Profile：note 之类没有大小关系，无法参与比较。
if not $profile_key
    return {"status": "failed", "message": "请配置选择角色所用的 Profile key", "state": $batch_state}
end
eval $model = profile_model($profile_key)
if not $model or $model == "note"
    return {"status": "failed", "message": "Profile key 不存在或不是数值类型: " + $profile_key, "state": $batch_state}
end

eval $chosen = ""
eval $minimum = null
for member in $batch_unit_members
    eval $username = $member.username
    eval $value = profile_get($profile_key, $username)
    # 尚无记录的配额按零进度参与选择。
    if $value is_empty
        eval $value = 0
    end
    eval $number = to_num($value)
    if not $chosen or $number < $minimum
        eval $minimum = $number
        eval $chosen = $username
    end
end

if not $chosen
    return {"status": "skipped", "message": "本单元没有可执行角色", "state": $batch_state}
end

log "本次选择角色: " + $chosen + "，" + $profile_key + "=" + $minimum
call $result = prepare_user($chosen, $batch_state, $skip_online_role, $online_role_max_wait, $max_roll_account, $allow_restart_app)
eval $result.username = $chosen
return $result
