#% id: stake_mingjinhong
#% name: 鸣金虹木桩测伤
#% runnable: true
#% env: [desktop, android]
#% note: |-
#%   开始前切换至枪，确保角色面向目标并处于攻击范围。
#%   PC 端：将滚轮切武器绑定小键盘 8；默认使用 Q = 武学技、E = 卸势。
#%   安卓端：使用控制场景的战斗与移动视图执行技能、切武器和后退操作。
#%   奇术 2 对应阴阳迷踪步，3 对应萧吟千浪，可以修改。
#%   如果需要追求极限，最好自行修改每个环节按键时间和等待。
#% parameters:
#%   - name: key_yy
#%     label: 阴阳迷踪步
#%     env: [desktop]
#%     type: select
#%     default: "2"
#%     options: ["1", "2", "3", "4", "7", "8", "9", "0"]
#%   - name: key_dz
#%     label: 萧吟千浪
#%     env: [desktop]
#%     type: select
#%     default: "3"
#%     options: ["1", "2", "3", "4", "7", "8", "9", "0"]
#%   - name: qishu_yy
#%     label: 阴阳迷踪步
#%     env: [android]
#%     type: select
#%     default: qishu_2
#%     options:
#%       - { value: qishu_1, label: "1" }
#%       - { value: qishu_2, label: "2" }
#%       - { value: qishu_3, label: "3" }
#%       - { value: qishu_4, label: "4" }
#%   - name: qishu_dz
#%     label: 萧吟千浪
#%     env: [android]
#%     type: select
#%     default: qishu_3
#%     options:
#%       - { value: qishu_1, label: "1" }
#%       - { value: qishu_2, label: "2" }
#%       - { value: qishu_3, label: "3" }
#%       - { value: qishu_4, label: "4" }

default $key_yy = "2"
default $key_dz = "3"
default $qishu_yy = "qishu_2"
default $qishu_dz = "qishu_3"

# 鸣金虹木桩测伤：按录制整理出的按键时间线打一整套循环，用于复现输出轴。
#
# 流程结构：
#   1. 按环境分发：桌面端走按键时间线，安卓端走控制场景的各按钮
#   2. 两端结构对称：奇术 → 武学技 → 卸势 → 切武器 → 多轮剑气蓄力 →
#      枪Q 挂 buff → 拉距离，循环数轮后以最后一次剑气收尾
#   3. 全程没有页面判定与到位校验，起点或键位一变整套轴就失效
#
# 参数：
#   key_yy、key_dz     — 桌面端阴阳迷踪步与萧吟千浪的按键
#   qishu_yy、qishu_dz — 安卓端两个奇术对应的按钮区域 key
# 前置：角色面向目标且处于攻击范围；桌面端按键需要前台发送（后台模式不生效）。
# 后置：整套循环打完即结束，不校验页面、不回收现场，也没有返回值。
# 返回：无返回值（隐式 null）；环境既不是 desktop 也不是 android 时记错误日志后结束。

if env("desktop")
    goto desktop
end
if env("android")
    goto android
end
log error "无名木桩测伤仅支持 desktop/android 环境"
return

# ─── desktop：按键时间线 ────────────────────────────────────────
@desktop

press $key_yy hold 0.06 after wait 0.15
press "Q" hold 0.1 after wait 0.09
press "E" hold 0.08 after wait 0.3
press $key_dz hold 0.11 after wait 0.74
press "E" hold 0.06 after wait 0.11
press "NUM8" hold 0.09 after wait 0.1

# 第一道剑气，wait 开始计时
press "R" hold 1.45 after wait 0.75

# 点剑
log info "第一次点剑+瞬发剑气"
# 这里改成 0.27 经常容易挂不上 buff
press "Q" hold 0.06 after wait 0.28
press "R" hold 0.06 after wait 0.78

# 三道剑气
press "R" hold 1.468 after wait 0.795
# 这里比较极限，经常容易出现提前，可以考虑改 1.47
press "R" hold 1.47 after wait 0.8
press "R" hold 1.47 after wait 0.8

log info "第一次枪Q"
call qiang_wuxueji(0)

press "R" hold 1.468 after wait 0.8
press "R" hold 1.47 after wait 0.8

# 二次点剑
log info "第二次点剑+瞬发剑气"
press "Q" hold 0.06 after wait 0.28
press "R" hold 0.06 after wait 0.78

# 三道剑气
press "R" hold 1.468 after wait 0.8
press "R" hold 1.468 after wait 0.8
press "R" hold 1.47 after wait 0.8

# 枪Q 挂buff，这里容易出现切剑没切回来
log info "第二次枪Q，挂 buff"
call qiang_wuxueji(1)

press "R" hold 1.468 after wait 0.8
press "R" hold 1.47 after wait 0.8

# 第三次瞬发
log info "第三次瞬发剑气"
press "R" hold 0.06 after wait 0.78

# 三道剑气
press "R" hold 1.47 after wait 0.8
press "R" hold 1.468 after wait 0.8
press "R" hold 1.47 after wait 0.8

# 枪Q
log info "第三次枪Q, 挂buff"
call qiang_wuxueji(1)

press "R" hold 1.47 after wait 0.8
press "R" hold 1.47 after wait 0.8

# 吹笛拉距离
press $key_dz hold 0.1 after wait 0.1
press "S" hold 2.18 after wait 0.95

# 第四次瞬发剑气
log info "第三次点剑+第四次瞬发剑气"
press "Q" hold 0.06 after wait 0.28
press "R" hold 0.06 after wait 0.78
# 继续蓄力
press "R" hold 1.47 after wait 0.8

log info "第四次枪Q"
call qiang_wuxueji(0)

press "R" hold 1.468 after wait 0.8
press "R" hold 1.47 after wait 0.8

log info "第五次瞬发剑气"
press "R" hold 0.06 after wait 0.78
press "R" hold 1.468 after wait 0.8
press "R" hold 1.47 after wait 0.8
# 最后一次剑气，打不出来就是延迟问题
press "R" hold 1.47

# ─── qiang_wuxueji ────────────────────────────────────────
# 桌面端枪 Q 连段：切枪 → 武学技 → 卸势 → 切回剑（内部过程）。
#
# 参数：
#   $buff — 1=本次要挂 buff（各段等待更长），0=普通连段
# 前置：当前持剑且已站在木桩攻击范围内。
# 后置：连段按键已发完，结束时持剑。
# 返回：无返回值（隐式 null）。
def qiang_wuxueji($buff)
    # 按键低于 50ms 很容易被忽略，保守起见直接 60ms，并且挂 buff 时更长一些
    if $buff
        press "NUM8" hold 0.08 after wait 0.07
        press "Q"    hold 0.10 after wait 0.24
        press "E"    hold 0.06 after wait 0.12
        press "NUM8" hold 0.08 after wait 0.09
    else
        press "NUM8" hold 0.08 after wait 0.07
        press "Q"    hold 0.06 after wait 0.11
        press "E"    hold 0.06 after wait 0.11
        press "NUM8" hold 0.08 after wait 0.09
    end
end

return

# ─── android：控制场景按钮时间线 ────────────────────────────────────
@android

click [general_combat].$qishu_yy hold 0.06 after wait 0.15
click [general_combat].[wuxueji] hold 0.1 after wait 0.3
click [general_combat].[xieshi] hold 0.1 after wait 0.3
click [general_combat].$qishu_dz hold 0.12 after wait 0.8
click [general_combat].[xieshi] hold 0.06 after wait 0.3
click [general_combat].[weapon] hold 0.1 after wait 0.2

# 第一道剑气，wait 开始计时
click [general_combat].[xuli] hold 1.52 after wait 0.8

# 点剑
log info "第一次点剑+瞬发剑气"
# 这里改成 0.27 经常容易挂不上 buff
click [general_combat].[wuxueji] hold 0.06  after wait 0.28
click [general_combat].[xuli] hold 0.06 after wait 0.8

# 三道剑气
click [general_combat].[xuli] hold 1.525 after wait 0.8

click [general_combat].[xuli] hold 1.52 after wait 0.8
click [general_combat].[xuli] hold 1.52 after wait 0.8

log info "第一次枪Q"
call qiang_wuxueji_android(0)

click [general_combat].[xuli] hold 1.52 after wait 0.8
click [general_combat].[xuli] hold 1.52 after wait 0.8

# 二次点剑
log info "第二次点剑+瞬发剑气"
click [general_combat].[wuxueji] hold 0.06 after wait 0.3
click [general_combat].[xuli] hold 0.06 after wait 0.8

# 三道剑气
click [general_combat].[xuli] hold 1.52 after wait 0.8
click [general_combat].[xuli] hold 1.52 after wait 0.8
click [general_combat].[xuli] hold 1.52 after wait 0.8

# 枪Q 挂 buff，这里容易出现切剑没切回来
log info "第二次枪Q，挂 buff"
call qiang_wuxueji_android(1)

click [general_combat].[xuli] hold 1.52 after wait 0.8
click [general_combat].[xuli] hold 1.52 after wait 0.8

# 第三次瞬发
log info "第三次瞬发剑气"
click [general_combat].[xuli] hold 0.06 after wait 0.8

# 三道剑气
click [general_combat].[xuli] hold 1.52 after wait 0.8
click [general_combat].[xuli] hold 1.52 after wait 0.8
click [general_combat].[xuli] hold 1.52 after wait 0.8

# 枪Q
log info "第三次枪Q，挂 buff"
call qiang_wuxueji_android(1)

click [general_combat].[xuli] hold 1.52 after wait 0.8
click [general_combat].[xuli] hold 1.52 after wait 0.8

# 吹笛拉距离：0.1 秒推到后退方向，再保持 2.1 秒，总时长 2.2 秒
click [general_combat].$qishu_dz hold 0.12 after wait 0.1
drag [general_move].[move_backward] duration 0.1 hold 2.1 exact after wait 0.95

# 第四次瞬发剑气
log info "第三次点剑+第四次瞬发剑气"
click [general_combat].[wuxueji] hold 0.06 after wait 0.28
click [general_combat].[xuli] hold 0.06 after wait 0.8
# 继续蓄力
click [general_combat].[xuli] hold 1.52 after wait 0.8

log info "第四次枪Q"
call qiang_wuxueji_android(0)

click [general_combat].[xuli] hold 1.52 after wait 0.8
click [general_combat].[xuli] hold 1.52 after wait 0.8

log info "第五次瞬发剑气"
click [general_combat].[xuli] hold 0.06 after wait 0.8
click [general_combat].[xuli] hold 1.52 after wait 0.8
click [general_combat].[xuli] hold 1.52 after wait 0.8
# 最后一次剑气，打不出来就是延迟问题
click [general_combat].[xuli] hold 1.52

# ─── qiang_wuxueji_android ────────────────────────────────
# 安卓端枪 Q 连段：切枪 → 武学技 → 卸势 → 切回剑（内部过程）。
#
# 参数：
#   $buff — 1=本次要挂 buff（武学技等待更长），0=普通连段
# 前置：当前持剑且已站在木桩攻击范围内。
# 后置：连段按钮已点完，结束时持剑。
# 返回：无返回值（隐式 null）。
def qiang_wuxueji_android($buff)
    # 切武器 → 武学技 → 卸势 → 切回剑；挂 buff 时为武学技留更长等待
    if $buff
        click [general_combat].[weapon] hold 0.08 after wait 0.07
        click [general_combat].[wuxueji] hold 0.12 after wait 0.3
        click [general_combat].[xieshi] hold 0.08 after wait 0.12
        click [general_combat].[weapon] hold 0.08 after wait 0.3
    else
        click [general_combat].[weapon] hold 0.08 after wait 0.07
        click [general_combat].[wuxueji] hold 0.08 after wait 0.16
        click [general_combat].[xieshi] hold 0.08 after wait 0.11
        click [general_combat].[weapon] hold 0.08 after wait 0.3
    end
end

return
