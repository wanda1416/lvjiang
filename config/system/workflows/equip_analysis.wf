# 装备分析工作流

call "subcall/navigate_to_equip.wf"

# 点击主武器
click [bag_equip_detail].[slot_main_weapon]
wait step_interval
scan [equip_weapon_detail] as $main_weapon_scan
eval main_weapon = equipment_parser($main_weapon_scan)
collect $main_weapon

click [bag_equip_detail].[slot_sub_weapon]
wait step_interval
scan [equip_weapon_detail] as $sub_weapon_scan
eval sub_weapon = equipment_parser($sub_weapon_scan)
collect $sub_weapon

click [bag_equip_detail].[slot_ring]
wait step_interval
scan [equip_weapon_detail] as $ring_scan
eval ring = equipment_parser($ring_scan)
collect $ring

click [bag_equip_detail].[slot_pendant]
wait step_interval
scan [equip_weapon_detail] as $pendant_scan
eval pendant = equipment_parser($pendant_scan)
collect $pendant

click [bag_equip_detail].[slot_head]
wait step_interval
scan [equip_armor_detail] as $head_scan
eval head = equipment_parser($head_scan)
collect $head

click [bag_equip_detail].[slot_chest]
wait step_interval
scan [equip_armor_detail] as $chest_scan
eval chest = equipment_parser($chest_scan)
collect $chest

click [bag_equip_detail].[slot_leg]
wait step_interval
scan [equip_armor_detail] as $leg_scan
eval leg = equipment_parser($leg_scan)
collect $leg

click [bag_equip_detail].[slot_wrist]
wait step_interval
scan [equip_armor_detail] as $wrist_scan
eval wrist = equipment_parser($wrist_scan)
collect $wrist

# 返回主界面
click [bag_equip_detail].[back]
wait step_interval

click [bag_equip_detail].[back]
wait step_interval

click [game_menu_page].[back]
