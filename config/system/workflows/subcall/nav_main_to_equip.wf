#% name: 导航至装备页

# 从主界面导航到装备培养页面
# 路径：主界面 → 菜单 → 包裹 → 培养（如不在装备页则自动切换）

def nav_main_to_equip()
    scan [game_menu_page].[wulinlu] as $result
    if not $result.[wulinlu] equals "武林录"
       click [game_main_page].[menu] after wait step_interval
    else 
       log "当前在菜单页" 
    end

    click [game_menu_page].[bag] after wait step_interval

    # 点击培养（可能点开包裹后在道具页等其他页面，需要判断当前）
    scan [bag_equip_detail].[sub_equip] as $bag_scan
    if not $bag_scan.sub_equip contains "装备"
        click [bag_equip_detail].[training] after wait step_interval
    end
end
