# 单次调律工作流

# 点开菜单
click [game_main_page].[menu]
wait step_interval

# 点击包裹
click [game_menu_page].[bag]
wait step_interval

# 点击培养（可能点开包裹后在道具页等其他页面，需要判断当前）
scan [bag_equip_detail].[sub_equip] as $bag_scan
if not $bag_scan.sub_equip contains "装备"
    click [bag_equip_detail].[training]
    wait step_interval
end

# 点击主武器
click [bag_equip_detail].[slot_main_weapon]
wait step_interval

click [bag_equip_detail].[bag_1_1]
wait step_interval

click [equip_weapon_detail].[more_func]
wait step_interval

scan [equip_weapon_detail].[sub_func_1, sub_func_2, sub_func_3, sub_func_4] as $tune_scan
find $tune_scan "调律" as $tune_pos
if not $tune_pos
    log "未找到调律按钮"
    return
end
click $tune_pos
wait step_interval

scan [equip_tune_detail].[one_click_add] as $add_scan
if not $add_scan.one_click_add contains "添加"
    log "装备已调律完毕，无需调律"
    return
end

click [equip_tune_detail].[one_click_add]
wait step_interval

click [equip_tune_detail].[tune_btn]
wait step_interval

wait after_tune_wait
scan [equip_tune_result] as $result
log "调律结果已识别"
collect $result

click [equip_tune_result].[close_btn]
wait step_interval

click [equip_tune_detail].[back]
wait step_interval

click [bag_equip_detail].[back]
wait step_interval

click [bag_equip_detail].[back]
wait step_interval

click [bag_equip_detail].[back]
wait step_interval

click [game_menu_page].[back]
