#% name: 选择角色
#% parameters:
#%   - name: role_idx
#%     label: 角色下标（1-4）
#%     type: number
#%     default: 1

# 同账号仅选角色 + 进入游戏（跳过选账号流程）

import "_common.wf"

# ─── 主流程 ─────────────────────────────────────────────
log concat("当前角色", $role_idx)

# 选角色 + 进入游戏（复用公共子过程）
call select_role_and_enter($role_idx)
