#% id: stake_pozhuchen
#% name: 破竹尘木桩测伤
#% runnable: true
#% env: [desktop]
#% note: |-
#%   破竹尘新赛季完美84伞木桩轴，需要开局切绳镖面向木桩约5米并且锁定视角。
#%   PC 端：将滚轮切武器绑定小键盘 8；默认使用 Q = 武学技、E = 卸势、` = 特殊技。
#% parameters:
#%   - name: key_dz
#%     label: 萧吟千浪
#%     env: [desktop]
#%     type: select
#%     default: "4"
#%     options: ["1", "2", "3", "4", "7", "8", "9", "0"]

default $key_dz = "4"

