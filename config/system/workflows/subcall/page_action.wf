#% name: 页面公共动作子过程集合

# 页面公共动作库：把「确认/取消弹窗」这类跨业务重复出现的动作收敛到一处。
# 只负责扫描、点击与如实返回是否命中，不做业务判断；动作语义由调用方给出。
# click 的实际形式（点按钮 / 按 SPACE / 按 ESC）由布局决定，这里不区分平台。
#
# 包含过程：
#   scan_and_confirm — 扫描并确认通用弹窗（返回 1=已确认 / 0=未出现弹窗）
#   scan_and_cancel  — 扫描并取消通用弹窗（返回 1=已取消 / 0=未出现弹窗）
#   close_item_prompts — 关闭安卓端购买后的物品说明浮窗（返回累计关闭数量）

# ─── scan_and_confirm ─────────────────────────────────────
# 扫描并确认通用确认弹窗；$action_name 只用于日志，不参与判定。
#
# 参数：
#   $action_name     — 动作名，拼进日志（如「领取不肝奖励」）
#   $warn_if_missing — true=没扫到弹窗记 warn（必现弹窗）；false=记 debug（可选弹窗）
# 前置：可能已经弹出确认弹窗，也可能没有。
# 后置：命中时点击了确认区域；没命中时不点击任何东西。
# 返回：1=已确认；0=未扫描到确认弹窗。
#
# 同时扫描确认和取消：确认按钮可能因高亮、动画等原因暂时 OCR 为空，
# 只要任一按钮命中即可证明弹窗存在；实际动作始终点击确认区域。
# click 由布局决定点击按钮还是按 SPACE。
def scan_and_confirm($action_name, $warn_if_missing)
   eval $message = $action_name + "：扫描确认弹窗"
   log info $message
   eval $dialog_labels = ["确认", "确定", "取消"]
   scan [general_control].[confirm, cancel] as $dialog_key by contains_any $dialog_labels
   if not $dialog_key
      if $warn_if_missing
         eval $message = $action_name + "：未扫描到确认或取消按钮"
         log warn $message
      else
         eval $message = $action_name + "：未出现可选确认弹窗"
         log debug $message
      end
      return 0
   end
   eval $message = $action_name + "：扫描到确认弹窗，执行确认"
   log info $message
   click [general_control].[confirm] after wait @page_refresh
   return 1
end

# ─── scan_and_cancel ──────────────────────────────────────
# 扫描并取消通用确认弹窗；用于"顺带弹出、本流程不接受"的询问，
# 例如领奖后追问是否再去领另一份奖励。
#
# 参数：
#   $action_name — 动作名，拼进日志
# 前置：可能已经弹出了询问弹窗。
# 后置：命中时点击了取消区域；没命中时不点击任何东西。
# 返回：1=已取消；0=没有弹窗。
#
# 判据与 scan_and_confirm 同源（确认/取消任一命中即证明弹窗存在），但动作是
# 点击取消；click 由布局决定点击按钮还是按 ESC。
def scan_and_cancel($action_name)
   eval $dialog_labels = ["确认", "确定", "取消"]
   scan [general_control].[confirm, cancel] as $dialog_key by contains_any $dialog_labels
   if not $dialog_key
      eval $message = $action_name + "：未出现询问弹窗"
      log debug $message
      return 0
   end
   eval $message = $action_name + "：出现询问弹窗，执行取消"
   log info $message
   click [general_control].[cancel] after wait @page_refresh
   return 1
end

# ─── close_item_prompts ───────────────────────────────────
# 关闭安卓端购买后连续保留的物品说明浮窗，直到一个都匹配不到。
#
# 参数：无
# 前置：购买动作已完成，浮窗可能叠了多层。
# 后置：所有命中到的浮窗都已关闭；桌面端不做任何点击。
# 返回：累计关闭的浮窗数量（桌面端恒为 0）。
#
# 逐个匹配关闭按钮并点击，每次等待界面刷新后继续检查，直到所有浮窗都已关闭。
def close_item_prompts()
   if not env("android")
      return 0
   end
   eval $closed_count = 0
   loop while 1 == 1
      scan [general_control].[close_item] as $close_item by image
      if not $close_item
         break
      end
      click [general_control].[close_item] after wait @step_interval
      eval $closed_count = $closed_count + 1
   end
   return $closed_count
end
