#% name: 登录子过程集合

# 登录相关公共过程库：账号切换、角色选择与退出登录。
# 登录页的现场判定（is_in_login_page / is_in_startup_page）定义在本文件，
# page_detection.wf 只放通用页面判定。
#
# 与批量调度的约定：条目准备 / 收尾把 $batch_state 传进来，本文件就地更新它的
# account / role / page_state 字段，并以 {"status", "message", "state"} 结果
# 字典汇报；纯页面判定过程只返回 1/0，不起草结果字典。
#
# 包含过程（参数见各过程注释）：
#   prepare_user                 — 登录总入口：切账号并选好角色，返回批量结果字典
#   is_in_login_page             — 是否在登录主页（1=在 / 0=不在）
#   ensure_login_page_by_restart — 重启客户端并恢复到登录主页（1=成功 / 0=失败）
#   is_in_startup_page           — 是否停在游戏启动页（1=在 / 0=不在）
#   leave_startup_page           — 启动页点返回进入登录主页（1=成功 / 0=失败）
#   wait_for_switch_users_page   — 等 PC 端「切换用户」视图就绪（1=就绪 / 0=超时）
#   exit_to_login                — 游戏内退回到登录页（无返回值）
#   switch_account               — 登录页选账号并登录（1=成功 / 0=未完成）
#   select_account_and_login     — 在切换用户视图里找到并登录账号（1=已提交）
#   user_list_unchanged          — 账号列表是否已到边（1=不动了 / 0=还在动）
#   search_account_down          — 向下翻找目标账号（1=已点击 / 0=未找到）
#   scroll_user_list_to_top      — 把账号列表滚回顶部（1=已到顶 / 0=达上限）
#   select_role                  — 选角色并进入游戏主页，返回批量结果字典
#   wait_until_role_offline      — 处理「其他角色在线」弹窗（0=可登录 / 1=放弃）
#   login_to_main_page           — 等登录加载完成并回主页（更新提示返回 2）
#   claim_zhanling_reward        — 检测战令领奖入口，有则领取（无返回值）

import "subcall/navigation.wf"
import "subcall/page_detection.wf"

# ─── prepare_user ─────────────────────────────────────────
# 登录总入口：把指定用户带到「已进入游戏」的状态，供批量条目准备调用。
#
# 参数：
#   $username             — 用户配置名，account/role/role_index/tail 都从这里读
#   $batch_state          — 批量运行状态（就地更新 account/role/page_state）
#   $skip_online_role     — true=角色在线直接跳过，false=等到 $online_role_max_wait
#   $online_role_max_wait — 等待角色下线的秒数上限
#   $max_roll_account     — 账号列表单轮滚动步数上限
#   $allow_restart_app    — 不在登录页/启动页时是否允许重启客户端
# 前置：任意页面；本过程按需要回登录页或重启客户端。
# 后置：success=已在游戏主页且 $batch_state 记录 account/role/page_state=2；
#       skipped=角色在线，已复位到登录页状态（page_state=1）；
#       failed=停在当前现场，交给调用方处理。
# 返回：{"status": "success"|"skipped"|"failed", "message": str, "state": $batch_state}
def prepare_user($username, $batch_state, $skip_online_role, $online_role_max_wait, $max_roll_account, $allow_restart_app)
    eval check_env(["android", "desktop"])
    eval $account = user_get($username, "account")
    eval $role = user_get($username, "role")
    eval $role_index = user_get($username, "role_index")
    eval $tail = user_get($username, "tail")
    if not $account
        return {"status": "failed", "message": "用户未配置账号名", "state": $batch_state}
    end
    if not $role
        return {"status": "failed", "message": "用户未配置角色名", "state": $batch_state}
    end
    if not $role_index
        return {"status": "failed", "message": "用户未配置角色序号", "state": $batch_state}
    end
    # 自动流程停下来求助时，人工要能一眼看出该把客户端摆成什么样。批量里
    # 多个用户轮流跑，隔了几分钟回来看到一句「请手动选定账号」是没法操作的。
    eval $login_target = "账号 " + $account + "（尾号 " + $tail + "）、角色 " + $role

    call $in_login_page = is_in_login_page()
    if not $in_login_page
        call $in_startup_page = is_in_startup_page()
        if $in_startup_page
            call $in_login_page = leave_startup_page()
        else if $allow_restart_app
            if env("desktop") and not $tail
                return {"status": "failed", "message": "用户未配置账号尾号", "state": $batch_state}
            end
            call $in_login_page = ensure_login_page_by_restart(
                "yyslscn", $tail, $account, $batch_state, $max_roll_account,
                $login_target)
        else
            screenshot from last
            eval pause("当前不在登录页，请切换到登录页后点击继续。本次目标："
                + $login_target)
            call $in_login_page = is_in_login_page()
        end
        if not $in_login_page
            return {"status": "failed", "message": "未能回到登录主页", "state": $batch_state}
        end
    end

    log "目标账号：" + $account
    if $batch_state.account != $account
        if not $tail
            return {"status": "failed", "message": "用户未配置账号尾号", "state": $batch_state}
        end
        log "需要切换账号: " + $account
        call $switched = switch_account(
            $tail, $account, $batch_state, $max_roll_account, $login_target)
        if not $switched
            return {"status": "failed", "message": "未能切换到目标账号", "state": $batch_state}
        end
    end

    log "切换角色: " + $role
    call $result = select_role($role_index, $role, $batch_state, $skip_online_role, $online_role_max_wait)
    return $result
end


# ─── is_in_login_page ─────────────────────────────────────
# 是否在登录主页。
#
# 参数：无
# 前置：无。
# 后置：无副作用（只识别，最多多等一拍）。
# 返回：1=在登录主页；0=不在。
# 判据：「选择角色」按钮命中；第一次读不到时隔 5 秒再确认一次，
# 容忍刚切回登录页时页面还没渲染完的情况。
def is_in_login_page()
    scan [game_login_page].[switch_role] as $login_check by contains "选择角色"
    if $login_check
        return 1
    end
    wait 5
    scan [game_login_page].[switch_role] as $login_check by contains "选择角色"
    if $login_check
        return 1
    end
    return 0
end


# ─── ensure_login_page_by_restart ─────────────────────────
# 重启客户端并恢复到登录主页：PC 重启后落在切换用户视图，安卓重启后落在启动页。
#
# 参数：
#   $app_id           — 客户端 id（app stop / app start 用）
#   $tail、$account   — 目标账号尾号与账号名
#   $batch_state      — PC 分支成功后写入 account、清空 role、page_state=1
#   $max_roll_account — 账号列表单轮滚动步数上限
#   $login_target     — 人工提示文案（账号 + 角色）
# 前置：调用方已确认当前既不在登录主页也不在启动页，且目标账号资料已校验齐全。
# 后置：1=已回到登录主页（PC 端并登录了目标账号）；0=失败，现场停在中断处。
# 返回：1=成功；0=失败。
#
# 登录页背景动画常驻，不等稳定帧；启动页用游戏 logo 识别。
# 账号已在 PC 分支选定，prepare_user 随后会直接选择角色，不再重复切换账号。
def ensure_login_page_by_restart($app_id, $tail, $account, $batch_state, $max_roll_account, $login_target)
    if app_is_running($app_id)
        app stop $app_id
    end
    app start $app_id timeout 30
    if env("desktop")
        scene [game_login_page] view [users]
        call $ready = wait_for_switch_users_page()
        if not $ready
            return 0
        end
        call $logged_in = select_account_and_login(
            $tail, $max_roll_account, $login_target)
        if not $logged_in
            return 0
        end
        # PC 仅在重启后的首次账号登录会进入启动页；关闭后即回到登录主页。
        # 账号已经在本分支选定，prepare_user 随后会直接选择角色，不再重复切换账号。
        call $in_login_page = leave_startup_page()
        if not $in_login_page
            return 0
        end
        eval $batch_state.account = $account
        eval $batch_state.role = ""
        eval $batch_state.page_state = 1
        return 1
    end
    scene [game_login_page] view [init]
    call $in_login_page = leave_startup_page()
    return $in_login_page
end


# 登录提示只按“更新”和“在线”分流，更新优先；一帧文字只识别一次。
def login_notice_kind($text)
    if $text contains "更新"
        return "update"
    end
    if $text contains "在线"
        return "online"
    end
    return ""
end

def read_login_notice()
    scan [game_login_page].[online_label] as $notice
    call $kind = login_notice_kind($notice.online_label)
    return $kind
end

# 更新保留当前账号，不调用 select_account_and_login/switch_account。
# 返回 1=已恢复登录主页；0=失败。确认前由调用方已判定更新提示。
def recover_login_after_update($batch_state)
    log info "检测到登录更新提示，确认后重新启动客户端，保留当前账号"
    click [game_login_page].[confirm] after wait @page_refresh
    eval $batch_state.role = ""
    eval $batch_state.page_state = 0
    if app_is_running("yyslscn")
        app stop "yyslscn"
    end
    app start "yyslscn" timeout 30
    if env("desktop")
        scene [game_login_page] view [users]
        call $ready = wait_for_switch_users_page()
        if not $ready
            return 0
        end
        click [game_login_page].[login] after wait @page_refresh
    end
    scene [game_login_page] view [init]
    call $ready = leave_startup_page()
    if not $ready
        return 0
    end
    eval $batch_state.role = ""
    eval $batch_state.page_state = 1
    log info "更新后已恢复登录主页，继续选择原账号下的目标角色"
    return 1
end


# ─── is_in_startup_page ───────────────────────────────────
# 是否停在游戏启动页。
#
# 参数：无
# 前置：无。
# 后置：无副作用。
# 返回：1=在启动页；0=不在。
# 判据：启动 logo（图像匹配），启动过程有动画，只认 logo 不认其它元素。
def is_in_startup_page()
    scan [game_login_page].[yysls_logo] as $logo by image
    if $logo
        return 1
    end
    return 0
end


# ─── leave_startup_page ───────────────────────────────────
# 从启动页点返回，进入登录主页。
#
# 参数：无
# 前置：客户端已启动（可能还在加载，最多等 60 拍直到 logo 出现）。
# 后置：1=已进入登录主页；0=启动页和登录页都没识别到，现场未变。
# 返回：1=成功；0=失败。
#
# back 仅是点击目标；启动页必须由 logo 判定。
def leave_startup_page()
    eval $startup_ready = 0
    loop 60
        call $startup_ready = is_in_startup_page()
        if $startup_ready
            break
        end
        wait @page_refresh
    end
    if not $startup_ready
        screenshot from last
        eval pause("未检测到游戏启动页标志，请手动回到登录主页后点击继续")
        call $in_login_page = is_in_login_page()
        if $in_login_page
            return 1
        end
        call $startup_ready = is_in_startup_page()
        if not $startup_ready
            screenshot from last
            return 0
        end
    end
    click [game_login_page].[back] after wait @page_refresh
    call $in_login_page = is_in_login_page()
    if not $in_login_page
        screenshot from last
        eval pause("点击启动页返回后未进入登录主页，请手动处理后点击继续")
        call $in_login_page = is_in_login_page()
        if not $in_login_page
            screenshot from last
        end
    end
    return $in_login_page
end


# ─── wait_for_switch_users_page ───────────────────────────
# 等 PC 端「切换用户」视图就绪。
#
# 参数：无
# 前置：调用方已经把场景/view 切到 users 视图。
# 后置：就绪或超时都停在原视图，不做点击。
# 返回：1=已就绪；0=60 拍内没读到「进入游戏」，人工介入后仍未就绪。
def wait_for_switch_users_page()
    eval $ready = 0
    loop 60
        scan [game_login_page].[login] as $ready by contains "进入游戏"
        if $ready
            return 1
        end
        wait @page_refresh
    end
    screenshot from last
    eval pause("未检测到切换用户页的「进入游戏」，请手动定位后点击继续")
    scan [game_login_page].[login] as $ready by contains "进入游戏"
    if $ready
        return 1
    end
    screenshot from last
    return 0
end


# ─── exit_to_login ────────────────────────────────────────
# 从游戏内退回到登录页：主页进菜单 → 菜单点退出 → 二次确认弹窗点「登录」。
#
# 参数：无
# 前置：在游戏主页（内部走 nav_main_to_menu，自带到位校验）。
# 后置：成功时已在登录页；菜单没进去或找不到「返回登录」按钮时交给人工。
# 返回：无返回值（隐式 null），是否真的退出由调用方按页面判定确认。
#
# 走标准导航而不是直接点菜单，是为了复用 nav_main_to_menu 的到位校验。
def exit_to_login()
    # 1. 主页 → 菜单
    # 走标准导航并自带到位校验；click 由布局选择点菜单或按 ESC。
    call $in_menu = nav_main_to_menu()
    if $in_menu < 0
        log "未能进入菜单页，退出流程可能落空"
    end

    # 2. 菜单 → 退出（两端行为一致）
    click [game_menu_page].[exit] after wait @page_refresh

    # 3. 二次确认：检查退出弹窗中是否有「返回登录页面」按钮
    scan [game_login_page].[back_to_login] as $result by contains "返回登录"
    if $result
        click [game_login_page].[back_to_login] after wait @secondary_confirm
    else
        screenshot from last
        eval pause("未找到「返回登录界面」按钮，请手动退出到登录页后点击继续")
    end
end


# ─── switch_account ───────────────────────────────────────
# 登录页 → 选账号 → 登录 → 回到登录页角色入口（page_state=1）。
#
# 参数：
#   $tail、$account    — 目标账号尾号与账号名
#   $batch_state       — 成功后写入 account、清空 role、page_state=1
#   $max_roll_account  — 账号列表单轮滚动步数上限
#   $login_target      — 人工提示文案（账号 + 角色）
# 前置：在登录主页。
# 后置：1=已登录目标账号并回到角色入口；0=账号登录未完成。
# 返回：1=成功；0=失败。
#
# 不包含选角色，由调用方决定是否接着调用 select_role。
# 两端进用户视图的方式不同：PC 要先登出再点选择账号，安卓直接选用户即可。
def switch_account($tail, $account, $batch_state, $max_roll_account, $login_target)
    log "当前匹配" + $tail

    # 1. 登录页 → 用户切换视图
    click [game_login_page].[more_user] after wait @page_refresh
    click [game_login_page].[user_icon] after wait @page_refresh

    if env("desktop")
        # PC 端需要登出 后再点击触发 选择账号 登录
        scan [game_login_page].[switch_user] as $found by contains "登出"
        if not $found
            # 疑似登出太浅无法识别，此时继续识别是否存在 进入游戏，如果不存在那就是没有登出
            scan [game_login_page].[login] as $login_game by contains "进入游戏"
            if not $login_game
                $found = "登出"
            end
        end
        if $found
            click [game_login_page].[switch_user] after wait @page_refresh
            click [game_login_page].[user_icon] after wait @page_refresh
        end
    else if env("android")
        # 安卓端直接可以选择用户完成账号切换
        click [game_login_page].[switch_user] after wait @page_refresh
    end

    call $logged_in = select_account_and_login(
        $tail, $max_roll_account, $login_target)
    if not $logged_in
        return 0
    end
    # 非重启账号切换登录后直接回到登录主页，不经过启动页。
    eval $batch_state.account = $account
    eval $batch_state.role = ""
    eval $batch_state.page_state = 1
    return 1
end


# ─── select_account_and_login ─────────────────────────────
# 在切换用户视图里找到目标账号并提交登录。
#
# 参数：
#   $tail             — 目标账号尾号（contains 匹配）
#   $max_roll_account — 单轮滚动步数上限（保险值，到边由列表是否还在动判定）
#   $login_target     — 人工提示文案（账号 + 角色）
# 前置：已经进入切换用户视图。
# 后置：1=已点击登录；账号没找到时先 pause 交人工选定再继续提交。
# 返回：1=已提交登录（是否真的登进去由调用方按页面判定）。
#
# 这里只负责选择并登录账号；登录后的页面流转由
# 调用方按“PC 重启”或“普通账号切换”各自处理。
# 入场时列表停在哪里未知，失败一轮先回顶再从头翻，两轮覆盖全表。
def select_account_and_login($tail, $max_roll_account, $login_target)
    click [game_login_page].[tap_user] after wait @page_refresh

    # 2. 查找目标账号：一轮向下翻到底，没找到就回到顶部再翻一轮。
    #
    # 入场时列表停在哪里是未知的——账号多的时候它常常停在中间，只向下翻永远
    # 看不到上面的账号。所以失败一轮后必须先回顶，再从头完整走一遍。
    #
    # $max_roll_account 只是单轮的保险上限，不再是「预期要翻几次」：到底/到顶
    # 由列表自己是否还在动来判定（见 user_list_unchanged），通常远早于上限结束。
    eval $extra_passes = 1
    eval $pass = 0
    eval $found_user = 0
    loop while $pass <= $extra_passes
        call $found_user = search_account_down($tail, $max_roll_account)
        if $found_user
            break
        end
        eval $pass_no = $pass + 1
        log warn "第 " + $pass_no + " 轮翻到底仍未找到账号：" + $login_target
        if $pass >= $extra_passes
            break
        end
        call $at_top = scroll_user_list_to_top($max_roll_account)
        if not $at_top
            log warn "回顶时已达单轮滚动上限 " + $max_roll_account \
                + "，下一轮从当前位置开始"
        end
        eval $pass = $pass + 1
    end

    # 找不到 → 暂停手动处理。这里不做二次校验：选没选对只有人能判断，
    # 所以提示必须写清该登录哪个账号，把正确性交给人工确认。
    if not $found_user
        log warn "两轮账号搜索未命中，记录最后观察帧和当前列表"
        screenshot from last
        screenshot
        eval pause("未找到账号，请手动选定并登录：" + $login_target
            + "，选好后点击继续")
    end
    wait @page_refresh

    # 3. 提交账号登录；登录后的页面由调用方按所在流程处理。
    click [game_login_page].[login] after wait @page_refresh
    return 1
end


# ─── 账号列表的翻动与到边判定 ─────────────────────────────────────────
# 本节三个过程共用同一套到边判定：滚动一步后两次快照是否还在变化。

# ─── user_list_unchanged ──────────────────────────────────
# 列表是否不动了（= 已经到底或到顶）。
#
# 参数：
#   $a — 上一帧 user_list 快照；空表示还没有上一帧（本轮第一步），此时不可能判定到边
#   $b — 当前帧快照
# 前置：两帧都由同一区域（game_login_page.user_list）scan 得到。
# 后置：无副作用。
# 返回：1=两帧逐格相同（到边）；0=还在动或无法判定。
#
# 判据是 user_list 整面板的两次 OCR 快照逐格相同：滚一步而内容没变，说明
# 已经到边。这样就不必预设「要翻几次」——账号数量、行高和设备分辨率都会影响
# 实际步数，预设值只会在账号变多后悄悄失效。
#
# 行数取快照自己的 key，不问 panel_rows：后者读的是 _panel_alignments 这条
# 侧信道，依赖「刚好对齐过这个面板」的调用次序，而这里要比的就是 scan 实际
# 产出的那几格。
#
# OCR 抖动只会让两帧「看起来不同」从而多滚一步，不会误判成到边；反过来两屏
# 不同内容恰好识别成完全相同在这个面板上不现实。
def user_list_unchanged($a, $b)
    if $a is_empty
        return 0
    end
    if len($a) != len($b)
        return 0
    end
    eval $col = 1
    for r in keys($b)
        if $a.$r.$col != $b.$r.$col
            return 0
        end
    end
    return 1
end


# ─── search_account_down ──────────────────────────────────
# 向下翻找目标账号，命中即点击。
#
# 参数：
#   $tail      — 目标账号尾号（contains 匹配）
#   $max_steps — 单轮滚动步数上限
# 前置：在切换用户视图，账号列表可见。
# 后置：命中时已点击该账号；未命中时列表停在到底位置。
# 返回：1=已点击目标账号；0=翻到底或达到上限仍未命中。
#
# 命中判定保持用 find：按文字精确 bbox 点击是原有行为，而「选没选对」只有人
# 能判断，这条路径不动。快照只用于到边判定，每步各一次。
def search_account_down($tail, $max_steps)
    eval $prev = {}
    loop $max_steps
        find [game_login_page].[user_list] as $found_user by contains $tail
        if $found_user
            click $found_user
            return 1
        end
        scan [game_login_page].[user_list] as $snap
        call $stuck = user_list_unchanged($prev, $snap)
        if $stuck
            log info "账号列表已到底，本轮未找到目标账号"
            return 0
        end
        eval $prev = $snap
        env:"android" -> drag [game_login_page].[point_2] to [game_login_page].[point_1]
        env:"desktop" -> scroll [game_login_page].[user_list] down 2
        wait @page_refresh
    end
    return 0
end


# ─── scroll_user_list_to_top ──────────────────────────────
# 把账号列表滚回顶部，供第二轮搜索从头开始。
#
# 参数：
#   $max_steps — 滚动步数上限
# 前置：在切换用户视图。
# 后置：到顶或到上限后停下，不做点击。
# 返回：1=已到顶；0=达到上限仍没到顶（调用方只记日志，仍可继续）。
def scroll_user_list_to_top($max_steps)
    eval $prev = {}
    loop $max_steps
        scan [game_login_page].[user_list] as $snap
        call $stuck = user_list_unchanged($prev, $snap)
        if $stuck
            return 1
        end
        eval $prev = $snap
        env:"android" -> drag [game_login_page].[point_1] to [game_login_page].[point_2]
        env:"desktop" -> scroll [game_login_page].[user_list] up 2
        wait @page_refresh
    end
    return 0
end


# ─── select_role ──────────────────────────────────────────
# 选好角色并进入游戏主页。
#
# 参数：
#   $role_index           — 角色在列表中的序号（1 起，对应角色列表行）
#   $role                 — 角色名（日志与人工提示用）
#   $batch_state          — 成功后写入 role 与 page_state=2
#   $skip_online_role     — true=角色在线立即跳过，false=等到期限
#   $online_role_max_wait — 等待角色下线的秒数上限
# 前置：已在登录页角色入口（page_state=1）。
# 后置：success=已在游戏主页；skipped=角色在线，已复位回登录页状态。
# 返回：{"status": "success"|"skipped"|"failed", "message": str, "state": $batch_state}
def select_role($role_index, $role, $batch_state, $skip_online_role, $online_role_max_wait)
    call $result = select_role_with_policy($role_index, $role, $batch_state, $skip_online_role, $online_role_max_wait, false)
    return $result
end

# 异常恢复保留在线确认顶下线策略；正常登录仍取消/等待，不互相借用策略。
def select_role_with_policy($role_index, $role, $batch_state, $skip_online_role, $online_role_max_wait, $force_online)
    log "当前下标" + $role_index
    loop while 1 == 1
        eval $online_deadline = clock() + to_num($online_role_max_wait)
        eval $role_page = 0
        eval $role_attempt = 0
        loop while $role_attempt < 5
            click [game_login_page].[switch_role] after wait @secondary_confirm
            call $online = resolve_role_entry_notice($batch_state, $skip_online_role, $online_deadline, $force_online)
            if $online < 0
                return {"status": "failed", "message": "更新后未能恢复登录主页", "state": $batch_state}
            end
            if $online == 2
                # 更新不计入页面失败次数；恢复后重启在线等待计时。
                eval $online_deadline = clock() + to_num($online_role_max_wait)
                continue
            end
            if $online == 1
                return {"status": "skipped", "message": "角色在线", "state": $batch_state}
            end
            call $role_page = is_in_role_select_page()
            if $role_page
                break
            end
            eval $role_attempt = $role_attempt + 1
            log "未进入选择角色页面，重试"
        end
        if not $role_page
            screenshot from last
            eval pause("无法进入选择角色页面，请手动进入角色列表后点击继续。"
                + "本次目标角色：" + $role + "（第 " + $role_index + " 个）")
        end
        click [game_login_page].[role_list][$role_index][1] after wait @page_refresh
        click [game_login_page].[enter] after wait @secondary_confirm
        call $landed = login_to_main_page()
        if $landed == 2
            call $recovered = recover_login_after_update($batch_state)
            if not $recovered
                return {"status": "failed", "message": "更新后未能恢复登录主页", "state": $batch_state}
            end
            continue
        end
        eval $batch_state.page_state = 2
        eval $batch_state.role = $role
        wait @step_interval
        return {"status": "success", "message": "", "state": $batch_state}
    end
end


# ─── wait_until_role_offline ──────────────────────────────
# 处理「其他角色在线」弹窗：等角色下线，或按策略放弃等待。
#
# 参数：
#   $batch_state      — 放弃等待时就地复位（page_state=1、role 清空）
#   $skip_online_role — true=发现在线立即放弃，false=等到 $online_deadline
#   $online_deadline  — 等待截止时刻（clock() 时间戳）
# 前置：刚点过「切换角色」，弹窗可能出现。
# 后置：0=角色可登录（没有在线提示）；1=已放弃，弹窗已取消、界面干净。
# 返回：0=可登录；1=在线放弃；2=更新已恢复；-1=更新恢复失败。
#
# 点「切换角色」可能撞上「其他角色在线」弹窗。弹窗必须取消——留着会挡住
# 后续任何页面判定。等待模式下由本过程自己重试到期限：取消弹窗、等一会儿、
# 重新点回「切换角色」再查；不重新点就永远读不到提示已经消失。
# 放弃时把 batch_state 复位回登录页状态并返回 1，调用方据此以 skipped 收尾
# （status/message 的措辞由调用方上下文决定）。
def wait_until_role_offline($batch_state, $skip_online_role, $online_deadline)
    call $result = resolve_role_entry_notice($batch_state, $skip_online_role, $online_deadline, false)
    return $result
end

# 0=无阻挡；1=在线放弃；2=更新已恢复，需要重新选角色；-1=更新恢复失败。
def resolve_role_entry_notice($batch_state, $skip_online_role, $online_deadline, $force_online)
    loop while 1 == 1
        call $notice = read_login_notice()
        if $notice == "update"
            call $recovered = recover_login_after_update($batch_state)
            if $recovered
                return 2
            end
            return -1
        end
        if $notice != "online"
            return 0
        end
        if $force_online
            log info "角色仍被服务端认为在线，确认后继续重新登录"
            click [game_login_page].[confirm] after wait @page_refresh
            return 0
        end
        click [game_login_page].[cancel] after wait @page_refresh
        if $skip_online_role
            log "角色在线，不可登录，跳过"
        else if clock() < $online_deadline
            log "角色仍在线，30 秒后重试登录"
            wait 30
            click [game_login_page].[switch_role] after wait @secondary_confirm
            continue
        else
            log "角色在线等待超时，跳过"
        end
        eval $batch_state.page_state = 1
        eval $batch_state.role = ""
        return 1
    end
end


# ─── login_to_main_page ───────────────────────────────────
# 等待登录加载完成并回到游戏主页（顺带领战令奖励、关掉挡路弹窗）。
#
# 参数：无
# 前置：已经点击「进入游戏」。
# 后置：回到主页；8 拍内没确认到主页时 pause 交给人工。
# 返回：2=发现更新，交调用方恢复；其它路径保持隐式 null。
#
# 等待加载条消失 → 检测主页元素 → 处理战令领奖/关闭弹窗
def login_to_main_page()
    # 等待加载完成：检测 loading 区域的「加载」文字
    # 有「加载」→ 继续等；消失后再等 5 秒视为登录完成
    eval $loading_done = 0
    loop 10
        scan [game_login_page].[loading, online_label] as $load_state
        call $notice = login_notice_kind($load_state.online_label)
        if $notice == "update"
            return 2
        end
        if not $load_state.loading contains "加载"
            eval $loading_done = 1
            break
        end
        wait 3
    end
    if not $loading_done
        screenshot from last
        eval pause("等待加载超时，请手动检查后点击确定")
    end
    wait 5

    # 等待主页加载完成：检测主界面入口按钮
    # 能读到 → 登录完成；否则先检查战令领奖，再尝试关闭活动弹窗
    eval $main_attempt = 0
    loop 8
        eval $main_attempt = $main_attempt + 1
        call $in_main = is_in_main_page()
        if $in_main
            log "主页加载完成"
            # 检查是否有战令领奖入口
            call claim_zhanling_reward()
            return
        end

        if $main_attempt == 8
            log warn "最后一轮登录主页校验未命中，记录判断帧"
            screenshot from last
        end

        call $notice = read_login_notice()
        if $notice == "update"
            return 2
        end

        # 未检测到主页，先检查战令领奖
        scan [game_login_page].[zllj_btn] as $zllj by contains "前往领奖"
        if $zllj
            log "检测到战令领奖入口，先领奖"
            call claim_zhanling_reward()
        else
            # 没有战令领奖，尝试关闭活动弹窗
            click [game_login_page].[close_btn]
        end
        wait @page_refresh
    end
    log warn "登录自动处理后仍无法确认主页，记录当前现场"
    screenshot
    eval pause("无法确认已登录至主页，请手动检查后点击确定")
end


# ─── claim_zhanling_reward ────────────────────────────────
# 检测战令领奖入口，有则进入一键领取并返回。
#
# 参数：无
# 前置：登录后可能出现的战令领奖入口（不保证存在）。
# 后置：入口存在时已领取并返回原页面；不存在时不做任何点击。
# 返回：无返回值（隐式 null）。
def claim_zhanling_reward()
    scan [game_login_page].[zllj_btn] as $zllj by contains "前往领奖"
    if $zllj
        log "进入战令领奖页面"
        click [game_login_page].[zllj_btn] after wait @step_interval
        scan [zhanling_detail].[claim_all] as $claim by contains "一键领取"
        if $claim
            log "点击一键领取"
            click [zhanling_detail].[claim_all] after wait @step_interval
        end
        click [zhanling_detail].[back] after wait @step_interval
    end
end
