#% id: scan_role_base_attr
#% name: 扫描基础属性
#% runnable: true
#% env: [android, desktop]
#% parameters:
#%   - name: scroll_count
#%     label: 滚动次数
#%     type: number
#%     default: 8
#%     min: 1
#%     max: 20
#%   - name: silent_write
#%     label: 静默写入指定备战方案并返回主页
#%     type: bool
#%     default: false
#%   - name: plan_name
#%     label: 静默写入目标方案（留空用当前方案）
#%     type: text
#%     default: ""
#%   - name: main_art
#%     label: 静默写入主武学（可留空）
#%     type: text
#%     default: ""
#%   - name: sub_art
#%     label: 静默写入副武学（可留空）
#%     type: text
#%     default: ""

# 直接运行与被其他 WF 调用共用 scan_role_base_attr_for_plan 子过程。
default $scroll_count = 8
default $silent_write = false
default $plan_name = ""
default $main_art = ""
default $sub_art = ""
import "subcall/loadout/role_attrs.wf"

if $silent_write
    eval $target = loadout_scan_target($plan_name, $main_art, $sub_art)
    call $result = scan_role_base_attr_for_plan(
        $target.name, $target.main_art, $target.sub_art, true, $scroll_count)
else
    call $result = scan_role_base_attr_for_plan("", "", "", false, $scroll_count)
end
if $result < 0
    return -1
end
return 0
