#% name: 视觉状态判断子过程

# 基于区域像素的通道关系判断业务视觉状态。

# 江湖号令奖励状态。仅在刷新图标消失、任务已完成后调用；正常任务
# 同样没有金光，单凭本过程不能判断任务是否完成。
# label_region 应传入任务卡的 label 区域，例如：
#   [activity_jianghu].[card_1].[label]
# 待领取奖励的金色光效随亮度变化，因此使用 R/G/B 相对关系。
# 返回 unclaimed / claimed / unknown；不确定时禁止点击领奖。
def detect_jianghu_reward_state($label_region)
    eval $ratios = pixel_ratios($label_region, {
        "gold": {
            "r_min": 100,
            "g_min": 90,
            "r_g_min": -5,
            "g_b_min": 8
        }
    }, 2)
    if $ratios.gold >= 0.30
        return "unclaimed"
    end
    if $ratios.gold <= 0.10
        return "claimed"
    end
    return "unknown"
end

# 子场景引用可以在 scan/click 中动态选取，表达式中的区域引用必须使用
# 静态 key；这里仅负责将六个卡片 key 转为各自的 label 区域。
def detect_jianghu_card_reward_state($card)
    if $card equals "card_1"
        eval $label_region = [activity_jianghu].[card_1].[label]
    else if $card equals "card_2"
        eval $label_region = [activity_jianghu].[card_2].[label]
    else if $card equals "card_3"
        eval $label_region = [activity_jianghu].[card_3].[label]
    else if $card equals "card_4"
        eval $label_region = [activity_jianghu].[card_4].[label]
    else if $card equals "card_5"
        eval $label_region = [activity_jianghu].[card_5].[label]
    else if $card equals "card_6"
        eval $label_region = [activity_jianghu].[card_6].[label]
    else
        return "unknown"
    end
    call $state = detect_jianghu_reward_state($label_region)
    return $state
end

# 装备锁定状态。
# lock_region 应传入 [equip_detail].[lock]。阈值与当前 Python 判定保持一致：
# 先确认区域有足够前景，再按红色主导像素比例区分锁定与未锁定。
# 返回 locked / unlock / unknown。
def detect_equipment_lock_state($lock_region)
    eval $ratios = pixel_ratios($lock_region, {
        "foreground": {
            "max_rgb_min": 50
        },
        "locked_red": {
            "r_min": 50,
            "r_g_min": 10,
            "r_b_min": 10
        }
    })
    if $ratios.foreground < 0.10
        return "unknown"
    end
    if $ratios.locked_red >= 0.10
        return "locked"
    end
    if $ratios.locked_red <= 0.02
        return "unlock"
    end
    return "unknown"
end
