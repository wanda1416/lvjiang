#% name: 江湖号令刷新
#% parameters:
#%   - name: max_refresh
#%     label: 单任务最大刷新次数
#%     type: number
#%     default: 50
#%   - name: claim_reward
#%     label: 领取奖励
#%     type: bool
#%     default: false

# 江湖号令任务刷新流程
#
# 流程结构：
#   0. 起始定位：读 label_0 判断在活动页还是首页，必要时先导航
#   for 遍历 6 组 label_N / btn_N
#      1. 识别 label_N 文本是否命中目标任务列表（contains_any 短路匹配）
#      2. 命中 → 读取任务文本，分发执行对应动作
#      3. 未命中 → 点击 btn_N 刷新，等待后重新识别，直到命中或达到刷新上限
#   4. 收尾：若仍在活动页，退回游戏首页
#
# 参数：
#   max_refresh — 单个任务最大刷新次数，默认 50
#   claim_reward — 是否领取奖励，默认 false；勾选后每个任务完成
#                  切到下一个 label 前再点一次领取。第六个任务若落在
#                  桌面（合影/看报），会先返回号令页领取再由收尾退回桌面

default $max_refresh = 50
default $claim_reward = false

$step_interval = (1, 2)

# 目标任务关键词列表
eval $targets = ["合影", "换装", "情境", "东方", "醉意", "双人"]

# 起始定位：用户可能在江湖号令活动页点 F9，也可能停在游戏首页
# 读不到「号令」标题即视为在首页，先导航进活动页
scan [activity_jianghu].[label_0] as $at_haoling by contains "号令"
if not $at_haoling
   log "未识别到号令标题，视为当前在游戏首页，先导航至江湖号令页"
   call back_to_haoling()
   scan [activity_jianghu].[label_0] as $at_haoling by contains "号令"
   if not $at_haoling
      log "导航后仍未进入江湖号令页，终止流程"
      return
   end
end

for idx in ["1", "2", "3", "4", "5", "6"]

   # 动态构造本组的 label / btn region 名
   eval $label = concat("label_", $idx)
   eval $btn = concat("btn_", $idx)

   # 先识别当前任务是否已是目标任务
   scan [activity_jianghu].$label as $hit by contains_any $targets
   if $hit
      log concat("任务 ", $idx, " 已是目标任务")
   else
      # 不断刷新直到命中目标任务
      loop $max_refresh
         click [activity_jianghu].$btn after wait $step_interval
         scan [activity_jianghu].$label as $hit by contains_any $targets
         if $hit
            log concat("任务 ", $idx, " 刷新命中目标任务")
            break
         end
      end
      if not $hit
         log concat("任务 ", $idx, " 达到刷新上限仍未命中，跳过")
      end
   end

   # 命中目标任务 → 读取任务文本，分发执行对应动作
   if $hit
      scan [activity_jianghu].$label as $text_result
      eval $task_text = $text_result.$label
      log concat("任务 ", $idx, " 命中：", $task_text)

      if $task_text contains "换装"
         call action_huanzhuang($label)
      end
      if $task_text contains "合影"
         call action_heying($label, $idx)
      end
      if $task_text contains "情境"
         call action_qingjing($label)
      end
      if $task_text contains "东方"
         call action_dongfang($label, $idx)
      end
      if $task_text contains "醉意"
         call action_zuiyi($label)
      end
      if $task_text contains "双人"
         call action_shuangren($label)
      end

      # 领取奖励（勾选时）：动作完成后、切到下一个 label 前再点一次任务标签
      if $claim_reward
         call claim_reward($label, $idx)
      end
   end

end

log "六个任务刷新处理完成"

# 收尾：末个任务非合影时仍停在江湖号令页，连点三次返回退回游戏首页
scan [activity_jianghu].[label_0] as $at_haoling by contains "号令"
if $at_haoling
   log "仍在江湖号令页，退回游戏首页"
   click [activity_jianghu].[back] after wait $step_interval
   click [ui_school_main].[back] after wait $step_interval
   click [game_menu_page].[back] after wait $step_interval
end


# ─── 各活动动作过程 ────────────────────────────────────────
# 每个 def 接收命中任务的 label region 名（如 "label_1"），
# 从江湖号令页面出发执行对应活动，完成后需回到本页面。

# 换装：点击任务 → 前往 → 外观衣柜（穿搭方案 → 方案1 → 套用方案） → 返回三次回到活动页
def action_huanzhuang($label)
   click [activity_jianghu].$label after wait $step_interval
   click [activity_jianghu].[goto] after wait $step_interval
   click [ui_waiguan_yigui].[chuanda] after wait $step_interval
   click [ui_waiguan_yigui].[fangan_1] after wait $step_interval
   click [ui_waiguan_yigui].[taoyong] after wait $step_interval
   click [ui_waiguan_yigui].[back_1] after wait $step_interval
   click [ui_waiguan_yigui].[back_1] after wait $step_interval
   click [ui_waiguan_yigui].[back_1] after wait $step_interval
end

# 合影拍照：点击任务 → 前往 → 拍照页面（动作控制·拍照）→ 等待刷新 → 游戏菜单·返回×2 → 动作控制·返回确认
# 退出拍照会落到游戏首页，需再自行导航回江湖号令页（末个任务除外）
def action_heying($label, $idx)
   click [activity_jianghu].$label after wait $step_interval
   click [activity_jianghu].[goto] after wait $step_interval
   click [action_control].[camera_shot] after wait $step_interval
   click [action_control].[back] after wait $step_interval
   click [action_control].[back] after wait $step_interval
   click [action_control].[back_confirm] after wait $step_interval

   # 第六个任务已是最后一个，无需返回活动页
   if $idx equals "6"
      log "末个任务合影完成，无需返回江湖号令页"
   else
      call back_to_haoling()
   end
end

# 首页 → 江湖号令页：菜单 → 上滑翻页（最多两次）识别门派 → 门派首页 → 江湖号令
def back_to_haoling()
   click [game_main_page].[menu] after wait $step_interval
   loop 2
      drag [general_control].[menu_up] after wait $step_interval
      scan [game_menu_page].[menpai] as $menpai_key by contains "门派"
      if $menpai_key
         break
      end
   end
   if not $menpai_key
      log "菜单上滑两次仍未识别到门派，无法返回江湖号令页"
      return
   end
   click [game_menu_page].$menpai_key after wait $step_interval
   # 门派页三种形态：有门派（基底，入口文字「江湖号令」）
   # / 无门无派（no_school 视图，入口换成 haoling_2）
   # / 问津（wenjin 视图，入口换成 haoling_3）
   scan [ui_school_main].[haoling] as $haoling_key by contains "江湖号令"
   if $haoling_key
      click [ui_school_main].$haoling_key after wait $step_interval
   else
      scan [ui_school_main].[haoling_2] as $haoling_key by contains "号令"
      if $haoling_key
         log "未读到江湖号令，按无门无派处理，改点号令入口"
         click [ui_school_main].$haoling_key after wait $step_interval
      else
         log "haoling 与 haoling_2 均未识别，按问津视图改点 haoling_3"
         click [ui_school_main].[haoling_3] after wait $step_interval
      end
   end
end

# 领取奖励：动作完成后再次点击任务标签领取
# 任务 1-5 动作结束后停在号令页，直接点标签即可；
# 第六个任务（合影/看报）结束后落在桌面，需先返回号令页领取；
# 领取后停在号令页，由收尾逻辑统一退回游戏首页
def claim_reward($label, $idx)
   scan [activity_jianghu].[label_0] as $at_haoling by contains "号令"
   if not $at_haoling
      log concat("任务 ", $idx, " 完成后不在号令页，先返回号令页领取")
      call back_to_haoling()
   end
   click [activity_jianghu].$label after wait $step_interval
   log concat("任务 ", $idx, " 奖励已领取")
end

# 情境：点击任务 → 弹出情境视图（确认×2 → 展开 → 前往编辑情境）
# → 情境编辑视图（保存 → 取消按钮出现则点一次 → 等 6s）
# → 情境基底返回退回号令页 → 号令页连点两次返回回到号令主页面
def action_qingjing($label)
   click [activity_jianghu].$label after wait $step_interval
   click [activity_jianghu].[goto] after wait $step_interval
   click [activity_jianghu].[confirm] after wait $step_interval
   click [activity_jianghu].[expand_up] after wait $step_interval
   click [activity_jianghu].[goto_edit_qingjing] after wait $step_interval

   click [ui_waiguan_qingjing].[save] after wait $step_interval
   # 保存后可能弹出二次确认，识别到取消按钮才点一次
   scan [ui_waiguan_qingjing].[cancel] as $has_cancel by contains "取消"
   if $has_cancel
      log "情境保存弹出取消按钮，点击一次"
      click [ui_waiguan_qingjing].[cancel] after wait $step_interval
   end
   # 保存生效需时间，固定等 6 秒再退出
   wait 8

   click [ui_waiguan_qingjing].[back] after wait $step_interval
   click [activity_jianghu].[back] after wait $step_interval
   click [activity_jianghu].[back] after wait $step_interval
end

# 东方第一枝（看报）：点击任务 → 前往 → 立刻进入表情动作视图
# → 整面板扫描 actions 定位「看报」格子并点击 → 等 5s 弹出报纸阅读视图
# → 点第一个选择 → 连点两次返回回到游戏首页（末个任务除外，需导航回号令页）
def action_dongfang($label, $idx)
   click [activity_jianghu].$label after wait $step_interval
   click [activity_jianghu].[goto] after wait $step_interval

   # 整面板扫描动作列表，定位「看报」所在行列
   scan [action_control].[actions] as $acts
   eval $fr = ""
   for r in [1...2]
      for c in [1...6]
         if $acts.$r.$c contains "看报"
            eval $fr = $r
            eval $fc = $c
         end
      end
   end

   if $fr is_empty
      # 扫描读不到时回退默认位置：看报固定在 1 行 3 列
      log "动作列表未识别到「看报」，按默认位置 [1][3] 处理"
      eval notify("东方第一枝：未识别到「看报」，按默认位置 [1][3] 处理")
      eval $fr = 1
      eval $fc = 3
   end

   click [action_control].[actions][$fr][$fc] after wait $step_interval
   # 看报动作生效需时间，固定等 5 秒弹出报纸阅读视图
   wait 5
   click [action_control].[choose_1] after wait $step_interval
   click [action_control].[back] after wait $step_interval
   click [action_control].[back] after wait $step_interval

   # 末个任务已是最后一个，无需返回活动页
   if $idx equals "6"
      log "末个任务看报完成，无需返回江湖号令页"
   else
      call back_to_haoling()
   end
   
end

# 饮酒（醉意）：动作暂未实现
def action_zuiyi($label)
   log "醉意动作暂未实现"
end

# 双人：动作暂未实现
def action_shuangren($label)
   log "双人动作暂未实现"
end
