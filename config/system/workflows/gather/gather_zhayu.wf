#% name: 太极炸鱼
#% runnable: true
#% batchable: true
#% env: [android, desktop]
#% note: |-
#%   PC 端必须关闭后台模式后运行；技能按键无法通过后台模式发送。
#% parameters:
#%   - name: max_loops
#%     label: 最大循环次数
#%     type: number
#%     default: 500
#%     min: 1
#%   - name: skill_key
#%     label: 技能按键
#%     type: select
#%     default: "1"
#%     options: ["1", "2", "3", "4"]

# 太极炸鱼：在炸鱼点循环放技能，跑满 $max_loops 轮后结束。
#
# 流程结构：
#   1. 参数校验：技能按键只允许 1-4；PC 后台模式直接拒绝执行
#   2. 循环：安卓点击轻击 → 奇术；PC 按配置的技能键，启动一次炸鱼
#   3. 每轮等待约 1 秒共 20 次，回到 zhayu 标号继续，直到跑满 $max_loops 轮
#
# PC 技能键必须由前台 SendInput 发送，PostMessage 后台模式不生效。

default $max_loops = 500
default $skill_key = "1"

# ─── 参数校验 ─────────────────────────────────────────────────
# 前置：可能带 UI 注入的参数，也可能是直接运行时的默认值。
# 后置：参数不合法时原样退出，不做任何点击。
# 返回：-1=参数不合法或处于后台模式；否则继续往下执行。
if not $skill_key in ["1", "2", "3", "4"]
   log error "太极炸鱼：技能按键只允许配置 1-4"
   return -1
end

if is_post()
   log error "太极炸鱼：技能按键不支持后台模式，请关闭后台模式后重试"
   return -1
end

eval $loop_count = 0

# ─── 主循环：循环炸鱼 ─────────────────────────────────────────────
# 前置：技能按键合法且处于前台模式，角色已在炸鱼点。
# 后置：跑满 $max_loops 轮后结束，不校验页面也不回收现场。
@zhayu
if env("android")
   click [general_combat].[qingji] after wait @step_interval
   click [general_combat].[qishu]
else if env("desktop")
   press $skill_key after wait @step_interval
end

loop 20
   wait (1.10,1.15)
end
eval $loop_count = $loop_count + 1
if $loop_count < $max_loops
   goto zhayu
end
log "太极炸鱼已完成 " + $loop_count + " 轮"
